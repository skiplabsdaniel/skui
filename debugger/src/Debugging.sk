module alias SK = SKStore;

module SkDebugger;

const rootPath: SK.DirName = SK.DirName::create("/debug/");

class Name{name: String, alias: ?String} uses Hashable, Orderable

class Read{collection: String, key: JSON.Value} uses Hashable, Equality

base class PType uses Hashable, Equality {
  children =
  | PData()
  | PCollection()
}

class Parameter{type: PType, value: JSON.Value} uses Hashable, Equality

class Constructor{
  name: ?String,
  parameters: Array<Parameter>,
} uses Hashable, Equality

class Type{
  operator: String,
  constructors: Array<Constructor>,
} uses Hashable, Equality

class Entity(
  name: String,
  inputs: Array<String>,
  reads: Array<String>,
  type: Type,
) uses Hashable, Equality {
  fun getParameters(): Array<Array<Parameter>> {
    this.type.constructors.map(c -> c.parameters)
  }

  fun getName(): String {
    if (this.type.constructors.isEmpty()) this.type.operator else {
      `${this.type.operator}(${this.type.constructors.map(c -> c.name).join(
        ", ",
      )})`
    }
  }

  fun toString(): String {
    if (this.type.constructors.isEmpty()) this.type.operator else {
      `${this.type.operator}(${this.type.constructors.map(c -> c.name)
        .filterNone()
        .join(", ")})`
    }
  }
}

class ServiceInfo{
  name: String,
  platform: String,
  version: String,
  inputs: Array<String>,
  resources: Array<String>,
  remotesResources: Array<String>,
}

class Graph(
  inputs: Array<Name>,
  entities: Array<Entity>,
  reads: Array<Read>,
  outputs: Array<Name>,
) extends SK.File

class Instance(params: SKJSON.CJSON, clients: Array<String>)

fun indicator(context: mutable SK.Context, path: Ui.Path): Ui.Widget {
  Ui.Indicator::create(
    context,
    path,
    UiProgress.parameters(
      context,
      path,
      UiProgress.LamController{progress => _ctx ~> None()},
    ),
  )
}

fun buildWidget(
  context: mutable SK.Context,
  env: Environment,
  service: ServiceInfo,
): void {
  context.setPersistent("Ui.Properties.Root", SK.DirNameFile(rootPath));
  support = SKUIGL.DrawableSupport(SKUI.pictureToTexturable);
  builder = (_ctx, _root) ~> {
    (ctx, _root) ~> {
      path = Ui.Path::create("root").makeChild("app");
      SkDebugViews.buildApp(ctx, path, env, service);
    }
  };
  SKUI.init(context, env.wId, builder, support, predefined());
}

fun predefined(): SortedMap<Font.TypefaceInfo, String> {
  p = SortedMap<Font.TypefaceInfo, String>::create();
  !p = Roboto.fill(p);
  RobotoMono.fill(p)
}

module end;
