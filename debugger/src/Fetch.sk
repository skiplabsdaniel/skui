module alias SK = SKStore;

module SkDebugger;

class Call(
  wId: Int,
  dirName: SK.DirName,
  fetch: FetchKey,
  time: SK.Time,
  timeout_s: Int,
) extends SKStore.Postponable {
  //
  fun perform(_context: mutable SKStore.Context): void {
    skui_fetch(
      this.wId,
      this.fetch.url,
      this.fetch.method.toString(),
      this.fetch.headers,
      this.fetch.body,
      this.timeout_s,
      this.dirName.toString(),
      this.time.value,
    )
  }
}

class Timed(value: SK.Loadable, time: SK.Time) extends SK.File

class FetchResult(value: SKUtils.FetchResult) extends SK.File

fun initFetchCall(
  context: mutable SK.Context,
  wId: Int,
  dirName: SK.DirName,
  timeout_s: Int = 5,
): Ui.GetterOne<SK.Future<FetchResult>, Fetch> {
  callHdl = SK.LHandle::lazy(
    FetchKey::keyType,
    Timed::type,
    context,
    dirName,
    (ctx, _self, key) ~> {
      (ctx.maybeGetLazyDir(dirName) match {
      | Some(ldir) ->
        ldir.unsafeMaybeGet(key) match {
        | Some(SK.LDefined(values, _)) ->
          invariant(
            values.size() == 1,
            "Must have at least one and only one value",
          );
          Some(Timed::type(values[0]))
        | _ -> None()
        }
      | _ -> None()
      }) match {
      | Some(v) -> v
      | _ ->
        time = ctx.timeStamp();
        ctx.postpone(Call(wId, dirName, key, time, timeout_s));
        Timed(SK.Loading(), time)
      }
    },
    false,
  );
  (ctx, key) ~> {
    SK.LoadableFuture(
      FetchResult::type,
      callHdl.get(ctx, key.toFetchKey()).value,
    )
  }
}

class Fetch(
  url: String,
  method: SKUtils.Method = SKUtils.Get(),
  headers: Map<String, String> = Map[],
  body: ?String = None(),
) {
  fun toFetchKey(): FetchKey {
    FetchKey(
      this.url,
      this.method.toString(),
      JSON.Object(this.headers.map((_k, v) -> JSON.String(v))).toString(),
      this.body,
    )
  }

  static fun fromFetchKey(key: FetchKey): Fetch {
    Fetch(
      key.url,
      SKUtils.Method::fromString(key.method),
      JSON.decode(key.headers).expectObject().value.map((_, v) ->
        v.expectString()
      ),
      key.body,
    )
  }
}

class FetchKey(
  url: String,
  method: String,
  headers: String,
  body: ?String,
) extends SK.Key {
  fun toString(): String {
    inspect(this).toString()
  }
}

fun writeFetchResult(
  dirName: SK.DirName,
  key: FetchKey,
  loadable: SK.Loadable,
  time: Int,
): void {
  SK.Context::withoutGc(ctx ~> {
    invariant(ctx.currentArrow().isNone(), "Cannot be called durring update");
    ctx.maybeGetLazyDir(dirName) match {
    | Some(ldir) ->
      (optTime, reads) = ldir.unsafeGet(key) match {
      | SK.LDefined(values, reads) ->
        invariant(
          values.size() == 1,
          "Must have at least one and only one value",
        );
        timed = Timed::type(values[0]);
        (Some(timed.time), reads)
      | SK.LRemoved(reads) -> (None(), reads)
      | _ -> invariant_violation("Must be defined")
      };
      cTime = SK.Time(time);
      optTime match {
      | None() ->
        ldir.writeArray(ctx, key, Array[Timed(loadable, cTime)], reads)
      | Some(t) if (t == cTime) ->
        ldir.writeArray(ctx, key, Array[Timed(loadable, cTime)], reads)
      | _ -> void
      }
    | _ -> invariant_violation(`No lazy dir ${dirName} found`)
    };
    ctx.update()
  })
}

//

@export("skui_fetch_result")
fun skui_fetch_result(
  url: String,
  method: String,
  headers: String,
  body: ?String,
  executor: String,
  time: Int,
  result: Result<SKUtils.FetchResult, SKUtils.FetchException>,
): void {
  writeFetchResult(
    SK.DirName::create(executor),
    FetchKey(url, method, headers, body),
    result match {
    | Success(res) -> SK.Loaded(FetchResult(res))
    | Failure(res) -> SK.LoadFailed(Some(!res.getMessage()))
    },
    time,
  )
}

@debug
@cpp_extern("skui_fetch")
native fun skui_fetch(
  wId: Int,
  url: String,
  method: String,
  headers: String,
  body: ?String,
  timeout_s: Int,
  executor: String,
  time: Int,
): void;

module end;
