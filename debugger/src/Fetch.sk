module alias SK = SKStore;

module SkDebugger;

class Call(
  wId: Int,
  dirName: SK.DirName,
  fetch: FetchKey,
  timeout_s: Int,
) extends SKStore.Postponable {
  //
  fun perform(_context: mutable SKStore.Context): void {
    skui_fetch(
      this.wId,
      this.fetch.url,
      this.fetch.method.toString(),
      this.fetch.headers,
      this.fetch.body,
      this.timeout_s,
      this.dirName.toString(),
      this.fetch.time,
    )
  }
}

class FetchResult(value: SKUtils.FetchResult) extends SK.File

fun initFetchCall(
  context: mutable SK.Context,
  wId: Int,
  dirName: SK.DirName,
  timeout_s: Int = 5,
): Ui.GetterOne<SK.Future<FetchResult>, Fetch> {
  callHdl = SK.LHandle::lazy(
    FetchKey::keyType,
    SK.Loadable::btype,
    context,
    dirName,
    (ctx, _self, key) ~> {
      (ctx.maybeGetLazyDir(dirName) match {
      | Some(ldir) ->
        ldir.unsafeMaybeGet(key) match {
        | Some(SK.LDefined(values, _)) ->
          invariant(
            values.size() == 1,
            "Must have at least one and only one value",
          );
          Some(SK.Loadable::btype(values[0]))
        | _ -> None()
        }
      | _ -> None()
      }) match {
      | Some(v) -> v
      | _ ->
        ctx.postpone(Call(wId, dirName, key, timeout_s));
        SK.Loading()
      }
    },
  );
  (ctx, key) ~> {
    SK.LoadableFuture(FetchResult::type, callHdl.get(ctx, key.toFetchKey()))
  }
}

class Fetch(
  url: String,
  time: Int,
  method: SKUtils.Method = SKUtils.Get(),
  headers: Map<String, String> = Map[],
  body: ?String = None(),
) extends SK.File {
  fun toFetchKey(): FetchKey {
    FetchKey(
      this.url,
      this.method.toString(),
      JSON.Object(this.headers.map((_k, v) -> JSON.String(v))).toString(),
      this.body,
      this.time,
    )
  }

  static fun jsonPost(url: String, time: Int, body: JSON.Value): Fetch {
    Fetch(
      url,
      time,
      SKUtils.Post(),
      Map["Content-Type" => "application/json"],
      Some(body.toString()),
    )
  }

  static fun fromFetchKey(key: FetchKey): Fetch {
    Fetch(
      key.url,
      key.time,
      SKUtils.Method::fromString(key.method),
      JSON.decode(key.headers).expectObject().value.map((_, v) ->
        v.expectString()
      ),
      key.body,
    )
  }
}

class FetchKey(
  url: String,
  method: String,
  headers: String,
  body: ?String,
  time: Int,
) extends SK.Key {
  fun toString(): String {
    inspect(this).toString()
  }
}

fun writeFetchResult(
  dirName: SK.DirName,
  key: FetchKey,
  loadable: SK.Loadable,
): void {
  SK.Context::withoutGc(ctx ~> {
    invariant(ctx.currentArrow().isNone(), "Cannot be called durring update");
    ctx.maybeGetLazyDir(dirName) match {
    | Some(ldir) ->
      reads = ldir.unsafeGet(key) match {
      | SK.LDefined(values, reads) ->
        invariant(
          values.size() == 1,
          "Must have at least one and only one value",
        );
        reads
      | SK.LRemoved(reads) -> reads
      | _ -> invariant_violation("Must be defined")
      };
      ldir.writeArray(ctx, key, Array[loadable], reads)
    | _ -> invariant_violation(`No lazy dir ${dirName} found`)
    };
    ctx.update()
  })
}

//

@export("skui_fetch_result")
fun skui_fetch_result(
  url: String,
  method: String,
  headers: String,
  body: ?String,
  executor: String,
  time: Int,
  result: Result<SKUtils.FetchResult, SKUtils.FetchException>,
): void {
  writeFetchResult(
    SK.DirName::create(executor),
    FetchKey(url, method, headers, body, time),
    result match {
    | Success(res) -> SK.Loaded(FetchResult(res))
    | Failure(res) -> SK.LoadFailed(Some(!res.getMessage()))
    },
  )
}

@debug
@cpp_extern("skui_fetch")
native fun skui_fetch(
  wId: Int,
  url: String,
  method: String,
  headers: String,
  body: ?String,
  timeout_s: Int,
  executor: String,
  time: Int,
): void;

module end;
