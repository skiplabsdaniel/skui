module alias D = SkDebugger;

module SkDebugViews;

fun buildSplit(
  context: mutable SKStore.Context,
  path: Ui.Path,
  env: D.Environment,
  info: D.ServiceInfo,
  conf: Ui.Configuration,
): Ui.Widget {
  graphView = buildGraphView(context, path.makeChild("graph"), env);
  treeView = buildTreeView(context, path.makeChild("tree"), env, info);
  time = context.timeStamp();
  prop = time.toString();
  UiSeparationProp.Property::initValues(
    context,
    Some(prop),
    Array[(SKStore.StrID("app-split"), Some(Ui.FromStart(200)))],
  );
  appSplitProp = UiSeparationProp.Property::forName(
    context,
    Some(prop),
    "app-split",
  );
  Ui.Split::create(
    context,
    path,
    UiSplit.LamController{
      first => Ui.default(treeView),
      second => Ui.default(graphView),
      axis => Ui.defaultOne(Ui.HorizontalAxis()),
      separation => Ui.defaultOne(appSplitProp),
    },
    Some(_ ~> conf),
  )
}

fun buildApp(
  context: mutable SKStore.Context,
  path: Ui.Path,
  env: D.Environment,
  info: D.ServiceInfo,
): Ui.Widget {
  bar = buildActionsBar(context, path.makeChild("actions-bar"), env);
  split = buildSplit(
    context,
    path.makeChild("split"),
    env,
    info,
    UiFlex.Configuration{flex => 1},
  );
  Ui.Flex::createForController(
    context,
    path,
    UiFlex.LamController{
      widgets => Ui.WidgetsArray(Array[bar, split]),
      direction => Ui.default(Ui.VerticalAxis()),
      mainAxisAlignment => Ui.default(UiFlex.Start()),
      crossAxisAlignment => Ui.default(UiFlex.CrossStretch()),
      mainAxisSize => Ui.default(UiFlex.Max()),
    },
  )
}

module end;
