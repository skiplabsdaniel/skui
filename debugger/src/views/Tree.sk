module alias SK = SKStore;
module alias D = SkDebugger;

module SkDebugViews;

fun icon(name: String): UiIcon.Description {
  UiIcon.Description(UiIcon.KCategory("themify"), name);
}

fun getProgress(
  context: mutable SK.Context,
  path: Ui.Path,
  env: D.Environment,
): ?Ui.Progress {
  res = path match {
  | Ui.Path(resource, Some(Ui.Path("resources", None()))) ->
    future = env.fetchResourceInstances(
      context,
      resource,
      env.getTime(context),
    );
    if (future.isLoading()) {
      Some(
        future
          .progression()
          .map(v -> Ui.Progression(v))
          .default(Ui.Indeterminate()),
      )
    } else {
      None()
    }
  | _ -> None()
  };
  res;
}

fun toResourceList(
  result: SKUtils.FetchResult,
): Result<Array<String>, .Exception> {
  result.json(jsv ~> jsv.expectArray().value.map(v -> v.toString()).toArray())
}

fun getItems(
  context: mutable SK.Context,
  optPath: ?Ui.Path,
  env: D.Environment,
  info: D.ServiceInfo,
): ?Array<String> {
  res = optPath match {
  | Some(Ui.Path("resources", None())) -> Some(info.resources)
  | Some(Ui.Path("remotes", None())) -> Some(info.remotesResources)
  | None() ->
    items = if (!info.remotesResources.isEmpty()) {
      Some(Array["service", "resources", "remotes"])
    } else {
      Some(Array["service", "resources"])
    };
    items
  | Some(Ui.Path(resource, Some(Ui.Path("resources", None())))) ->
    future = env.fetchResourceInstances(
      context,
      resource,
      env.getTime(context),
    );
    if (!future.isLoading()) {
      future.error() match {
      | Some(failure) ->
        Some(Array[`error:${failure.optError.default(!"Unknown")}`])
      | _ ->
        result = future.get().value;
        if (result.status == 200) {
          toResourceList(result) match {
          | Success(list) if (!list.isEmpty()) -> Some(list)
          | Success _ -> Some(Array["noinstances"])
          | Failure(e) -> Some(Array[`error:${e.getMessage()}`])
          }
        } else {
          Some(Array[`error:HTTP error with status ${result.status}`])
        }
      }
    } else {
      None()
    }
  | _ -> None()
  };
  res;
}

fun getItem(
  _context: mutable SK.Context,
  path: Ui.Path,
  _expanded: Bool,
  service: UiTree.Item,
): UiTree.Item {
  path match {
  | Ui.Path("service", None()) -> service
  | Ui.Path("resources", None()) ->
    UiTree.Item{text => !"Resources", leaf => false}
  | Ui.Path(r, Some(Ui.Path("resources", None()))) ->
    UiTree.Item{text => !r, leaf => false, icon => Some(icon("cloud"))}
  | Ui.Path("remotes", None()) ->
    UiTree.Item{text => !"Remote resources", leaf => false}
  | Ui.Path(r, Some(Ui.Path("remotes", None()))) ->
    UiTree.Item{text => !r, leaf => false, icon => Some(icon("world"))}
  | Ui.Path(
    instanceStr,
    Some(Ui.Path(_, Some(Ui.Path("resources", None())))),
  ) ->
    if (instanceStr == "noinstances") {
      UiTree.Item{text => !"No resource instances", leaf => true}
    } else {
      instance = D.instanceFromJSON(SKJSON.decode(instanceStr));
      UiTree.Item{text => !instance.params.prettyPrint(), leaf => true}
    }
  | _ -> UiTree.Item{text => !"TODO", leaf => true}
  }
}

fun getBadge(_context: mutable SKStore.Context, path: Ui.Path): ?Text {
  path match {
  | Ui.Path(
    instanceStr,
    Some(Ui.Path(_, Some(Ui.Path("resources", None())))),
  ) ->
    if (instanceStr != "noinstances") {
      instance = D.instanceFromJSON(SKJSON.decode(instanceStr));
      Some(Raw(instance.clients.size().toString()))
    } else {
      None()
    }
  | _ -> None()
  }
}

fun selectionChange(
  context: mutable SK.Context,
  selection: Array<Ui.Path>,
  env: D.Environment,
): void {
  selection.maybeGet(0) match {
  | Some(path) -> env.open(context, path)
  | _ -> void
  }
}

fun buildTreeView(
  context: mutable SKStore.Context,
  path: Ui.Path,
  env: D.Environment,
  info: D.ServiceInfo,
): Ui.Widget {
  serviceItem = UiTree.Item{
    text => !info.name,
    leaf => true,
    icon => Some(icon("double-angle-right")),
    tooltip => Some(
      I18N.format(
        !"platform: {1}\nversion: {2}",
        Vector<Text>[Raw(info.platform), Raw(info.version)],
      ),
    ),
  };
  controller = UiTree.LamController{
    selectionModel => (_ctx, _iu) ~> UiTree.Single(),
    items => (ctx, optPath) ~> getItems(ctx, optPath, env, info),
    item => (ctx, path, expanded) ~> getItem(ctx, path, expanded, serviceItem),
    progress => (ctx, path) ~> getProgress(ctx, path, env),
    badge => getBadge,
    selectionChange => (ctx, selection) ~> selectionChange(ctx, selection, env),
  };
  treePath = path.makeChild("tree");
  Ui.Tree::create(
    context,
    treePath,
    UiTree.init(context, treePath, controller),
    Some(_ ~> UiFlex.Configuration{flex => 1}),
  )
}

module end;
