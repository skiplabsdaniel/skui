module alias SK = SKStore;
module alias D = SkDebugger;

module SkDebugViews;

class Entry(key: SKJSON.CJSON, values: Array<SKJSON.CJSON>) extends SK.File

class ValuesTree(
  entries: D.Entries,
  showEntry: (mutable SK.Context, entry: Entry) ~> void,
) {
  //
  fun getItems(
    _context: mutable SK.Context,
    optPath: ?Ui.Path,
  ): ?Array<String> {
    optPath match {
    | None() ->
      Some(this.entries.values.mapWithIndex((idx, _) -> idx.toString()))
    | _ -> None()
    }
  }

  fun getItem(
    _context: mutable SK.Context,
    path: Ui.Path,
    _expanded: Bool,
  ): UiTree.Item {
    path match {
    | Ui.Path(value, None()) ->
      value.toIntOption().flatMap(idx ->
        this.entries.values.maybeGet(idx).map(kv -> kv.i0.prettyPrint())
      ) match {
      | Some(text) -> UiTree.Item{text => Raw(text), leaf => true}
      | _ -> UiTree.Item{text => !`Error: Unknown`, leaf => true}
      }
    | _ -> UiTree.Item{text => !`TODO: [value, graph]`, leaf => true}
    }
  }

  fun fire(
    context: mutable SK.Context,
    optPath: ?Ui.Path,
    _selection: Array<Ui.Path>,
  ): void {
    optPath match {
    | Some(Ui.Path(value, None())) ->
      value.toIntOption().each(idx -> {
        entry = this.entries.values[idx];
        this.showEntry(context, Entry(entry.i0, entry.i1))
      })
    | _ -> void
    }
  }
}

class ValueTree(values: SKJSON.CJArray) {
  //
  fun getItems(
    _context: mutable SK.Context,
    optPath: ?Ui.Path,
  ): ?Array<String> {
    value = this.getValue(optPath);
    Some(
      value match {
      | SKJSON.CJObject(fields) -> fields.cols
      | SKJSON.CJArray(v) -> v.mapWithIndex((idx, _) -> idx.toString())
      | _ -> Array["#"]
      },
    )
  }

  fun getItem(
    _context: mutable SK.Context,
    path: Ui.Path,
    expanded: Bool,
  ): UiTree.Item {
    value = this.getValue(Some(path));
    text = !(
      if (path.id == "#") value.prettyPrint() else {
        if (!expanded) `${path.id}: ${value.prettyPrint()}` else path.id
      }
    );
    leaf = value match {
    | SKJSON.CJObject _
    | SKJSON.CJArray _ ->
      false
    | _ -> true
    };
    UiTree.Item{text, leaf}
  }

  fun fire(
    _context: mutable SK.Context,
    optPath: ?Ui.Path,
    selection: Array<Ui.Path>,
  ): void {
    debug(("Fire", optPath, selection))
  }

  private fun getValue(optPath: ?Ui.Path): SKJSON.CJSON {
    optPath match {
    | Some(Ui.Path(id, optParent)) ->
      pValue = this.getValue(optParent);
      id.toIntOption() match {
      | Some(iid) -> SKJSON.expectArray(pValue)[iid]
      | _ if (id == "#") -> pValue
      | _ -> SKJSON.getValue(SKJSON.asObject(pValue), id).fromSome()
      }
    | _ -> this.values
    }
  }
}

fun buildValuesTreeView(
  context: mutable SKStore.Context,
  path: Ui.Path,
  entries: D.Entries,
  showEntry: (mutable SK.Context, entry: Entry) ~> void,
): Ui.Widget {
  utils = ValuesTree(entries, showEntry);
  controller = UiTree.LamController{
    selectionModel => Ui.defaultOne(UiTree.Single()),
    items => utils.getItems,
    item => utils.getItem,
    fire => utils.fire,
  };
  Ui.Tree::create(
    context,
    path,
    UiTree.init(context, path, controller),
    Some(_ ~> UiFlex.Configuration{flex => 1}),
  )
}

class Tabs(path: Ui.Path, values: Ui.Widget) {
  //
  fun getTabs(_context: mutable SKStore.Context): Array<String> {
    Array["value", "graph", "trace"]
  }

  fun getTab(_context: mutable SKStore.Context, id: String): UiTabPane.Tab {
    id match {
    | "value" ->
      UiTabPane.Tab{
        optText => Some(!"Value"),
        optTooltip => Some(!"Detail of the key and it's value"),
      }
    | "graph" ->
      UiTabPane.Tab{
        optText => Some(!"Value"),
        optTooltip => Some(
          !"The sub graph careted to compute the key, value pair\nTo be done",
        ),
      }
    | "trace" ->
      UiTabPane.Tab{
        optText => Some(!"Trace"),
        optTooltip => Some(!"The update trace\nTo be done"),
      }
    | _ -> invariant_violation("Invalid tab id")
    };
  }

  fun getWidget(context: mutable SKStore.Context, id: String): ?Ui.Widget {
    if (id == "value") return Some(this.values);
    fill = Ui.webColor("#d62f0d").default(Colors.black());
    Some(
      Ui.VText::createForController(
        context,
        this.path.makeChild("text"),
        UiText.LamController{
          text => Ui.default(
            I18N.format(!"TODO '{1}' view", Vector<Text>[Raw(id)]),
          ),
          style => Ui.default(
            Text.Style{
              faceId => UiTheme.bigFace,
              fill,
              hAlignment => Text.Center(),
            },
          ),
        },
      ),
    )
  }

  fun isDisabled(_context: mutable SKStore.Context, tab: String): Bool {
    tab match {
    | "value" -> false
    | _ -> true
    }
  }
}

fun buildValuesTabsView(
  context: mutable SKStore.Context,
  path: Ui.Path,
  values: Ui.Widget,
): Ui.Widget {
  tabs = Tabs(path, values);
  Ui.TabPane::create(
    context,
    path,
    UiTabPane.LamController{
      tabs => tabs.getTabs,
      tab => tabs.getTab,
      widget => tabs.getWidget,
    },
  )
}

fun buildValuesView(
  context: mutable SKStore.Context,
  path: Ui.Path,
  entries: D.Entries,
): Ui.Widget {
  if (entries.values.isEmpty()) {
    return Ui.VText::createForController(
      context,
      path.makeChild("empty"),
      UiText.LamController{
        text => Ui.default(!"Empty collection"),
        style => Ui.default(
          Text.Style{
            faceId => UiTheme.bigFace,
            fill => .Color::gray(uint8(15)),
            hAlignment => Text.Center(),
          },
        ),
      },
    )
  };
  noSelection = Ui.VText::createForController(
    context,
    path.makeChild("no-selection"),
    UiText.LamController{
      text => Ui.default(!"No values selected"),
      style => Ui.default(
        Text.Style{
          faceId => UiTheme.bigFace,
          fill => .Color::gray(uint8(15)),
          hAlignment => Text.Center(),
        },
      ),
    },
  );
  dirName = D.widgetDirName(path.makeChild("entry"));
  entryHdl = context.makeDir(SK.UnitID::keyType, Entry::type, dirName);
  widgetHdl = entryHdl.map(
    SK.UnitID::keyType,
    Ui.WidgetFile::type,
    context,
    dirName.sub("widget"),
    (ctx, writer, key, it) ~> {
      entry = it.first;
      utils = ValueTree(SKJSON.CJArray(entry.values));
      controller = UiTree.LamController{
        selectionModel => Ui.defaultOne(UiTree.Single()),
        items => utils.getItems,
        item => utils.getItem,
        fire => utils.fire,
      };
      vPath = path.makeChild(D.base64(it.first.key.prettyPrint()));
      values = Ui.Tree::create(ctx, vPath, UiTree.init(ctx, vPath, controller));
      //widget = buildValuesTabsView(ctx, vPath.makeChild("tabs"), );
      writer.set(key, Ui.WidgetFile(values))
    },
  );
  iHandle = SK.toIHandle(entryHdl);
  treeView = buildValuesTreeView(
    context,
    path.makeChild("tree"),
    entries,
    (ctx, entry) ~> iHandle.write(ctx, SK.UnitID::singleton, entry),
  );
  valuesSplitProp = D.useSeparationState(context, "values-split");
  Ui.Split::create(
    context,
    path,
    UiSplit.LamController{
      first => Ui.default(treeView),
      second => ctx ~>
        widgetHdl
          .maybeGet(ctx, SK.UnitID::singleton)
          .map(wf -> wf.widget)
          .default(noSelection),
      axis => Ui.defaultOne(Ui.HorizontalAxis()),
      separation => Ui.defaultOne(valuesSplitProp),
    },
  )
}

module end;
