module alias T = SKTest;
module alias D = SkDebugger;

module TestMinimizeCrossings;

fun test(layers: Array<Array<String>>, edges: Array<(String, String)>): void {
  l = D.GraphMetrics::make(layers, edges);
  originalCrossings = l.countCrossings();
  optimized = l.minimizeCrossings();
  optimizedCrossings = optimized.countCrossings();

  T.expectCmp(originalCrossings, optimizedCrossings, (v1, v2) -> {
    cmp = v1.compare(v2);
    cmp == EQ() || cmp == GT()
  })
}

@test
fun small_example(): void {
  test(
    Array[Array["A", "B"], Array["C", "D", "E"], Array["F", "G"]],
    Array[
      ("A", "C"),
      ("A", "D"),
      ("B", "D"),
      ("B", "E"),
      ("D", "F"),
      ("E", "G"),
    ],
  )
}

@test
fun no_crossings(): void {
  test(Array[Array["A", "B"], Array["C", "D"]], Array[("A", "C"), ("B", "D")])
}

@test
fun clear_crossings(): void {
  test(Array[Array["A", "B"], Array["C", "D"]], Array[("A", "D"), ("B", "C")])
}

@test
fun deep_hierarchy(): void {
  test(
    Array[Array["A"], Array["B", "C"], Array["D", "E"], Array["F"]],
    Array[
      ("A", "B"),
      ("A", "C"),
      ("B", "D"),
      ("C", "E"),
      ("D", "F"),
      ("E", "F"),
    ],
  )
}

@test
fun layer_with_no_nodes(): void {
  test(
    Array[Array["A", "B"], Array[], Array["C", "D"]],
    Array[("A", "C"), ("B", "D")],
  )
}

