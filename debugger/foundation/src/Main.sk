module alias SK = SKStore;

module SkDebugger;

const kAbout: String = "Skip runtime debugger";

fun launch(wId: Int, url: String): Result<void, .Exception> {
  uri = Result::guard(() -> {
    _ = IO.Url::parse(url);
    url
  })?;
  _ = SK.gContextInit(SK.Context::create{});
  SK.Context::withGc(context ~> {
    init(context, rootPath, uri, wId);
    context.initPre();
    context.updateIfRoot();
  });
  Success(void)
}

module end;
