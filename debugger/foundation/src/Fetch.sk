module alias SK = SKStore;

module SkDebugger;

class Call(
  wId: Int,
  executor: String,
  fetch: FetchKey,
  timeout_s: Int,
) extends SKStore.Postponable {
  //
  fun perform(_context: mutable SKStore.Context): void {
    skui_fetch(
      this.wId,
      this.fetch.url,
      this.fetch.method.toString(),
      this.fetch.headers,
      this.fetch.body,
      this.timeout_s,
      this.executor,
      this.fetch.time,
    )
  }
}

class FetchResult(value: SKFetch.Result) extends SK.File

fun initFetchCall(
  context: mutable SK.Context,
  wId: Int,
  dirName: SK.DirName,
  timeout_s: Int = 5,
): Ui.GetterOne<SK.Future<FetchResult>, Fetch> {
  executor = context.timeStamp().toString();
  context.setPersistent(`SkDebugger.Fetch.${executor}`, LHandleWriter(dirName));
  callHdl = SK.LHandle::lazy(
    FetchKey::keyType,
    SK.Loadable::btype,
    context,
    dirName,
    (ctx, _self, key) ~> {
      (ctx.maybeGetLazyDir(dirName) match {
      | Some(ldir) ->
        ldir.typed().unsafeMaybeGet(key) match {
        | Some(SK.LDefined(values, _)) ->
          invariant(
            values.size() == 1,
            "Must have at least one and only one value",
          );
          Some(SK.Loadable::btype(values[0]))
        | _ -> None()
        }
      | _ -> None()
      }) match {
      | Some(v) -> v
      | _ ->
        ctx.postpone(Call(wId, executor, key, timeout_s));
        SK.Loading()
      }
    },
  );
  (ctx, key) ~> {
    SK.LoadableFuture(FetchResult::type, callHdl.get(ctx, key.toFetchKey()))
  }
}

class Fetch(
  url: String,
  time: Int,
  method: SKFetch.Method = SKFetch.Get(),
  headers: Map<String, String> = Map[],
  body: ?String = None(),
) extends SK.File {
  fun toFetchKey(): FetchKey {
    FetchKey(
      this.url,
      this.method.toString(),
      JSON.Object(this.headers.map((_k, v) -> JSON.String(v))).toString(),
      this.body,
      this.time,
    )
  }

  static fun jsonPost(url: String, time: Int, body: JSON.Value): Fetch {
    Fetch(
      url,
      time,
      SKFetch.Post(),
      Map["Content-Type" => "application/json"],
      Some(body.toString()),
    )
  }

  static fun fromFetchKey(key: FetchKey): Fetch {
    Fetch(
      key.url,
      key.time,
      SKFetch.Method::fromString(key.method),
      JSON.decode(key.headers).expectObject().value.map((_, v) ->
        v.expectString()
      ),
      key.body,
    )
  }
}

class FetchKey(
  url: String,
  method: String,
  headers: String,
  body: ?String,
  time: Int,
) extends SK.Key {
  fun toString(): String {
    inspect(this).toString()
  }
}

base class FetchWriter extends SK.File {
  fun write(
    context: mutable SKStore.Context,
    key: FetchKey,
    loadable: SK.Loadable,
  ): void;

  static fun bType(obj: SK.File): FetchWriter {
    obj match {
    | x @ FetchWriter _ -> x
    | _ -> SK.cast_violation("SkDebugger.FetchWriter", obj)
    }
  }
}

class LHandleWriter(dirName: SK.DirName) extends FetchWriter {
  fun write(
    context: mutable SKStore.Context,
    key: FetchKey,
    loadable: SK.Loadable,
  ): void {
    invariant(
      context.currentArrow().isNone(),
      "Cannot be called durring update",
    );
    context.maybeGetLazyDir(this.dirName) match {
    | Some(ldir) ->
      tdir = ldir.typed();
      reads = tdir.unsafeGet(key) match {
      | SK.LDefined(values, reads) ->
        invariant(
          values.size() == 1,
          "Must have at least one and only one value",
        );
        reads
      | SK.LRemoved(reads) -> reads
      | _ -> invariant_violation("Must be defined")
      };
      tdir.writeArray(context, key, Array[loadable], reads)
    | _ -> invariant_violation(`No lazy dir ${this.dirName} found`)
    };
    context.updateIfRoot()
  }
}

fun writeFetchResult(
  executor: String,
  key: FetchKey,
  loadable: SK.Loadable,
): void {
  SK.Context::withoutGc(ctx ~> {
    ctx
      .getPersistent(`SkDebugger.Fetch.${executor}`)
      .map(FetchWriter::bType) match {
    | Some(writer) -> writer.write(ctx, key, loadable)
    | _ -> invariant_violation(`Unknown fetch executor ${executor}`)
    }
  })
}

//

@export("skui_fetch_result")
fun skui_fetch_result(
  url: String,
  method: String,
  headers: String,
  body: ?String,
  executor: String,
  time: Int,
  result: Result<SKFetch.Result, SKFetch.Exception>,
): void {
  writeFetchResult(
    executor,
    FetchKey(url, method, headers, body, time),
    result match {
    | Success(res) -> SK.Loaded(FetchResult(res))
    | Failure(res) -> SK.LoadFailed(Some(!res.getMessage()))
    },
  )
}

@debug
@cpp_extern("skui_fetch")
native fun skui_fetch(
  wId: Int,
  url: String,
  method: String,
  headers: String,
  body: ?String,
  timeout_s: Int,
  executor: String,
  time: Int,
): void;

module end;
