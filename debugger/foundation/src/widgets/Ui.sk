module alias G = Geometry;
module alias SK = SKStore;

module SkDebugger;

fun widgetDirName(path: Ui.Path): SK.DirName {
  path.toDirName("/debug/graph/widget/")
}

class EdgeStyle(
  thickness: Float,
  cap: Shape.CapStyle = Shape.CSquare(),
  join: Shape.JoinStyle = Shape.JBevel(),
  miterLimit: Float = 4.0,
)

class Edge(from: Int, to: Int, path: Shape.Path) uses Orderable {
  //
  fun thicken(style: EdgeStyle): Edge {
    offsets = Shape.Path::thickenPolyline(
      this.path.sample(),
      style.thickness,
      style.cap,
      style.join,
      style.miterLimit,
    );
    Edge(this.from, this.to, Shape.Path::polyline(offsets, true))
  }
}

class UserData(edges: Array<Edge>) extends Ui.UserData

class DrawInfo(edges: Array<Edge>) extends Ui.DrawInfo

base class Controller {
  fun getLayers(mutable SK.Context): Array<Array<Int>>;
  fun buildWidget(mutable SK.Context, Int, Int, Int): Ui.Widget;
  fun buildEdges(mutable SK.Context, Array<Array<Array<G.Rect>>>): Array<Edge>;
  fun getSpaces(mutable SK.Context, Int): (Float, Float);
  fun getEdgeStyle(mutable SK.Context): EdgeStyle;
}

class LayerRow(metric: Int, layer: Int, row: Int) extends SK.Key

class Parameters{controller: Controller} extends Ui.Parameters {}

class UiGraph protected {
  controller: Controller,
  layersHdl: SK.EHandle<LayerRow, Ui.WidgetFile>,
  nodesHdl: SK.EHandle<LayerRow, Ui.Node>,
} extends Ui.StrictWidget uses Ui.WithNodeCache, Ui.NoViewports {
  //
  type Params = Parameters;
  type Buffer = Ui.NodeCache;

  protected static fun make(
    context: mutable SK.Context,
    path: Ui.Path,
    params: Parameters,
    cache: Ui.NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    noConstraints = Ui.BoxConstraints::new();
    layersHdl = context
      .makeDir(
        SK.UnitID::keyType,
        SK.IntFile::type,
        widgetDirName(path.makeChild("source")),
        Array[(SK.UnitID::singleton, SK.IntFile(0))],
      )
      .map(
        LayerRow::keyType,
        Ui.WidgetFile::type,
        context,
        widgetDirName(path),
        (context, writer, _, _) ~> {
          layers = params.controller.getLayers(context);
          layers.eachWithIndex((midx, metric) ->
            metric.eachWithIndex((lidx, lsize) ->
              for (ridx in Range(0, lsize)) {
                writer.set(
                  LayerRow(midx, lidx, ridx),
                  Ui.WidgetFile(
                    params.controller.buildWidget(context, midx, lidx, ridx),
                  ),
                )
              }
            )
          );
        },
      );
    nodesHdl = layersHdl.map(
      LayerRow::keyType,
      Ui.Node::type,
      context,
      widgetDirName(path.makeChild("nodes")),
      (context, writer, key, value) ~> {
        widget = value.first.widget;
        writer.set(key, widget.getNode(context, noConstraints))
      },
    );
    static{
      path,
      controller => params.controller,
      cache,
      optConfiguration,
      tick => context.getTick(),
      layersHdl,
      nodesHdl,
    }
  }

  static fun createForController(
    context: mutable SK.Context,
    path: Ui.Path,
    controller: Controller,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static::create(context, path, Parameters{controller}, optConfiguration)
  }

  fun layout(
    context: mutable SK.Context,
    _constraints: Ui.BoxConstraints,
  ): Ui.Node {
    noConstraints = Ui.BoxConstraints::new();
    layers = this.controller.getLayers(context);
    nodes = layers.mapWithIndex((gidx, group) ->
      group.mapWithIndex((lidx, lsize) ->
        Array::fillBy(lsize, ridx ->
          this.nodesHdl.get(context, LayerRow(gidx, lidx, ridx))
        )
      )
    );
    nodeSizes = nodes.map(g -> g.map(l -> l.map(n -> n.size)));
    (size, nodeBounds) = layout(nodeSizes, idx ->
      this.controller.getSpaces(context, idx)
    );
    edges = this.controller.buildEdges(context, nodeBounds);
    children_ = mutable Vector<Ui.NChild>[];
    nodes.eachWithIndex((gi, g) ->
      g.eachWithIndex((i, l) ->
        l.eachWithIndex((j, n) ->
          children_.push(
            Ui.CNode::create(n, nodeBounds[gi][i][j].topLeft(), noConstraints),
          )
        )
      )
    );
    Ui.Node::create(this, size, children_.toArray(), _ctx ~>
      Some(UserData(edges))
    );
  }

  fun computeLayer(
    _context: mutable SK.Context,
    support: Ui.DrawableSupport,
    absolute: G.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | Ui.MainLayer() ->
      drawables = mutable Vector<Ui.Drawable>[];
      node.optDrawInfo
        .map(di ~> di as DrawInfo _)
        .each(di ->
          di.edges.each(e ->
            drawables.push(
              support.shape(e.path.translate(absolute), Colors.black()),
            )
          )
        );
      drawables.toArray()
    | Ui.BackgroundLayer()
    | Ui.ForegroundLayer() ->
      Array[]
    }
  }

  fun checkFocusHandlers(
    _context: mutable SK.Context,
    _nodeInfo: Ui.Getter<Ui.NodeInfo>,
    handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler> {
    // TODO
    handlers.chill()
  }

  fun computeDrawInfo(
    context: mutable SK.Context,
    _support: Ui.DrawableSupport,
    _relative: Geometry.Offset,
    _nodeSum: Ui.NodeSum,
    optUserData: ?Ui.UserData,
  ): ?DrawInfo {
    style = this.controller.getEdgeStyle(context);
    optUserData
      .map(ud ~> ud as UserData _)
      .map(ud ~> DrawInfo(ud.edges.map(e ~> e.thicken(style))));
  }
}

module end;
