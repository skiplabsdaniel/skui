module alias SK = SKStore;

module SkDebugger;

const kServicePath: Ui.Path = Ui.Path("service", None());
const kEnvKey: String = "Debug.Environment";

class DebuggerException(message: String) extends .Exception {
  //
  fun getMessage(): String {
    this.message
  }
}

base class GraphDef {
  children =
  | SharedDef()
  | ResourceDef(String, SKJSON.CJSON)

  static fun fromPath(path: Ui.Path): ?GraphDef {
    path match {
    | Ui.Path("service", None()) -> Some(SharedDef())
    | Ui.Path(
      instanceStr,
      Some(Ui.Path(resource, Some(Ui.Path("resources", None())))),
    ) if (instanceStr != "noinstances") ->
      instance = instanceFromJSON(SKJSON.decode(instanceStr));
      Some(ResourceDef(resource, instance.params))
    | _ -> None()
    }
  }
}

fun init(
  context: mutable SK.Context,
  refPath: SK.DirName,
  uri: String,
  wId: Int,
  space: Float = 10.0,
): void {
  fetch = initFetchCall(context, wId, refPath.sub("fetch"));
  serviceInitHdl = context.makeDir(
    SK.UnitID::keyType,
    SK.IntFile::type,
    refPath.sub("service/init"),
    Array[],
  );
  serviceHdl = serviceInitHdl.map(
    SK.UnitID::keyType,
    SK.Loadable::btype,
    context,
    refPath.sub("service"),
    (ctx, writer, key, it) ~> {
      loadable = fetch(ctx, Fetch(`${uri}/v1/service`, it.first.value))
        .then(result ~>
          result.value.json(serviceFromJSON) match {
          | Success(v) -> v
          | Failure(exn) -> throw exn
          }
        )
        .asLoadable(f ~> f);
      writer.set(key, loadable)
    },
  );
  env = env(
    context,
    refPath,
    fetch,
    uri,
    wId,
    ctx ~> {
      serviceHdl
        .maybeGet(ctx, SK.UnitID::singleton)
        .flatMap(l -> l.maybeGet(ServiceInfo::type))
        .map(s -> Raw(s.name))
        .default(Raw(""))
    },
    space,
  );
  context.setPersistent(kEnvKey, env);
  context.setPersistent("Ui.Properties.Root", SK.DirNameFile(rootPath));
  support = SKUIGL.DrawableSupport(SKUI.pictureToTexturable);
  sPath = Ui.Path::create("root").makeChild("service");
  ind = indicator(context, sPath.makeChild("indicator"));
  rootHdl = serviceHdl.map(
    SK.UnitID::keyType,
    Ui.WidgetFile::type,
    context,
    refPath.sub("service/widget"),
    (ctx, writer, key, it) ~> {
      widget = it.first match {
      | SK.ToLoad()
      | SK.Loading _ ->
        ind
      | SK.LoadFailed(optError) ->
        Ui.VText::createForController(
          ctx,
          sPath.makeChild("error"),
          UiText.LamController{
            text => Ui.default(optError.default(!"Unknown")),
            style => Ui.default(
              Text.Style{
                faceId => UiTheme.bigFace,
                fill => Ui.webColor("#d62f0d").default(Colors.black()),
                hAlignment => Text.Center(),
              },
            ),
          },
        )
      | SK.Loaded(value) ->
        SkDebugViews.buildApp(
          ctx,
          sPath.makeChild("app"),
          env,
          ServiceInfo::type(value),
        )
      };
      writer.set(key, Ui.WidgetFile(widget))
    },
  );
  iHandle = SK.toIHandle(serviceInitHdl);
  context.addOnOnIniliazed(
    SK.Updater(ctx ~>
      ctx.getPersistent(kEnvKey).map(Environment::bType).each(env -> {
        iHandle.write(
          ctx,
          SK.UnitID::singleton,
          SK.IntFile(ctx.timeStamp().value),
        );
        env.open(ctx, kServicePath)
      })
    ),
  );
  builder = (_ctx, _root) ~> {
    (ctx, _root) ~>
      rootHdl
        .maybeGet(ctx, SK.UnitID::singleton)
        .map(wf -> wf.widget)
        .default(ind)
  };
  SKUI.init(context, env.wId, builder, support, predefined());
}

fun useSeparationState(
  context: mutable SK.Context,
  name: String,
  default: Ui.Separation = Ui.FromStart(200),
): Ui.SeparationProperty {
  time = context.timeStamp();
  prop = time.toString();
  UiSeparationProp.Property::initValues(
    context,
    Some(prop),
    Array[(SKStore.StrID(name), Some(default))],
  );
  UiSeparationProp.Property::forName(context, Some(prop), name)
}

fun useIntStates(
  context: mutable SK.Context,
  name: String,
  values: Array<(String, Int)>,
): Array<Ui.IntProperty> {
  UiIntProp.Property::initValues(
    context,
    Some(name),
    values.map(item -> (SKStore.StrID(item.i0), Some(item.i1))),
  );
  values.map(item -> UiIntProp.Property::forName(context, Some(name), item.i0))
}

module end;
