module alias SK = SKStore;

module SkDebugger;

const kServicePath: Ui.Path = Ui.Path("service", None());
const kEnvKey: String = "Debug.Environment";

class DebuggerException(message: String) extends .Exception {
  //
  fun getMessage(): String {
    this.message
  }
}

base class GraphDef {
  children =
  | SharedDef()
  | ResourceDef(String, SKJSON.CJSON)

  static fun fromPath(path: Ui.Path): ?GraphDef {
    path match {
    | Ui.Path("service", None()) -> Some(SharedDef())
    | Ui.Path(
      instanceStr,
      Some(Ui.Path(resource, Some(Ui.Path("resources", None())))),
    ) if (instanceStr != "noinstances") ->
      instance = instanceFromJSON(SKJSON.decode(instanceStr));
      Some(ResourceDef(resource, instance.params))
    | _ -> None()
    }
  }
}

class ValueInfo(
  value: String,
  hasSubGrap: Bool,
  // trace: To define
)

class TPath(time: Int, path: Ui.Path) uses Orderable extends SK.File

base class Environment(uri: String, wId: Int) extends SK.File {
  fun getTitle(mutable SK.Context): Text;
  fun getWidget(mutable SK.Context): ?SK.Future<Ui.Widget>;

  fun open(mutable SK.Context, Ui.Path): void;

  fun fetch(mutable SK.Context, Fetch): SK.Future<FetchResult>;

  fun getTime(mutable SK.Context): Int;

  static fun bType(obj: SK.File): Environment {
    obj match {
    | x @ Environment _ -> x
    | _ -> SK.cast_violation("SkDebugger.Environment", obj)
    }
  }

  fun fetchResourceInstances(
    context: mutable SK.Context,
    resource: String,
    time: Int,
  ): SK.Future<FetchResult> {
    this.fetch(
      context,
      Fetch(
        `${this.uri}/v1/instances/${resource}`,
        time,
        SKFetch.Get(),
      ),
    );
  }
}

class LamEnvironment(
  private title: Ui.Getter<Text>,
  private widget: Ui.Getter<?SK.Future<Ui.Widget>>,
  private open_: (mutable SK.Context, Ui.Path) ~> void,
  private fetch_: Ui.GetterOne<SK.Future<FetchResult>, Fetch>,
  private time: (mutable SK.Context) ~> Int,
) extends Environment {
  //
  fun getTitle(ctx: mutable SK.Context): Text {
    this.title(ctx)
  }

  fun getWidget(ctx: mutable SK.Context): ?SK.Future<Ui.Widget> {
    this.widget(ctx)
  }

  fun open(ctx: mutable SK.Context, path: Ui.Path): void {
    this.open_(ctx, path)
  }

  fun fetch(ctx: mutable SK.Context, f: Fetch): SK.Future<FetchResult> {
    this.fetch_(ctx, f)
  }

  fun getValueKeys(
    _ctx: mutable SK.Context,
    _path: Ui.Path,
  ): ?SK.Future<Array<String>> {
    invariant_violation("Not implemented")
  }

  fun getValueInfo(
    _ctx: mutable SK.Context,
    _path: Ui.Path,
  ): ?SK.Future<ValueInfo> {
    invariant_violation("Not implemented")
  }

  fun getTime(ctx: mutable SK.Context): Int {
    this.time(ctx)
  }
}

fun env(
  context: mutable SK.Context,
  refPath: SK.DirName,
  fetch: Ui.GetterOne<SK.Future<FetchResult>, Fetch>,
  uri: String,
  wId: Int,
  getName: Ui.Getter<Text>,
  space: Float = 10.0,
): Environment {
  pathsHdl = context.makeDir(
    Ui.Path::keyType,
    SK.IntFile::type,
    refPath.sub("paths"),
    Array[],
  );
  toCollectHdl = pathsHdl.map(
    Ui.Path::keyType,
    Fetch::type,
    context,
    refPath.sub("tocollect"),
    (_ctx, writer, key, it) ~> {
      GraphDef::fromPath(key).map(def ->
        def match {
        | SharedDef _ -> Fetch(`${uri}/v1/shared`, it.first.value)
        | ResourceDef(name, params) ->
          Fetch::jsonPost(
            `${uri}/v1/resource/${name}`,
            it.first.value,
            params.toJSON(),
          )
        }
      ) match {
      | Some(options) -> writer.set(key, options)
      | _ ->
        (key match {
        | Ui.Path(input, Some(Ui.Path("inputs", None()))) ->
          Some(
            JSON.Object(
              Map["kind" => JSON.String("input"), "name" => JSON.String(input)],
            ),
          )
        | Ui.Path(collection, Some(Ui.Path("collections", None()))) ->
          Some(
            JSON.Object(
              Map[
                "kind" => JSON.String("collection"),
                "name" => JSON.String(collection),
              ],
            ),
          )
        | Ui.Path(
          "output",
          Some(
            Ui.Path(
              instanceStr,
              Some(Ui.Path(resource, Some(Ui.Path("resources", None())))),
            ),
          ),
        ) ->
          Some(
            JSON.Object(
              Map[
                "kind" => JSON.String("resource"),
                "name" => JSON.String(resource),
                "param" => JSON.decode(instanceStr),
              ],
            ),
          )
        | Ui.Path(
          collection,
          Some(
            Ui.Path(
              "collection",
              Some(
                Ui.Path(
                  _,
                  Some(
                    Ui.Path(
                      _,
                      Some(Ui.Path(_, Some(Ui.Path("resources", None())))),
                    ),
                  ),
                ),
              ),
            ),
          ),
        )
        | Ui.Path(
          collection,
          Some(
            Ui.Path(
              "collection",
              Some(Ui.Path(_, Some(Ui.Path("service", None())))),
            ),
          ),
        ) ->
          Some(JSON.String(collection))
        | _ -> None()
        }).each(description ->
          writer.set(
            key,
            Fetch::jsonPost(`${uri}/v1/values`, it.first.value, description),
          )
        )
      }
    },
  );
  collectedHdl = toCollectHdl.map(
    Ui.Path::keyType,
    SK.Loadable::btype,
    context,
    refPath.sub("collected"),
    (ctx, writer, key, it) ~> {
      writer.set(key, fetch(ctx, it.first).asLoadable(f ~> f))
    },
  );
  openedHdl = pathsHdl.map(
    SK.UnitID::keyType,
    TPath::type,
    context,
    refPath.sub("paths/opened"),
    (ctx, writer, key, it) ~> {
      collectedHdl.maybeGet(ctx, key).each(_ ->
        writer.set(SK.UnitID::singleton, TPath(it.first.value, key))
      )
    },
  );
  parsedHdl = collectedHdl.map(
    Ui.Path::keyType,
    SK.Loadable::btype,
    context,
    refPath.sub("parsed"),
    (ctx, writer, key, it) ~> {
      writer.set(
        key,
        it.first.then(ctx, (_, f) ~> {
          result = FetchResult::type(f).value;
          if (result.status == 200) {
            GraphDef::fromPath(key) match {
            | Some _ ->
              result.json(graphFromJSON) match {
              | Failure(e) ->
                error = I18N.format(
                  !"Unable to build graph {1}",
                  Vector<Text>[!e.getMessage()],
                );
                SK.LoadFailed(Some(error))
              | Success(graph) -> SK.Loaded(graph)
              }
            | _ ->
              key match {
              | Ui.Path(_, Some(Ui.Path("inputs", None())))
              | Ui.Path(_, Some(Ui.Path("collections", None())))
              | Ui.Path(
                "output",
                Some(
                  Ui.Path(
                    _,
                    Some(Ui.Path(_, Some(Ui.Path("resources", None())))),
                  ),
                ),
              )
              | Ui.Path(
                _,
                Some(
                  Ui.Path(
                    "collection",
                    Some(
                      Ui.Path(
                        _,
                        Some(
                          Ui.Path(
                            _,
                            Some(
                              Ui.Path(_, Some(Ui.Path("resources", None()))),
                            ),
                          ),
                        ),
                      ),
                    ),
                  ),
                ),
              )
              | Ui.Path(
                _,
                Some(
                  Ui.Path(
                    "collection",
                    Some(Ui.Path(_, Some(Ui.Path("service", None())))),
                  ),
                ),
              ) ->
                result.skjson(entriesFromJSON) match {
                | Failure(e) ->
                  SK.LoadFailed(
                    Some(
                      I18N.format(
                        !"Unable to collect entries {1}",
                        Vector<Text>[!e.getMessage()],
                      ),
                    ),
                  )
                | Success(entries) -> SK.Loaded(entries)
                }
              | _ -> SK.LoadFailed(Some(!"TODO"))
              }
            }
          } else {
            error = I18N.format(
              !"HTTP error with status {1}",
              Vector<Text>[Raw(result.status.toString())],
            );
            SK.LoadFailed(Some(error))
          }
        }),
      );
    },
  );
  metricsHdl = parsedHdl.map(
    Ui.Path::keyType,
    SK.Loadable::btype,
    context,
    refPath.sub("metrics"),
    (ctx, writer, key, it) ~> {
      writer.set(
        key,
        it.first.then(ctx, (_, f) ~> {
          f match {
          | g @ Graph _ -> SK.Loaded(GraphMetrics::compute(g, TNodeFactory()))
          | e @ Entries _ -> SK.Loaded(e)
          | _ -> SK.LoadFailed(Some(!"TODO"))
          }
        }),
      );
    },
  );
  widgetsHdl = metricsHdl.map(
    Ui.Path::keyType,
    SK.Loadable::btype,
    context,
    refPath.sub("widgets"),
    (ctx, writer, key, it) ~> {
      writer.set(
        key,
        it.first.then(ctx, (_, f) -> {
          path = key.makeChild("widget");
          f match {
          | gm @ GMetrics _ ->
            Unsafe.maybeCast(gm, GraphMetrics<TNode>) match {
            | Some(metrics) ->
              env = env(
                ctx,
                key.toDirName(refPath.sub("widgets").toString()),
                fetch,
                uri,
                wId,
                Ui.default(!"Unknown"),
                space,
              );
              controller = GraphController::make(
                env.open,
                key,
                path,
                metrics,
                space,
              );
              graph = UiGraph::createForController(ctx, path, controller);
              centered = Ui.AspectRatio::create(
                ctx,
                path.makeChild("centered"),
                UiAspectRatio.LamController{
                  widget => Ui.default(graph),
                  centered => Ui.default(true),
                  aspectRatio => Ui.default(0.0),
                },
              );
              scrollPath = path.toString();
              hvScrolls = useIntStates(
                ctx,
                scrollPath,
                Array[("hScroll", 0), ("vScroll", 0)],
              );
              scroll = Ui.ScrollPane::create(
                ctx,
                path.makeChild("scroll"),
                UiScroll.LamController{
                  widget => Ui.default(centered),
                  hScroll => Ui.defaultOne(hvScrolls[0]),
                  vScroll => Ui.defaultOne(hvScrolls[1]),
                },
              );
              mainView = SkDebugViews.buildMainView(
                ctx,
                path.makeChild("values"),
                env.getTitle,
                env.getWidget,
                Some(!"No collection selected"),
              );
              graphSplitProp = useSeparationState(
                ctx,
                "graph-split",
                Ui.Percent(50),
              );
              split = Ui.Split::create(
                ctx,
                path.makeChild("split"),
                UiSplit.LamController{
                  first => Ui.default(scroll),
                  second => Ui.default(mainView),
                  axis => Ui.defaultOne(Ui.VerticalAxis()),
                  separation => Ui.defaultOne(graphSplitProp),
                },
              );
              SK.Loaded(Ui.WidgetFile(split))
            | _ -> SK.LoadFailed(Some(!"Unrecognized metrics"))
            }
          | e @ Entries _ ->
            SK.Loaded(
              Ui.WidgetFile(
                SkDebugViews.buildValuesView(ctx, path.makeChild("values"), e),
              ),
            )
          | _ -> SK.LoadFailed(Some(!"TODO"))
          }
        }),
      );
    },
  );
  iHandle = SK.toIHandle(pathsHdl);
  openedPath = (ctx, isUntracked) ~> {
    sorted = openedHdl
      .getArrayValue(ctx, SK.UnitID::singleton, isUntracked)
      .sorted();
    sorted.maybeGet(sorted.size() - 1).map(tp -> tp.path)
  };
  open = (ctx, key) ~> {
    if (
      openedPath(ctx, true) match {
      | Some(op) -> op != key
      | _ -> true
      }
    ) {
      iHandle.write(ctx, key, SK.IntFile(ctx.timeStamp().value));
      ctx.updateIfRoot()
    }
  };
  LamEnvironment(
    ctx ~>
      openedPath(ctx, false) match {
      | Some(path) ->
        GraphDef::fromPath(path).map(def ->
          def match {
          | SharedDef _ -> getName(ctx)
          | ResourceDef(name, params) -> Raw(`${name}: ${params.prettyPrint()}`)
          }
        ) match {
        | Some(title) -> title
        | _ ->
          path match {
          | Ui.Path(input, Some(Ui.Path("inputs", None()))) ->
            I18N.format(!"Input: {1}", Vector<Text>[Raw(input)])
          | Ui.Path(name, Some(Ui.Path("collections", None()))) ->
            I18N.format(!"Collection: {1}", Vector<Text>[Raw(name)])
          | Ui.Path(
            "output",
            Some(
              Ui.Path(
                instanceStr,
                Some(Ui.Path(resource, Some(Ui.Path("resources", None())))),
              ),
            ),
          ) ->
            I18N.format(
              !"{1}: {2}",
              Vector<Text>[Raw(resource), Raw(instanceStr)],
            )
          | Ui.Path(
            _,
            Some(
              Ui.Path(
                "collection",
                Some(
                  Ui.Path(
                    name,
                    Some(
                      Ui.Path(
                        _,
                        Some(Ui.Path(_, Some(Ui.Path("resources", None())))),
                      ),
                    ),
                  ),
                ),
              ),
            ),
          )
          | Ui.Path(
            _,
            Some(
              Ui.Path(
                "collection",
                Some(Ui.Path(name, Some(Ui.Path("service", None())))),
              ),
            ),
          ) ->
            Raw(name)
          | _ -> !"TODO"
          }
        }
      | _ -> !"Loading..."
      },
    ctx ~> {
      openedPath(ctx, false).flatMap(key ->
        widgetsHdl.maybeGet(ctx, key).map(l ->
          SK.LoadableFuture(f ~> Ui.WidgetFile::type(f).widget, l)
        )
      )
    },
    open,
    fetch,
    ctx ~> {
      // get the current time without depend on it
      sorted = openedHdl
        .getArrayValue(ctx, SK.UnitID::singleton, true)
        .sorted();
      sorted.maybeGet(sorted.size() - 1).map(tp -> tp.time).default(0)
    },
    uri,
    wId,
  )
}

fun init(
  context: mutable SK.Context,
  refPath: SK.DirName,
  uri: String,
  wId: Int,
  space: Float = 10.0,
): void {
  fetch = initFetchCall(context, wId, refPath.sub("fetch"));
  serviceInitHdl = context.makeDir(
    SK.UnitID::keyType,
    SK.IntFile::type,
    refPath.sub("service/init"),
    Array[],
  );
  serviceHdl = serviceInitHdl.map(
    SK.UnitID::keyType,
    SK.Loadable::btype,
    context,
    refPath.sub("service"),
    (ctx, writer, key, it) ~> {
      loadable = fetch(ctx, Fetch(`${uri}/v1/service`, it.first.value))
        .then(result ~>
          result.value.json(serviceFromJSON) match {
          | Success(v) -> v
          | Failure(exn) -> throw exn
          }
        )
        .asLoadable(f ~> f);
      writer.set(key, loadable)
    },
  );
  env = env(
    context,
    refPath,
    fetch,
    uri,
    wId,
    ctx ~> {
      serviceHdl
        .maybeGet(ctx, SK.UnitID::singleton)
        .flatMap(l -> l.maybeGet(ServiceInfo::type))
        .map(s -> Raw(s.name))
        .default(Raw(""))
    },
    space,
  );
  context.setPersistent(kEnvKey, env);
  context.setPersistent("Ui.Properties.Root", SK.DirNameFile(rootPath));
  support = SKUIGL.DrawableSupport(SKUI.pictureToTexturable);
  sPath = Ui.Path::create("root").makeChild("service");
  ind = indicator(context, sPath.makeChild("indicator"));
  rootHdl = serviceHdl.map(
    SK.UnitID::keyType,
    Ui.WidgetFile::type,
    context,
    refPath.sub("service/widget"),
    (ctx, writer, key, it) ~> {
      widget = it.first match {
      | SK.ToLoad()
      | SK.Loading _ ->
        ind
      | SK.LoadFailed(optError) ->
        Ui.VText::createForController(
          ctx,
          sPath.makeChild("error"),
          UiText.LamController{
            text => Ui.default(optError.default(!"Unknown")),
            style => Ui.default(
              Text.Style{
                faceId => UiTheme.bigFace,
                fill => Ui.webColor("#d62f0d").default(Colors.black()),
                hAlignment => Text.Center(),
              },
            ),
          },
        )
      | SK.Loaded(value) ->
        SkDebugViews.buildApp(
          ctx,
          sPath.makeChild("app"),
          env,
          ServiceInfo::type(value),
        )
      };
      writer.set(key, Ui.WidgetFile(widget))
    },
  );
  iHandle = SK.toIHandle(serviceInitHdl);
  context.addOnOnIniliazed(
    SK.Updater(ctx ~>
      ctx.getPersistent(kEnvKey).map(Environment::bType).each(env -> {
        iHandle.write(
          ctx,
          SK.UnitID::singleton,
          SK.IntFile(ctx.timeStamp().value),
        );
        env.open(ctx, kServicePath)
      })
    ),
  );
  builder = (_ctx, _root) ~> {
    (ctx, _root) ~>
      rootHdl
        .maybeGet(ctx, SK.UnitID::singleton)
        .map(wf -> wf.widget)
        .default(ind)
  };
  SKUI.init(context, env.wId, builder, support, predefined());
}

fun useSeparationState(
  context: mutable SK.Context,
  name: String,
  default: Ui.Separation = Ui.FromStart(200),
): Ui.SeparationProperty {
  time = context.timeStamp();
  prop = time.toString();
  UiSeparationProp.Property::initValues(
    context,
    Some(prop),
    Array[(SKStore.StrID(name), Some(default))],
  );
  UiSeparationProp.Property::forName(context, Some(prop), name)
}

fun useIntStates(
  context: mutable SK.Context,
  name: String,
  values: Array<(String, Int)>,
): Array<Ui.IntProperty> {
  UiIntProp.Property::initValues(
    context,
    Some(name),
    values.map(item -> (SKStore.StrID(item.i0), Some(item.i1))),
  );
  values.map(item -> UiIntProp.Property::forName(context, Some(name), item.i0))
}

module end;
