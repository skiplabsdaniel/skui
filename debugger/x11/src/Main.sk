module alias SK = SKStore;

module SkDebugger;

const kName: String = "skdebugger";

fun error(msg: String, code: Int = 2): void {
  print_error(msg);
  skipExit(code)
}

fun main(): void {
  command = SKUIMain.complete(
    Cli.Command(kName)
      .about(kAbout)
      .arg(
        Cli.Arg::bool("version")
          .short("V")
          .long("version")
          .about("Print version info and exit"),
      )
      .arg(
        Cli.Arg::string("url").positional().about("The url of debug server"),
      ),
  ).help();
  args = Cli.parseArgs(command);
  args.error match {
  | Some(err) ->
    error(`ERROR: ${err.getMessage()}\n${Cli.usage(command, false)}`)
  | _ ->
    if (args.getBool("version")) {
      git_commit = #env ("GIT_COMMIT_INFO");
      print_string(`${kName} [${git_commit}]`)
    } else if (args.getBool("help")) {
      print_string(Cli.usage(command, true));
    } else {
      args.maybeGetString("url") match {
      | Some(url) ->
        wId = 0;
        fps = args.getString("fps").toIntOption().default(60);
        screen = args.getString("screen").toIntOption().default(0);
        launch(wId, url) match {
        | Failure(err) -> error(`ERROR: ${err.getMessage()}}`)
        | _ -> SKUIMain.init(wId, kAbout, fps, screen)
        }
      | _ -> error(`ERROR: Url must be specified\n${Cli.usage(command, false)}`)
      }
    }
  }
}

module end;
