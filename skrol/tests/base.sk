module alias T = SKTest;
module alias O = SKROL;

module SKROLTest;

@test
fun eager(): void {
  context = O.Context::createForLevel(Logger.Error());
  i1 = context.input(O.int(0));
  i2 = context.input(O.int(0));
  i3 = context.combine(
    O.Function::create(
      Array[i1, i2],
      Array[],
      O.PureFn((gs, _lgs) ~>
        O.IntObject::type(gs.i1(0)) + O.IntObject::type(gs.i1(1))
      ),
    ),
  );
  get = prop -> context.get(prop, O.toint);
  got = Array[i1, i2, i3].map(get);
  expect = Array[0, 0, 0];
  T.expectEq(got, expect);
  context.set(i1, O.int(1));
  context.update();
  !got = Array[i1, i2, i3].map(get);
  !expect = Array[1, 0, 1];
  T.expectEq(got, expect);
  context.set(i2, O.int(2));
  context.update();
  !got = Array[i1, i2, i3].map(get);
  !expect = Array[1, 2, 3];
  T.expectEq(got, expect);
  getTime = (prop: O.IEagerProperty) -> context.getTime(prop).value;
  !got = Array[i1, i2, i3].map(getTime);
  !expect = Array[1, 2, 2];
  T.expectEq(got, expect);
}

fun lazyFunction(
  _gs: Int -> O.Object,
  _lgs: (Int, O.IParameter) -> O.Object,
  param: O.IParameter,
): O.Object {
  O.IntObject(O.IntParam::ptype(param).value)
}

@test
fun lazy(): void {
  context = O.Context::createForLevel(Logger.Error());
  i1 = context.input(O.int(0));
  i2 = context.lazy(O.LazyFunction(Array[], Array[], lazyFunction));
  param = O.IntParam(2);
  i3 = context.combine(
    O.Function::create(
      Array[i1],
      Array[i2],
      O.PureFn((gs, lgs) ~>
        O.IntObject::type(gs.i1(0)) + O.IntObject::type(lgs.i1(0, param))
      ),
    ),
  );
  get = (prop: O.IEagerProperty) -> context.get(prop, O.toint);
  lget = prop -> context.getLazy(prop, param, O.toint);
  got = Array[Some(get(i1)), lget(i2), Some(get(i3))];
  expect = Array[Some(0), Some(2), Some(2)];
  T.expectEq(got, expect);
  context.set(i1, O.int(1));
  context.update();
  !got = Array[Some(get(i1)), lget(i2), Some(get(i3))];
  !expect = Array[Some(1), Some(2), Some(3)];
  T.expectEq(got, expect);
  getTime = (prop: O.IEagerProperty) -> context.getTime(prop).value;
  lgetTime = prop -> context.getLazyTime(prop, param).map(v -> v.value);
  !got = Array[Some(getTime(i1)), lgetTime(i2), Some(getTime(i3))];
  !expect = Array[Some(1), Some(0), Some(1)];
  T.expectEq(got, expect);
}

class State(add: O.TEagerProperty<Int>)

class StafullAdd(
  i1: O.IEagerProperty,
  i2: O.IEagerProperty,
  state: ?State = None(),
) extends O.StatefullObject {
  //
  fun getReference(): O.Object {
    StafullAdd(this.i1, this.i2)
  }

  fun changes(_old: O.TimedObject, _mappable: mutable O.IMappable): O.IChanges {
    todo()
  }

  fun init(scope: mutable O.IScope): this {
    add = scope.combine(
      O.Function::create(
        Array[this.i1, this.i2],
        Array[],
        O.PureFn((gs, _lgs) ~> {
          v1 = O.IntObject::type(gs.i1(0));
          v2 = O.IntObject::type(gs.i1(1));
          v1 + v2 + O.IntObject(1)
        }),
      ),
    );
    !this.state = Some(State(O.TEagerProperty(add, O.ObjectToInt())));
    this
  }

  fun update(_scope: mutable O.IScope, _new: O.Object): Result<this, void> {
    Success(this)
  }

  fun delete(scope: mutable O.IScope): void {
    this.state.each(state ->
      scope.remove(Array[state.add.property.getPath().id])
    )
  }
}

@test
fun statefull(): void {
  context = O.Context::createForLevel(Logger.Error());
  i1 = context.input(O.int(0));
  i2 = context.input(O.int(0));
  obj3 = StafullAdd(i1, i2);
  i3 = context.input(obj3);
  watched = O.EagerProperty(O.Path(0, Some(i3.getPath())));
  get = prop -> context.get(prop, O.toint);
  got = Array[i1, i2, watched].map(get);
  expect = Array[0, 0, 1];
  T.expectEq(got, expect);
  context.set(i1, O.int(1));
  context.update();
  !got = Array[i1, i2, watched].map(get);
  !expect = Array[1, 0, 2];
  T.expectEq(got, expect);
  context.set(i2, O.int(2));
  context.update();
  !got = Array[i1, i2, watched].map(get);
  !expect = Array[1, 2, 4];
  T.expectEq(got, expect);
  getTime = (prop: O.IEagerProperty) -> context.getTime(prop).value;
  !got = Array[i1, i2, watched].map(getTime);
  !expect = Array[1, 2, 2];
  T.expectEq(got, expect);
  for (i in Range(0, 1000)) {
    context.set(i1, O.int(i));
    context.update();
    !got = Array[i1, i2, watched].map(get);
    !expect = Array[i, 2, i + 3];
    T.expectEq(got, expect);
  };
}

@test
fun sfarray(): void {
  context = O.Context::createForLevel(Logger.Error());
  v1 = Array["a", "b", "c", "d"].map(v -> O.StringObject(v));
  i1 = context.input(O.SFArray(v1));
  check = (expect, size) -> {
    v = context.get(i1, O.SFArray::type);
    got = v.list(context.getScope).map(array ->
      array.map(t -> (SKROL.StringObject::type(t.value).value, t.tick.value))
    );
    T.expectEq(got, Some(expect));
    T.expectEq(v.size(context.getScope), Some(size));
  };
  context.update();
  check(Array[("a", 0), ("b", 0), ("c", 0), ("d", 0)], (4, O.Tick(0)));
  v2 = Array["a", "b", "c", "d", "e"].map(v -> O.StringObject(v));
  context.set(i1, O.SFArray(v2));
  context.update();
  check(
    Array[("a", 0), ("b", 0), ("c", 0), ("d", 0), ("e", 2)],
    (5, O.Tick(2)),
  );
  v3 = Array["e", "a", "b", "c", "d"].map(v -> O.StringObject(v));
  context.set(i1, O.SFArray(v3));
  context.update();
  check(
    Array[("e", 2), ("a", 0), ("b", 0), ("c", 0), ("d", 0)],
    (5, O.Tick(2)),
  );
  v4 = Array["e", "a", "c", "d"].map(v -> O.StringObject(v));
  context.set(i1, O.SFArray(v4));
  context.update();
  check(Array[("e", 2), ("a", 0), ("c", 0), ("d", 0)], (4, O.Tick(4)));

  v5 = Array["d", "e", "a", "f", "c"].map(v -> O.StringObject(v));
  context.set(i1, O.SFArray(v5));
  context.update();
  check(
    Array[("d", 0), ("e", 2), ("a", 0), ("f", 5), ("c", 0)],
    (5, O.Tick(5)),
  );
}

class AddMap(v: Int) extends O.IMappingFn {
  fun apply(value: O.Object): O.Object {
    O.IntObject(O.IntObject::type(value).value + this.v)
  }
}

class Sum() extends O.IReducerFn {
  //
  fun default(): O.Object {
    O.IntObject(0)
  }

  fun apply(acc: O.Object, value: O.Object): O.Object {
    O.IntObject::type(acc) + O.IntObject::type(value)
  }

  fun revert(cum: O.Object, value: O.Object): Result<O.Object, void> {
    Success(O.IntObject::type(cum) - O.IntObject::type(value))
  }
}

@test
fun mapReduce(): void {
  logger = mutable O.Logger(Logger.Config{minLevel => Logger.Debug()});
  try {
    context = O.Context::create(logger);
    v1 = Array[0, 1, 2, 3].map(v -> O.IntObject(v));
    i1 = context.input(O.ObjectArray(v1));
    c1 = context.combine(
      O.Function::create(Array[i1], Array[], O.REagerMap(AddMap(1))),
    );
    c2 = context.combine(
      O.Function::create(Array[c1], Array[], O.REagerMap(AddMap(2))),
    );
    c3 = context.combine(
      O.Function::create(Array[c2], Array[], O.REagerReduce(Sum())),
    );
    check = (c, expect) -> {
      v = context.get(c, O.ObjectArray::type);
      got = v.value.map(v -> O.IntObject::type(v).value);
      T.expectEq(got, expect);
    };
    check2 = (expect) -> {
      v = context.get(c3, O.IntObject::type);
      got = v.value;
      T.expectEq(got, expect);
    };
    check(c1, Array[1, 2, 3, 4]);
    check(c2, Array[3, 4, 5, 6]);
    check2(18);
    v2 = Array[0, 1, 2, 3, 4].map(v -> O.IntObject(v));
    context.set(i1, O.ObjectArray(v2));
    context.update();
    check(c1, Array[1, 2, 3, 4, 5]);
    check(c2, Array[3, 4, 5, 6, 7]);
    check2(25);
    v3 = Array[0, 2, 3, 4].map(v -> O.IntObject(v));
    context.set(i1, O.ObjectArray(v3));
    context.update();
    check(c1, Array[1, 3, 4, 5]);
    check(c2, Array[3, 5, 6, 7]);
    check2(21);
  } catch {
  | err ->
    logger.flush();
    throw err
  }
}

module end;
