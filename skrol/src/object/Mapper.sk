module SKROL;

class SFMapperState(
  size: TInputProperty<Int>,
  order: TInputProperty<Array<Int>>,
  properties: Array<IEagerProperty>,
)

base class IMappingFn uses Equality {
  fun apply(value: Object): Object;
}

class SFMapper private (
  value: Array<IntObject>,
  fn: IMappingFn,
  optState: ?SFMapperState = None(),
) extends StatefullObject {
  //
  fun getReference(): Object {
    SFMapper(this.value, this.fn)
  }

  fun init(scope: mutable IScope): this {
    mappable = scope.getMappable();
    size = scope.input(IntObject(this.value.size()));

    properties = this.value.map(idx -> {
      function = Function(
        Array[mappable.get(idx.value)],
        Array[],
        (getter, _) ~> this.fn.apply(getter(0)),
      );
      scope.combine(function)
    });
    order = scope.input(IntArray(properties.map(p -> p.getPath().id)));
    SFMapper(
      this.value,
      this.fn,
      Some(
        SFMapperState(
          TInputProperty(size, ObjectToInt(), IntToObject()),
          TInputProperty(order, ObjectToIntArray(), IntArrayToObject()),
          properties,
        ),
      ),
    )
  }

  fun update(scope: mutable IScope, new: Object): Result<this, void> {
    newArray = new match {
    | a @ SFMapper _ if (a.fn != this.fn) -> return Failure(void)
    | a @ SFMapper _ -> a.value
    | _ -> return Failure(void)
    };
    mappable = scope.getMappable();
    this.optState match {
    | Some(state) ->
      steps = process(this.value, newArray);
      if (steps.isEmpty()) {
        return Success(this);
      };
      properties = Vector::mcreateFromItems(state.properties);
      deleted = mutable Vector<IEagerProperty>[];
      steps.each(step ->
        step match {
        | Insert(index, value) ->
          function = Function(
            Array[mappable.get(toint(value))],
            Array[],
            (getter, _) ~> this.fn.apply(getter(0)),
          );
          properties.insert(index, scope.combine(function))
        | Delete(index) ->
          deleted.push(properties[index]);
          properties.delete(index)
        | Move(from, to) -> properties.set(to, state.properties[from])
        | Update(_index, _value) ->
          // this is also a new value
          todo()
        }
      );
      order = properties.map(p -> p.getPath().id).toArray();
      state.order.set(scope, order);
      state.size.set(scope, newArray.size());
      scope.remove(deleted.map(p -> p.getPath().id).toArray());
      Success(this)
    | _ -> Failure(void)
    }
  }

  fun changes(_old: TimedObject): IChanges {
    // Mappable is missing
    // Get time to compute if value as been updated
    todo()
  }
}

module end;
