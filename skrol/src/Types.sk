module SKROL;

value class Tick(value: Int) {
  fun next(): this {
    static(this.value + 1)
  }
}

class Path(id: Int, optParent: ?Path = None()) uses Orderable, Hashable, Show {
  fun compare(other: Path): Order {
    this.optParent.compare(other.optParent) match {
    | EQ() -> this.id.compare(other.id)
    | v -> v
    }
  }

  fun isChildOf(path: Path): Bool {
    path.optParent.map(p -> p == this || this.isChildOf(p)).default(false)
  }

  fun toArray(): Array<Int> {
    v = mutable Vector<Int>[];
    this.fillVector(v);
    v.toArray()
  }

  fun fillVector(buffer: mutable Vector<Int>): void {
    this.optParent.each(parent -> parent.fillVector(buffer));
    buffer.push(this.id)
  }

  fun relativeTo(path: Path): ?Array<Int> {
    thisArray = this.toArray();
    pathArray = path.toArray();
    if (pathArray.size() > thisArray.size()) {
      return None()
    };
    for (i in Range(0, pathArray.size())) {
      if (thisArray[i] != pathArray[i]) {
        return None()
      }
    };
    Some(thisArray.drop(pathArray.size()));
  }

  fun toString(): String {
    this.toArray().join("/");
  }
}

base class Object {
  fun getReference(): Object;
}

base class IParameter uses Orderable
base class IWatch
base class IChanges

base class Watch extends IWatch {
  fun apply(object: Object): void;
}

base class WatchChanges extends IWatch {
  fun apply(changes: IChanges): void;
}

class Change(object: Object) extends IChanges

value class TimedObject(value: Object, tick: Tick)

class Nil() extends StatelessObject

trait ObjectToTyped {
  macro static fun type(obj: Object): this {
    obj match {
    | x @ #ThisClass _ -> x
    }
  }
}

trait ParamToTyped {
  macro static fun ptype(param: IParameter): this {
    param match {
    | x @ #ThisClass _ -> x
    }
  }
}

base mutable class Dependencies {
  mutable fun getTick(): Tick;
  mutable fun set(path: Path, property: IProperty, value: Object): void;
  mutable fun setLazy(
    path: Path,
    property: ILazyProperty,
    value: Object,
    param: IParameter,
  ): void;
  mutable fun addReader(path: Path, reader: Reader): void;
  mutable fun clearLazyReads(path: Path, param: IParameter): void;
  mutable fun addLazyRead(path: Path, param: IParameter, read: Path): void;
  mutable fun updateLazyReaders(path: Path, param: IParameter): void;
  readonly fun getObject(path: Path): Object;
  readonly fun getLazyObject(path: Path, param: IParameter): ?Object;
  readonly fun getObjectTime(path: Path): Tick;
}

base mutable class IScope {
  // The object must manage the state to be able the update it
  mutable fun input(value: Object): IInputProperty;
  mutable fun lazy(function: LazyFunction): ILazyProperty;
  mutable fun combine(function: Function): IEagerProperty;
}

base class StatefullObject extends Object uses HasClassName {
  fun init(scope: mutable IScope): this;
  fun update(scope: mutable IScope, new: Object): Result<this, void>;
  fun changes(old: TimedObject): IChanges;
}

base class StatelessObject extends Object {
  fun getReference(): Object {
    this
  }
}

base class IReadable {
  fun get(
    dependencies: mutable Dependencies,
    optReader: ?Reader = None(),
  ): Object;
  fun getTime(dependencies: mutable Dependencies): Tick;
}

base class ILazyReadable {
  fun get(
    dependencies: mutable Dependencies,
    param: IParameter,
    optReader: ?Reader = None(),
  ): Object;
  fun getTime(dependencies: mutable Dependencies): Tick;
}

base class IWritable {
  fun set(dependencies: mutable Dependencies, value: Object): void;
}

base class Reader(path: Path) uses Orderable {
  children =
  | EagerReader()
  | LazyReader(param: IParameter)

  fun relativeTo(ref: Path): RelativeReader
  | EagerReader(path) ->
    path.relativeTo(ref) match {
    | Some(rel) -> EagerChildReader(rel)
    | _ -> EagerParentReader(path)
    }
  | LazyReader(param, path) ->
    path.relativeTo(ref) match {
    | Some(rel) -> LazyChildReader(param, rel)
    | _ -> LazyParentReader(param, path)
    }
}

base class RelativeReader uses Orderable
base class ParentReader(path: Path) extends RelativeReader
base class ChildReader(path: Array<Int>) extends RelativeReader

class EagerParentReader() extends ParentReader
class EagerChildReader() extends ChildReader
class LazyParentReader(param: IParameter) extends ParentReader
class LazyChildReader(param: IParameter) extends ChildReader

base class IProperty {
  fun getPath(): Path;
}

base class IEagerProperty extends IProperty, IReadable uses Equality
base class ILazyProperty extends IProperty, ILazyReadable uses Equality
base class IInputProperty extends IEagerProperty, IWritable

class Function(
  inputs: Array<IEagerProperty>,
  lazys: Array<ILazyProperty>,
  fn: (Int -> Object, (Int, IParameter) -> Object) ~> Object,
) {
  fun call(dependencies: mutable Dependencies, optReader: ?Reader): Object {
    this.fn(
      idx -> this.inputs[idx].get(dependencies, optReader),
      (idx, param) -> this.lazys[idx].get(dependencies, param, optReader),
    )
  }
}

class LazyFunction(
  inputs: Array<IEagerProperty>,
  lazys: Array<ILazyProperty>,
  fn: (Int -> Object, (Int, IParameter) -> Object, IParameter) ~> Object,
) uses Equality {
  fun call(
    dependencies: mutable Dependencies,
    param: IParameter,
    optReader: ?Reader,
  ): Object {
    this.fn(
      idx -> this.inputs[idx].get(dependencies, optReader),
      (idx, param) -> this.lazys[idx].get(dependencies, param, optReader),
      param,
    )
  }

  fun ==(other: LazyFunction): Bool {
    native_eq(this, other) == 0;
  }
}

trait NumberContainer<T: Number> extends Number {
  protected fun getValue(): T;
  protected fun create(T): inst;

  fun +(other: inst): inst {
    this.create(this.getValue() + other.getValue())
  }

  fun -(other: inst): inst {
    this.create(this.getValue() - other.getValue())
  }

  fun *(other: inst): inst {
    this.create(this.getValue() * other.getValue())
  }

  fun /(other: inst): inst {
    this.create(this.getValue() / other.getValue())
  }

  fun negate(): inst {
    this.create(this.getValue().negate())
  }

  fun toFloat(): Float {
    this.getValue().toFloat()
  }

  fun toInt(): Int {
    this.getValue().toInt()
  }

  fun fromInt(x: Int): inst {
    this.create(this.getValue().fromInt(x))
  }

  fun fromFloat(x: Float): inst {
    this.create(this.getValue().fromFloat(x))
  }
}

class IntObject(
  value: Int,
) extends StatelessObject uses ObjectToTyped, NumberContainer<Int>, Orderable {
  //
  protected fun getValue(): Int {
    this.value
  }

  protected fun create(value: Int): IntObject {
    IntObject(value)
  }

  fun toString(): String {
    this.value.toString()
  }
}

class FloatObject(
  value: Float,
)
  extends StatelessObject
  uses ObjectToTyped, NumberContainer<Float>, Orderable {
  //
  protected fun getValue(): Float {
    this.value
  }

  protected fun create(value: Float): this {
    static(value)
  }

  fun toString(): String {
    this.value.toString()
  }
}

class BoolObject(value: Bool) extends StatelessObject uses ObjectToTyped
class StringObject(value: String) extends StatelessObject uses ObjectToTyped
class RangeObject(value: Range) extends StatelessObject uses ObjectToTyped

fun int(v: Int): IntObject {
  IntObject(v)
}

fun toint(v: Object): Int {
  IntObject::type(v).value
}

fun float(v: Float): FloatObject {
  FloatObject(v)
}

fun tofloat(v: Object): Float {
  FloatObject::type(v).value
}

fun bool(v: Bool): BoolObject {
  BoolObject(v)
}

fun tobool(v: Object): Bool {
  BoolObject::type(v).value
}

class IntParam(value: Int) extends IParameter uses ParamToTyped
class FloatParam(value: Float) extends IParameter uses ParamToTyped

class DummySFO() extends StatefullObject {
  fun init(_scope: mutable IScope): this {
    dummy()
  }

  fun update(_scope: mutable IScope, _new: Object): Result<this, void> {
    dummy()
  }

  fun changes(_old: TimedObject): IChanges {
    dummy()
  }

  fun getReference(): Object {
    dummy()
  }
}

class DummyWatch() extends Watch {
  fun apply(_object: Object): void {
    dummy()
  }
}

class DummyWatchChanges() extends WatchChanges {
  fun apply(_changes: IChanges): void {
    dummy()
  }
}

module end;
