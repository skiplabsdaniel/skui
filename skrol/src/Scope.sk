module SKROL;

// TODO i18n

fun assert(assertion: Bool, msg: () -> String): void {
  if (SkargoVersion.kProfile != "release") {
    if (!assertion) {
      .invariant_violation(msg())
    }
  }
}

fun invalidationError(invalidated: Int, updating: Int, scope: Path): String {
  `Invalidated id '${invalidated}' must be greated than updating one '${updating}' in scope '${scope}'`
}

class Readers(
  set: SortedSet<RelativeReader> = SortedSet[],
  readers: List<RelativeReader> = List.Nil(),
) {
  fun add(reader: RelativeReader): this {
    if (this.set.contains(reader)) {
      return this;
    };
    !this.set = this.set.add(reader);
    !this.readers = List.Cons(reader, this.readers);
    this
  }

  fun each(fn: RelativeReader -> void): void {
    this.readers.reversed().each(fn)
  }
}

class Reads(
  set: SortedSet<Path> = SortedSet[],
  reads: List<Path> = List.Nil(),
) {
  fun add(path: Path): this {
    if (this.set.contains(path)) {
      return this;
    };
    !this.set = this.set.add(path);
    !this.reads = List.Cons(path, this.reads);
    this
  }

  fun each(fn: Path -> void): void {
    this.reads.reversed().each(fn)
  }
}

mutable class Scope(
  path: Path,
  private mutable optParent: ?mutable Scope = None(),
  private properties: mutable Vector<IProperty> = mutable Vector[],
  private mutable scopes: SortedMap<Int, mutable Scope> = SortedMap[],
  private mutable readers: SortedMap<Int, Readers> = SortedMap[],
  private mutable combines: SortedMap<Int, Function> = SortedMap[],
  private mutable values: SortedMap<Int, TimedObject> = SortedMap[],
  private mutable lazyObjects: SortedMap<
    (Int, IParameter),
    TimedObject,
  > = SortedMap[],
  private mutable lazyReads: SortedMap<(Int, IParameter), Reads> = SortedMap[],
  private mutable lazys: SortedSet<(Int, IParameter)> = SortedSet[],
  private mutable tick: Tick = Tick(0),
  private mutable watchedObjects: SortedSet<Int> = SortedSet[],
  private mutable outputs: SortedSet<Int> = SortedSet[],
  private mutable updating: Int = -1,
  private mutable invalidateds: SortedSet<Int> = SortedSet[],
  private mutable updated: SortedMap<Int, TimedObject> = SortedMap[],
) extends Dependencies, IScope {
  //
  mutable fun input(object: Object): IInputProperty {
    id = this.properties.size();
    !object = this.checkObject(id, object);
    prop = InputProperty(Path(this.properties.size(), Some(this.path)));
    this.!values = this.values.set(id, TimedObject(object, this.tick));
    this.properties.push(prop);
    prop
  }

  mutable fun lazy(function: LazyFunction): ILazyProperty {
    prop = LazyProperty(
      function,
      Path(this.properties.size(), Some(this.path)),
    );
    this.properties.push(prop);
    prop
  }

  mutable fun watch(id: Int): void {
    this.!watchedObjects = this.watchedObjects.set(id)
  }

  mutable fun unwatch(id: Int): void {
    this.!watchedObjects = this.watchedObjects.remove(id)
  }

  mutable fun output(id: Int): void {
    this.!outputs = this.outputs.set(id)
  }

  mutable fun unoutput(id: Int): void {
    this.!outputs = this.outputs.remove(id)
  }

  mutable fun combine(function: Function): IEagerProperty {
    id = this.properties.size();
    property = EagerProperty(Path(id, Some(this.path)));
    value = function.call(this, Some(EagerReader(property.path)));
    this.!values = this.values.set(id, TimedObject(value, this.tick));
    this.!combines = this.combines.set(id, function);
    this.properties.push(property);
    property
  }

  mutable fun getTick(): Tick {
    this.tick
  }

  mutable fun getScope(path: Path): mutable Scope {
    aPath = path.toArray();
    current = this;
    assert(aPath.first() == this.path.id, () ~> "Invalid scope path");
    for (i in Range(1, aPath.size())) {
      !current = current.scopes[aPath[i]]
    };
    current
  }

  readonly fun hasObject(path: Path): Bool {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.containsKey(path.id)
    | Some _ -> this.optParent.fromSome().hasObject(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getObject(path: Path): Object {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.get(path.id).value
    | Some _ -> this.optParent.fromSome().getObject(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getLazyObject(path: Path, param: IParameter): ?Object {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      if (this.lazys.contains((path.id, param))) return None();
      // Reads need to be registered
      this.lazyObjects.maybeGet((path.id, param)).map(v -> v.value)
    | Some _ -> this.optParent.fromSome().getLazyObject(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getObjectTime(path: Path): Tick {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.get(path.id).tick
    | Some _ -> this.optParent.fromSome().getObjectTime(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getLazyObjectTime(path: Path, param: IParameter): ?Tick {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.lazyObjects.maybeGet((path.id, param)).map(v -> v.tick)
    | Some _ -> this.optParent.fromSome().getLazyObjectTime(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  private mutable fun checkObject(id: Int, object: Object): Object {
    object match {
    | sf @ StatefullObject _ ->
      subscope = mutable Scope(Path(id, Some(this.path)), Some(this));
      this.!scopes = this.scopes.set(id, subscope);
      sf.init(subscope)
    | _ -> object
    };
  }

  private mutable fun invalidateReaders(id: Int): void {
    this.readers.maybeGet(id).each(rs -> rs.each(r -> this.invalidate(r)));
    this.!readers = this.readers.remove(id);
  }

  private mutable fun setIn(
    id: Int,
    readable: IProperty,
    object: Object,
  ): void {
    optScope = this.scopes.maybeGet(id);
    optScope.each(scope -> {
      scope.invalidateExternalReaders();
      this.!scopes = this.scopes.remove(id);
    });
    optOld = this.values.maybeGet(id);
    !object = (optScope, optOld) match {
    | (Some(oldScope), Some(oldObject)) ->
      (oldObject.value as StatefullObject _).update(oldScope, object) match {
      | Success(v) ->
        this.!scopes = this.scopes.set(id, oldScope);
        v
      | _ -> this.checkObject(id, object)
      }
    | _ -> this.checkObject(id, object)
    };
    this.properties.set(id, readable);
    optOld.each(old -> this.!updated = this.updated.set(id, old));
    this.!values = this.values.set(id, TimedObject(object, this.tick));
    this.invalidateReaders(id);
  }

  private mutable fun setLazyIn(
    id: Int,
    property: ILazyProperty,
    value: Object,
    param: IParameter,
  ): void {
    this.properties.set(id, property);
    this.!lazyObjects = this.lazyObjects.set(
      (id, param),
      TimedObject(value, this.tick),
    );
    this.!lazys = this.lazys.remove((id, param));
    this.invalidateReaders(id)
  }

  mutable fun set(path: Path, property: IProperty, value: Object): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.setIn(path.id, property, value)
    | Some _ -> this.optParent.fromSome().set(path, property, value)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun setLazy(
    path: Path,
    property: ILazyProperty,
    value: Object,
    param: IParameter,
  ): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.setLazyIn(path.id, property, value, param)
    | Some _ -> this.optParent.fromSome().setLazy(path, property, value, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun addReader(path: Path, reader: Reader): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      rds = this.readers.maybeGet(path.id) match {
      | Some(rds) -> rds
      | _ -> Readers()
      };
      !rds = rds.add(reader.relativeTo(this.path));
      this.!readers = this.readers.set(path.id, rds)
    | Some _ -> this.optParent.fromSome().addReader(path, reader)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun clearLazyReads(path: Path, param: IParameter): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.!lazyReads = this.lazyReads.remove((path.id, param))
    | Some _ -> this.optParent.fromSome().clearLazyReads(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun updateLazyReaders(path: Path, param: IParameter): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.lazyReads.maybeGet((path.id, param)).each(reads ->
        reads.each(p -> this.addReader(p, LazyReader(param, path)))
      )
    | Some _ -> this.optParent.fromSome().updateLazyReaders(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun addLazyRead(path: Path, param: IParameter, read: Path): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      rds = this.lazyReads.maybeGet((path.id, param)) match {
      | Some(rds) -> rds
      | _ -> Reads()
      };
      !rds = rds.add(read);
      this.!lazyReads = this.lazyReads.set((path.id, param), rds)
    | Some _ -> this.optParent.fromSome().addLazyRead(path, param, read)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  // TODO: verify reader are invalidated in decalaration order
  mutable fun invalidate(reader: RelativeReader): void {
    reader match {
    | cr @ ChildReader _ ->
      scope = this;
      for (i in Range(0, cr.path.size() - 1)) {
        !scope = scope.scopes[cr.path[i]]
      };
      id = cr.path.last();
      cr match {
      | EagerChildReader _ ->
        // if statfull object already invalidated can stop the propagation
        if (!scope.invalidateds.contains(id)) {
          // TODO debug MODE
          assert(id > this.updating, () ->
            invalidationError(id, this.updating, this.path)
          );
          scope.!invalidateds = scope.invalidateds.set(id);
          // Propagate the invalidation to the statfull object corresponding to the scope
          // to trigger the update
          scope.optParent.each(s -> s.invalidate(EagerParentReader(scope.path)))
        }
      | LazyChildReader(param, _) ->
        scope.!lazys = scope.lazys.set((id, param));
        // Invalidate the statfull object corresponding to the scope
        // to trigger the update
        scope.optParent.each(s -> s.invalidate(EagerParentReader(scope.path)))
      }
    | pr @ ParentReader _ ->
      pr.path.optParent match {
      | Some(parent) if (parent == this.path) ->
        pr match {
        | EagerParentReader(p) ->
          // if statfull object already invalidated can stop the propagation
          if (!this.invalidateds.contains(p.id)) {
            // TODO debug MODE
            assert(p.id > this.updating, () ->
              invalidationError(p.id, this.updating, this.path)
            );
            this.!invalidateds = this.invalidateds.set(p.id);
            // Propagate the invalidation to the statfull object corresponding to the scope
            // to trigger the update
            this.optParent.each(s -> s.invalidate(EagerParentReader(this.path)))
          }
        | LazyParentReader(param, p) ->
          this.!lazys = this.lazys.set((p.id, param));
          // Invalidate the statfull object corresponding to the scope
          // to trigger the update
          this.optParent.each(s -> s.invalidate(EagerParentReader(this.path)))
        }
      | Some _ -> this.optParent.fromSome().invalidate(reader)
      | _ -> invariant_violation("Property have to get scope parent")
      }
    }
  }

  readonly fun get(path: Path): IProperty {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.properties.get(path.id)
    | Some _ -> this.optParent.fromSome().get(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun invalidateExternalReaders(optPath: ?Path = None()): void {
    path = optPath.default(this.path);
    this.scopes.each((_, sscope) ->
      sscope.invalidateExternalReaders(Some(path))
    );
    this.readers.each((_, v) ->
      v.each(r ->
        r match {
        | pr @ ParentReader(p) ->
          if (!p.isChildOf(path)) {
            this.invalidate(pr)
          }
        | ChildReader _ -> void
        }
      )
    );
  }

  mutable fun update(tick: Tick): SortedMap<Path, TimedObject> {
    this.!tick = tick;
    watched = SortedMap[];
    loop {
      this.invalidateds.min() match {
      | Some(invalidated) ->
        this.!updating = invalidated;
        this.properties[invalidated] match {
        | IInputProperty _ ->
          this.scopes.maybeGet(invalidated).each(scope -> {
            ws = scope.update(tick);
            !watched = watched.merge(ws);
          })
        | eager @ IEagerProperty _ ->
          function = this.combines[invalidated];
          current = this.values[invalidated].value;
          value = function.call(this, Some(EagerReader(eager.getPath())));
          if (native_eq(current.getReference(), value.getReference()) != 0) {
            this.setIn(invalidated, eager, value);
          }
        | ILazyProperty _ ->
          // Lazy value is computed only on need.
          void
        };
        this.!invalidateds = this.invalidateds.remove(invalidated)
      | _ -> break void
      }
    };
    // Return watched updates
    this.watchedObjects.each(id ->
      this.updated.maybeGet(id).each(timed ->
        !watched = watched.set(Path(id, Some(this.path)), timed)
      )
    );
    this.outputs.each(id -> {
      timed = this.values.get(id);
      !watched = watched.set(Path(id, Some(this.path)), timed)
    });

    // Clear all uncomputed lazy values
    this.lazys.each(lv -> this.!lazyObjects = this.lazyObjects.remove(lv));
    this.!lazys = SortedSet[];
    this.!updated = SortedMap[];
    this.!updating = -1;
    watched
  }

  readonly fun chill(): Scope {
    Scope(
      this.path,
      None(),
      this.properties.chill(),
      this.scopes.map((_, v) -> v.chill()),
      this.readers,
      this.combines,
      this.values,
      this.lazyObjects,
      this.lazyReads,
      this.lazys,
      this.tick,
      this.watchedObjects,
      this.outputs,
    )
  }

  readonly fun clone(optParent: ?mutable Scope = None()): mutable Scope {
    mscope = mutable Scope(
      this.path,
      optParent,
      this.properties.clone(),
      this.scopes.map((_, v) -> v.clone()),
      this.readers,
      this.combines,
      this.values,
      this.lazyObjects,
      this.lazyReads,
      this.lazys,
      this.tick,
      this.watchedObjects,
      this.outputs,
    );
    mscope.scopes.each((_, v) -> v.!optParent = Some(mscope));
    mscope
  }
}

module end;
