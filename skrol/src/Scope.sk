module SKROL;

// TODO i18n

fun assert(assertion: Bool, msg: () -> String): void {
  if (SkargoVersion.kProfile != "release") {
    if (!assertion) {
      .invariant_violation(msg())
    }
  }
}

fun invalidationError(invalidated: Int, updating: Int, scope: Path): String {
  `Invalidated id '${invalidated}' must be greated than updating one '${updating}' in scope '${scope}'`
}

class Readers(
  set: SortedSet<RelativeReader> = SortedSet[],
  readers: List<RelativeReader> = List.Nil(),
) {
  fun add(reader: RelativeReader): this {
    if (this.set.contains(reader)) {
      return this;
    };
    !this.set = this.set.add(reader);
    !this.readers = List.Cons(reader, this.readers);
    this
  }

  fun each(fn: RelativeReader -> void): void {
    this.readers.reversed().each(fn)
  }
}

class Invalider(path: Path, optModifier: ?IModifier)

class Invaliders(values: SortedMap<Path, IModifier> = SortedMap[]) {
  //
  fun add(invalider: Invalider): this {
    invalider.optModifier.each(modifier ->
      !this.values = this.values.set(invalider.path, modifier)
    );
    this
  }

  fun map<V>(f: (Path, IModifier) -> V): SortedMap<Path, V> {
    this.values.map(f)
  }

  fun each<V>(f: (Path, IModifier) -> void): void {
    this.values.each(f)
  }
}

class Invalidateds(values: SortedMap<Int, Invaliders> = SortedMap[]) {
  //
  fun add(invalidated: Int, invalider: Invalider): this {
    invaliders = this.values.maybeGet(invalidated) match {
    | Some(invaliders) -> invaliders
    | _ -> Invaliders()
    };
    !this.values = this.values.set(invalidated, invaliders.add(invalider));
    this
  }

  fun contains(invalidated: Int): Bool {
    this.values.containsKey(invalidated)
  }

  fun minimum(): ?(Int, Invaliders) {
    this.values.minimum()
  }

  fun remove(invalidated: Int): this {
    !this.values = this.values.remove(invalidated);
    this
  }
}

class Reads(
  set: SortedSet<Path> = SortedSet[],
  reads: List<Path> = List.Nil(),
) {
  fun add(path: Path): this {
    if (this.set.contains(path)) {
      return this;
    };
    !this.set = this.set.add(path);
    !this.reads = List.Cons(path, this.reads);
    this
  }

  fun each(fn: Path -> void): void {
    this.reads.reversed().each(fn)
  }
}

// TODO manage deleted

mutable class Scope(
  path: Path,
  private optLogger: ?mutable ILogger = None(),
  private mutable optParent: ?mutable Scope = None(),
  private mutable properties: SortedMap<Int, IProperty> = SortedMap[],
  private mutable scopes: SortedMap<Int, mutable Scope> = SortedMap[],
  private mutable readers: SortedMap<Int, Readers> = SortedMap[],
  private mutable combines: SortedMap<Int, Function> = SortedMap[],
  private mutable values: SortedMap<Int, TimedObject> = SortedMap[],
  private mutable next: SortedMap<Int, Object> = SortedMap[],
  private mutable lazyObjects: SortedMap<
    (Int, IParameter),
    TimedObject,
  > = SortedMap[],
  private mutable lazyReads: SortedMap<(Int, IParameter), Reads> = SortedMap[],
  private mutable lazys: SortedSet<(Int, IParameter)> = SortedSet[],
  private mutable tick: Tick = Tick(0),
  private mutable watchedObjects: SortedSet<Int> = SortedSet[],
  private mutable nextId: Int = 0,
  private mutable updating: Int = -1,
  private mutable invalidateds: Invalidateds = Invalidateds(),
  private mutable updated: SortedMap<Int, TimedObject> = SortedMap[],
) extends Dependencies, IScope, IMappable {
  //
  readonly fun getPath(): Path {
    this.path
  }

  mutable fun getMappable(): mutable IMappable {
    this.optParent.fromSome()
  }

  readonly fun get(key: Int): IEagerProperty {
    this.properties.get(key) as IEagerProperty _;
  }

  readonly fun maybeGet(key: Int): ?IEagerProperty {
    this.properties.maybeGet(key).map(p -> p as IEagerProperty _)
  }

  readonly fun object(key: Int): TimedObject {
    this.values.get(key);
  }

  readonly fun maybeObject(key: Int): ?TimedObject {
    this.values.maybeGet(key)
  }

  mutable fun input(object: Object): IInputProperty {
    id = this.nextId;
    this.!nextId = this.nextId + 1;
    !object = this.checkObject(id, object);
    prop = InputProperty(Path(id, Some(this.path)));
    this.!values = this.values.set(id, TimedObject(object, this.tick));
    this.!properties = this.properties.set(id, prop);
    prop
  }

  mutable fun lazy(function: LazyFunction): ILazyProperty {
    id = this.nextId;
    this.!nextId = this.nextId + 1;
    prop = LazyProperty(function, Path(id, Some(this.path)));
    this.!properties = this.properties.set(id, prop);
    prop
  }

  mutable fun watch(id: Int): void {
    this.!watchedObjects = this.watchedObjects.set(id)
  }

  mutable fun unwatch(id: Int): void {
    this.!watchedObjects = this.watchedObjects.remove(id)
  }

  mutable fun combine(function: Function): IEagerProperty {
    id = this.nextId;
    path = this.getPath();
    tick = this.getTick();
    #log (this.debug, () ~>
      `Enter Scope.combine property ${id} in scope ${path} on tick ${tick}`
    );
    this.!nextId = this.nextId + 1;
    property = EagerProperty(Path(id, Some(this.path)));
    subscope = this.buildSubScope(id);
    (value, !function) = function.init(
      this,
      subscope,
      Some(EagerReader(property.path)),
    );
    this.!values = this.values.set(id, TimedObject(value, this.tick));
    this.!combines = this.combines.set(id, function);
    this.!properties = this.properties.set(id, property);
    #log (this.debug, () ~>
      `Exit Scope.combine property ${id} in scope ${path} on tick ${tick}`
    );
    property
  }

  mutable fun map(property: IEagerProperty, fn: IMappingFn): IEagerProperty {
    function = Function::create(
      Array[property],
      Array[],
      PureFn((g, _lg) ~> {
        g.i1(0) match {
        | mo @ MappableObject _ -> mo.map(fn)
        | o -> fn.apply(o)
        }
      }),
    );
    this.combine(function)
  }

  mutable fun getTick(): Tick {
    this.tick
  }

  mutable fun getScope(path: Path): mutable Scope {
    aPath = path.toArray();
    current = this;
    assert(aPath.first() == this.path.id, () ~> "Invalid scope path");
    for (i in Range(1, aPath.size())) {
      !current = current.scopes[aPath[i]]
    };
    current
  }

  readonly fun hasObject(path: Path): Bool {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.containsKey(path.id)
    | Some _ -> this.optParent.fromSome().hasObject(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getObject(path: Path): Object {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.get(path.id).value
    | Some _ -> this.optParent.fromSome().getObject(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getTimedObject(path: Path): TimedObject {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.get(path.id)
    | Some _ -> this.optParent.fromSome().getTimedObject(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getLazyObject(path: Path, param: IParameter): ?Object {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      if (this.lazys.contains((path.id, param))) return None();
      // Reads need to be registered
      this.lazyObjects.maybeGet((path.id, param)).map(v -> v.value)
    | Some _ -> this.optParent.fromSome().getLazyObject(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getObjectTime(path: Path): Tick {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.values.get(path.id).tick
    | Some _ -> this.optParent.fromSome().getObjectTime(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  readonly fun getLazyObjectTime(path: Path, param: IParameter): ?Tick {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.lazyObjects.maybeGet((path.id, param)).map(v -> v.tick)
    | Some _ -> this.optParent.fromSome().getLazyObjectTime(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  private mutable fun checkObject(id: Int, object: Object): Object {
    object match {
    | sf @ StatefullObject _ -> sf.init(this.buildSubScope(id))
    | _ -> object
    };
  }

  private mutable fun buildSubScope(id: Int): mutable IScope {
    subscope = mutable Scope(
      Path(id, Some(this.path)),
      this.optLogger,
      Some(this),
    );
    this.!scopes = this.scopes.set(id, subscope);
    subscope
  }

  private mutable fun invalidateReaders(id: Int, invalider: Invalider): void {
    this.readers.maybeGet(id).each(rs ->
      rs.each(r -> this.invalidate(invalider, r))
    );
    this.!readers = this.readers.remove(id);
  }

  @debug
  private mutable fun setIn(
    id: Int,
    object: Object,
    optModifier: ?IModifier,
    withScope: Bool = false,
  ): void {
    path = this.getPath();
    tick = this.getTick();
    #log (this.debug, () ~>
      `Enter Scope.setIn property ${id} in scope ${path} on tick ${tick}`
    );
    invalider = Invalider(Path(id, Some(this.path)), optModifier);
    optScope = this.scopes.maybeGet(id);
    optScope.each(scope -> {
      scope.invalidateExternalReaders(invalider);
      this.!scopes = this.scopes.remove(id);
    });
    optOld = this.values.maybeGet(id);
    !object = (optScope, optOld) match {
    | (Some(oldScope), Some(oldObject)) ->
      oldScope.!tick = this.tick;
      (nobject, updated) = oldScope.updateObject(oldObject.value, object);
      if (updated) this.!invalidateds = this.invalidateds.add(id, invalider);
      if (updated || withScope) this.!scopes = this.scopes.set(id, oldScope);
      nobject
    | _ -> this.checkObject(id, object)
    };
    optOld.each(old -> this.!updated = this.updated.set(id, old));
    this.!values = this.values.set(id, TimedObject(object, this.tick));
    this.invalidateReaders(id, invalider);
    #log (this.debug, () ~>
      `Exit Scope.setIn property ${id} in scope ${path} on tick ${tick}`
    );
  }

  private mutable fun setLazyIn(
    id: Int,
    value: Object,
    param: IParameter,
  ): void {
    this.!lazyObjects = this.lazyObjects.set(
      (id, param),
      TimedObject(value, this.tick),
    );
    invalider = Invalider(Path(id, Some(this.path)), Some(param));
    this.!lazys = this.lazys.remove((id, param));
    this.invalidateReaders(id, invalider)
  }

  mutable fun set(property: IProperty, value: Object): void {
    path = property.getPath();
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.!next = this.next.set(path.id, value)
    | Some _ -> this.optParent.fromSome().set(property, value)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun setLazy(
    property: ILazyProperty,
    value: Object,
    param: IParameter,
  ): void {
    path = property.getPath();
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.setLazyIn(path.id, value, param)
    | Some _ -> this.optParent.fromSome().setLazy(property, value, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun addReader(path: Path, reader: Reader): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      rds = this.readers.maybeGet(path.id) match {
      | Some(rds) -> rds
      | _ -> Readers()
      };
      !rds = rds.add(reader.relativeTo(this.path));
      this.!readers = this.readers.set(path.id, rds)
    | Some _ -> this.optParent.fromSome().addReader(path, reader)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun clearLazyReads(path: Path, param: IParameter): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.!lazyReads = this.lazyReads.remove((path.id, param))
    | Some _ -> this.optParent.fromSome().clearLazyReads(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun updateLazyReaders(path: Path, param: IParameter): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      this.lazyReads.maybeGet((path.id, param)).each(reads ->
        reads.each(p -> this.addReader(p, LazyReader(param, path)))
      )
    | Some _ -> this.optParent.fromSome().updateLazyReaders(path, param)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun addLazyRead(path: Path, param: IParameter, read: Path): void {
    path.optParent match {
    | Some(parent) if (parent == this.path) ->
      rds = this.lazyReads.maybeGet((path.id, param)) match {
      | Some(rds) -> rds
      | _ -> Reads()
      };
      !rds = rds.add(read);
      this.!lazyReads = this.lazyReads.set((path.id, param), rds)
    | Some _ -> this.optParent.fromSome().addLazyRead(path, param, read)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  // TODO: verify reader are invalidated in decalaration order
  mutable fun invalidate(invalider: Invalider, reader: RelativeReader): void {
    reader match {
    | cr @ ChildReader _ ->
      scope = this;
      for (i in Range(0, cr.path.size() - 1)) {
        !scope = scope.scopes[cr.path[i]]
      };
      id = cr.path.last();
      cr match {
      | EagerChildReader _ ->
        // if statfull object already invalidated can stop the propagation
        if (!scope.invalidateds.contains(id)) {
          // TODO debug MODE
          assert(id > this.updating, () ->
            invalidationError(id, this.updating, this.path)
          );
          scope.!invalidateds = scope.invalidateds.add(id, invalider);
          // Propagate the invalidation to the statfull object corresponding to the scope
          // to trigger the update
          scope.optParent.each(s ->
            s.invalidate(invalider, EagerParentReader(scope.path))
          )
        }
      | LazyChildReader(param, _) ->
        scope.!lazys = scope.lazys.set((id, param));
        // Invalidate the statfull object corresponding to the scope
        // to trigger the update
        scope.optParent.each(s ->
          s.invalidate(invalider, EagerParentReader(scope.path))
        )
      }
    | pr @ ParentReader _ ->
      pr.path.optParent match {
      | Some(parent) if (parent == this.path) ->
        pr match {
        | EagerParentReader(p) ->
          // if statfull object already invalidated can stop the propagation
          if (!this.invalidateds.contains(p.id)) {
            // TODO debug MODE
            assert(p.id > this.updating, () ->
              invalidationError(p.id, this.updating, this.path)
            );
            this.!invalidateds = this.invalidateds.add(p.id, invalider);
            // Propagate the invalidation to the statfull object corresponding to the scope
            // to trigger the update
            this.optParent.each(s ->
              s.invalidate(invalider, EagerParentReader(this.path))
            )
          }
        | LazyParentReader(param, p) ->
          this.!lazys = this.lazys.set((p.id, param));
          // Invalidate the statfull object corresponding to the scope
          // to trigger the update
          this.optParent.each(s ->
            s.invalidate(invalider, EagerParentReader(this.path))
          )
        }
      | Some _ -> this.optParent.fromSome().invalidate(invalider, reader)
      | _ -> invariant_violation("Property have to get scope parent")
      }
    }
  }

  readonly fun getProperty(path: Path): IProperty {
    path.optParent match {
    | Some(parent) if (parent == this.path) -> this.properties.get(path.id)
    | Some _ -> this.optParent.fromSome().getProperty(path)
    | _ -> invariant_violation("Property have to get scope parent")
    }
  }

  mutable fun invalidateExternalReaders(
    invalider: Invalider,
    optPath: ?Path = None(),
  ): void {
    path = optPath.default(this.path);
    this.scopes.each((_, sscope) ->
      sscope.invalidateExternalReaders(invalider, Some(path))
    );
    this.readers.each((_, v) ->
      v.each(r ->
        r match {
        | pr @ ParentReader(p) ->
          if (!p.isChildOf(path)) {
            this.invalidate(invalider, pr)
          }
        | ChildReader _ -> void
        }
      )
    );
  }

  mutable fun update(tick: Tick): SortedMap<Path, TimedObject> {
    this.!tick = tick;
    path = this.path;
    #log (this.debug, () ~> `Enter Scope.update '${path}' on tick ${tick}`);
    watched = SortedMap[];
    loop {
      this.next.minimum() match {
      | Some((next, value)) ->
        current = this.values[next].value;
        if (native_eq(current.getReference(), value.getReference()) != 0) {
          this.setIn(next, value, None());
        };
        this.!next = this.next.remove(next)
      | _ -> break void
      }
    };
    loop {
      this.invalidateds.minimum() match {
      | Some((invalidated, invaliders)) ->
        this.!updating = invalidated;
        this.properties[invalidated] match {
        | IInputProperty _ ->
          this.scopes.maybeGet(invalidated).each(scope -> {
            ws = scope.update(tick);
            !watched = watched.merge(ws);
          })
        | eager @ IEagerProperty _ ->
          function = this.combines[invalidated];
          current = this.values[invalidated].value;
          scope = this.scopes[invalidated];
          scope.!tick = this.tick;
          (value, optKeys, !function) = function.update(
            this,
            scope,
            current,
            invaliders,
            Some(EagerReader(eager.getPath())),
          );
          this.!combines = this.combines.set(invalidated, function);
          if (native_eq(current.getReference(), value.getReference()) != 0) {
            this.setIn(invalidated, value, optKeys, true);
          }
        | ILazyProperty _ ->
          // Lazy value is computed only on need.
          void
        };
        this.!invalidateds = this.invalidateds.remove(invalidated)
      | _ -> break void
      }
    };
    // Return watched updates
    this.watchedObjects.each(id ->
      this.updated.maybeGet(id).each(timed ->
        !watched = watched.set(Path(id, Some(this.path)), timed)
      )
    );

    // Clear all uncomputed lazy values
    this.lazys.each(lv -> this.!lazyObjects = this.lazyObjects.remove(lv));
    this.!lazys = SortedSet[];
    this.!updated = SortedMap[];
    this.!updating = -1;
    #log (this.debug, () ~> `Exit Scope.update '${path}' on tick ${tick}`);
    watched
  }

  mutable fun initObject(object: Object): Object {
    object match {
    | sf @ StatefullObject _ -> sf.init(this)
    | _ -> object
    }
  }

  mutable fun updateObject(current: Object, new: Object): (Object, Bool) {
    current match {
    | sf @ StatefullObject _ ->
      sf.update(this, new) match {
      | Success(v) -> (v, true)
      | _ -> (this.initObject(new), false)
      }
    | _ -> (this.initObject(new), false)
    }
  }

  mutable fun deleteObject(object: Object): void {
    object match {
    | sf @ StatefullObject _ -> sf.delete(this)
    | _ -> void
    }
  }

  readonly fun chill(): Scope {
    Scope(
      this.path,
      None(),
      None(),
      this.properties.chill(),
      this.scopes.map((_, v) -> v.chill()),
      this.readers,
      this.combines,
      this.values,
      this.next,
      this.lazyObjects,
      this.lazyReads,
      this.lazys,
      this.tick,
      this.watchedObjects,
      this.nextId,
    )
  }

  readonly fun clone(logger: mutable ILogger): mutable Scope {
    mscope = mutable Scope(
      this.path,
      Some(logger),
      None(),
      this.properties,
      this.scopes.map((_, v) -> v.clone(logger)),
      this.readers,
      this.combines,
      this.values,
      this.next,
      this.lazyObjects,
      this.lazyReads,
      this.lazys,
      this.tick,
      this.watchedObjects,
      this.nextId,
    );
    mscope.scopes.each((_, v) -> v.!optParent = Some(mscope));
    mscope
  }

  mutable fun log(
    level: Logger.Level,
    msg: () ~> String,
    meta: Logger.Metadata,
  ): void {
    this.optLogger.each(l -> l.log(level, msg, meta))
  }

  mutable fun remove(properties: Array<Int>): void {
    // TODO manage watched
    properties.each(p -> {
      this.!properties = this.properties.remove(p);
      this.!values = this.values.remove(p);
      this.!scopes = this.scopes.remove(p);
      lazy = this.lazyObjects;
      lazy.each((k, _v) ->
        if (k.i0 == p) {
          this.!lazyObjects = this.lazyObjects.remove(k)
        }
      )
    });
  }
}

module end;
