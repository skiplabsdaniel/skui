module SKROL;

base class Converter<F: frozen, T: frozen> uses Equality {
  fun convert(from_: F): T;
}

class ObjectToInt() extends Converter<Object, Int> {
  fun convert(from_: Object): Int {
    IntObject::type(from_).value
  }
}

class IntToObject() extends Converter<Int, Object> {
  fun convert(from_: Int): Object {
    IntObject(from_)
  }
}

class ObjectToFloat() extends Converter<Object, Float> {
  fun convert(from_: Object): Float {
    FloatObject::type(from_).value
  }
}

class FloatToObject() extends Converter<Float, Object> {
  fun convert(from_: Float): Object {
    FloatObject(from_)
  }
}

class IntArrayToObject() extends Converter<Array<Int>, Object> {
  fun convert(from_: Array<Int>): Object {
    IntArray(from_)
  }
}

class ObjectToIntArray() extends Converter<Object, Array<Int>> {
  fun convert(from_: Object): Array<Int> {
    IntArray::type(from_).value
  }
}

module end;
