module SKROL;

base class EagerPropertyBase final (path: Path) {
  //

  fun get(
    dependencies: mutable Dependencies,
    optReader: ?Reader = None(),
  ): Object {
    value = dependencies.getObject(this.path);
    optReader.each(reader -> {
      reader match {
      | LazyReader(param, p) -> dependencies.addLazyRead(p, param, this.path)
      | EagerReader _ -> void
      };
      dependencies.addReader(this.path, reader)
    });
    value
  }

  fun getPath(): Path {
    this.path
  }

  fun getTime(dependencies: mutable Dependencies): Tick {
    dependencies.getObjectTime(this.path)
  }
}

class EagerProperty extends EagerPropertyBase, IEagerProperty

class InputProperty extends EagerPropertyBase, IInputProperty {
  fun set(dependencies: mutable Dependencies, value: Object): void {
    current = dependencies.getObject(this.path);
    if (native_eq(current.getReference(), value.getReference()) != 0) {
      dependencies.set(this.path, this, value);
    }
  }
}

class LazyProperty(function: LazyFunction, path: Path) extends ILazyProperty {
  //
  fun get(
    dependencies: mutable Dependencies,
    param: IParameter,
    optReader: ?Reader = None(),
  ): Object {
    // Register read to update reader
    value = this.getObject(dependencies, param);
    optReader.each(reader -> dependencies.addReader(this.path, reader));
    value
  }

  protected fun getObject(
    dependencies: mutable Dependencies,
    param: IParameter,
  ): Object {
    // TODO ASSERT All values are validated at this moment
    dependencies.getLazyObject(this.path, param) match {
    | Some(v) ->
      dependencies.updateLazyReaders(this.path, param);
      v
    | _ ->
      dependencies.clearLazyReads(this.path, param);
      value = this.function.call(
        dependencies,
        param,
        Some(LazyReader(param, this.path)),
      );
      dependencies.setLazy(this.path, this, value, param);
      value
    }
  }

  fun untrackedCompute(
    dependencies: mutable Dependencies,
    param: IParameter,
  ): Object {
    this.function.call(dependencies, param, None());
  }

  fun getPath(): Path {
    this.path
  }

  fun getTime(dependencies: mutable Dependencies): Tick {
    dependencies.getObjectTime(this.path)
  }
}

class TEagerProperty<T: frozen>(
  property: IEagerProperty,
  fromObject: Converter<Object, T>,
) uses Equality {
  fun get(dependencies: mutable Dependencies, optReader: ?Reader = None()): T {
    this.fromObject.convert(this.property.get(dependencies, optReader))
  }
}

class TLazyProperty<T: frozen, P: frozen>(
  property: ILazyProperty,
  fromObject: Converter<Object, T>,
  toParameter: Converter<P, IParameter>,
) uses Equality {
  fun get(
    dependencies: mutable Dependencies,
    param: P,
    optReader: ?Reader = None(),
  ): T {
    this.fromObject.convert(
      this.property.get(
        dependencies,
        this.toParameter.convert(param),
        optReader,
      ),
    )
  }
}

module end;
