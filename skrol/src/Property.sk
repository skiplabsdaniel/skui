module SKROL;

base class EagerPropertyBase final (path: Path) {
  //

  fun get(
    dependencies: mutable Dependencies,
    optReader: ?Reader = None(),
  ): Value {
    value = dependencies.getValue(this.path);
    optReader.each(reader -> dependencies.add(this.path, Array[reader]));
    value
  }

  fun getPath(): Path {
    this.path
  }

  fun getTime(dependencies: mutable Dependencies): Tick {
    dependencies.getValueTime(this.path)
  }
}

class EagerProperty extends EagerPropertyBase, IEagerProperty

class InputProperty extends EagerPropertyBase, IInputProperty {
  fun set(dependencies: mutable Dependencies, value: Value): void {
    current = dependencies.getValue(this.path);
    if (native_eq(current, value) != 0) {
      dependencies.set(this.path, this, value);
    }
  }
}

class LazyProperty(function: LazyFunction, path: Path) extends ILazyProperty {
  //
  fun get(
    dependencies: mutable Dependencies,
    param: IParameter,
    optReader: ?Reader = None(),
  ): Value {
    // Register read to update reader
    value = this.getValue(dependencies, param);
    optReader.each(reader -> dependencies.add(this.path, Array[reader]));
    value
  }

  protected fun getValue(
    dependencies: mutable Dependencies,
    param: IParameter,
  ): Value {
    // TODO ASSERT All values are validated at this moment
    key = param.toKey();
    dependencies.getLazyValue(this.path, key) match {
    | Some(v) -> v
    | _ ->
      value = this.function.call(
        dependencies,
        param,
        Some(LazyReader(key, this.path)),
      );
      dependencies.setLazy(this.path, this, value, param);
      value
    }
  }

  fun untrackedCompute(
    dependencies: mutable Dependencies,
    param: IParameter,
  ): Value {
    this.function.call(dependencies, param, None());
  }

  fun getPath(): Path {
    this.path
  }

  fun getTime(dependencies: mutable Dependencies): Tick {
    dependencies.getValueTime(this.path)
  }
}

module end;
