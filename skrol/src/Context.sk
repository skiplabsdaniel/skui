module SKROL;

mutable class Horloge(mutable tick: Tick = Tick(0)) {
  readonly fun get(): Tick {
    this.tick;
  }

  mutable fun next(): void {
    this.!tick = this.tick.next()
  }
}

mutable class Context private (
  scope: mutable ScopeImpl,
  horloge: mutable Horloge,
) {
  static fun create(): mutable this {
    horloge = mutable Horloge();
    scope = mutable ScopeImpl(Path(0), horloge.get);
    mutable Context(scope, horloge);
  }

  mutable fun update(): void {
    this.horloge.next();
    this.scope.update();
  }

  mutable fun input(supplier: Object): IInputProperty {
    this.scope.input(supplier);
  }

  mutable fun lazy(function: LazyFunction): ILazyProperty {
    this.scope.lazy(function);
  }

  mutable fun combine(function: Function): IEagerProperty {
    this.scope.combine(function);
  }

  readonly fun get<T>(property: IEagerProperty, conv: Object ~> T): T {
    conv(this.scope.getObject(property.getPath()))
  }

  readonly fun getLazy<T>(
    property: ILazyProperty,
    param: IParameter,
    conv: Object ~> T,
  ): ?T {
    this.scope.getLazyObject(property.getPath(), param).map(conv)
  }

  readonly fun getTime(property: IEagerProperty): Tick {
    this.scope.getObjectTime(property.getPath())
  }

  readonly fun getLazyTime(property: ILazyProperty, param: IParameter): ?Tick {
    this.scope.getLazyObjectTime(property.getPath(), param)
  }

  mutable fun set<T>(property: IInputProperty, value: Object): void {
    property.set(this.scope, value);
  }
}

module end;
