module SKROL;

base class Categorized

base class Key uses Orderable
base class Category uses Orderable

trait CategorizedToType {
  macro static fun cat(obj: Categorized): this {
    obj match {
    | x @ #ThisClass _ -> x
    }
  }
}

mutable class Context private (
  scope: mutable Scope,
  logger: mutable ILogger,
  mutable tick: Tick = Tick(0),
  mutable globals: SortedMap<Key, Categorized> = SortedMap[],
  mutable streams: SortedMap<IStreamID, IStreamManager> = SortedMap[],
  mutable watchedObjects: SortedMap<Path, List<IWatch>> = SortedMap[],
  mutable outputs: SortedMap<Path, List<Watch>> = SortedMap[],
) {
  //

  readonly fun getGlobal<T: frozen>(key: Key, conv: Categorized ~> T): ?T {
    this.globals.maybeGet(key).map(conv);
  }

  mutable fun setGlobal(key: Key, value: Categorized): void {
    this.!globals = this.globals.set(key, value)
  }

  static fun create(
    logger: mutable ILogger = mutable BufferedLogger(),
  ): mutable this {
    scope = mutable Scope(Path(0), Some(logger));
    mutable Context(scope, logger)
  }

  static fun createForLevel(minLevel: Logger.Level): mutable this {
    static::create(mutable BufferedLogger(Logger.Config{minLevel}))
  }

  mutable fun update(): void {
    this.!tick = this.tick.next();
    tick = this.tick;
    #log (this.logger.debug, () ~> `Enter Context.update n°${tick}`);
    watched = this.scope.update(this.tick);
    watched.each((path, timed) ->
      this.watchedObjects.maybeGet(path).each(elements ->
        elements.each(watch ->
          watch match {
          | w @ Watch _ -> w.apply(this.getObject(path))
          | wc @ WatchChanges _ ->
            scope = this.getObjectScope(path);
            this.getObject(path) match {
            | sf @ StatefullObject _ ->
              wc.apply(sf.changes(timed, scope.getMappable()))
            | sl @ StatelessObject _ -> wc.apply(Change(sl))
            }
          }
        )
      )
    );
    this.outputs.each((path, elements) ->
      elements.each(w -> w.apply(this.getObject(path)))
    );
    #log (this.logger.debug, () ~> `Exit Context.update n°${tick}`);
    this.logger.flush();
  }

  mutable fun input(supplier: Object): IInputProperty {
    this.scope.input(supplier);
  }

  mutable fun lazy(function: LazyFunction): ILazyProperty {
    this.scope.lazy(function);
  }

  mutable fun combine(function: Function): IEagerProperty {
    this.scope.combine(function);
  }

  mutable fun getScope(path: Path): mutable Scope {
    this.scope.getScope(path);
  }

  mutable fun getObjectScope(pPath: Path): mutable Scope {
    path = pPath.optParent.fromSome();
    this.getScope(path);
  }

  mutable fun getObject(pPath: Path): Object {
    path = pPath.optParent.fromSome();
    scope = this.getScope(path);
    scope.getObject(pPath)
  }

  mutable fun get<T>(property: IEagerProperty, conv: Object ~> T): T {
    conv(this.getObject(property.getPath()))
  }

  mutable fun getLazy<T>(
    property: ILazyProperty,
    param: IParameter,
    conv: Object ~> T,
  ): ?T {
    pPath = property.getPath();
    path = pPath.optParent.fromSome();
    scope = this.getScope(path);
    scope.getLazyObject(pPath, param).map(conv)
  }

  mutable fun getTime(property: IEagerProperty): Tick {
    pPath = property.getPath();
    path = pPath.optParent.fromSome();
    scope = this.getScope(path);
    scope.getObjectTime(pPath)
  }

  mutable fun getLazyTime(property: ILazyProperty, param: IParameter): ?Tick {
    pPath = property.getPath();
    scope = this.getObjectScope(pPath);
    scope.getLazyObjectTime(pPath, param)
  }

  mutable fun set<T>(property: IInputProperty, value: Object): void {
    pPath = property.getPath();
    path = pPath.optParent.fromSome();
    scope = this.getScope(path);
    property.set(scope, value);
  }

  mutable fun watch(property: IEagerProperty, watch: IWatch): IClosable {
    pPath = property.getPath();
    this.watchedObjects.maybeGet(pPath) match {
    | Some(values) ->
      this.!watchedObjects = this.watchedObjects.set(
        pPath,
        List.Cons(watch, values),
      )
    | _ ->
      this.!watchedObjects = this.watchedObjects.set(
        pPath,
        List.Cons(watch, List.Nil()),
      );
      scope = this.getObjectScope(pPath);
      scope.watch(pPath.id)
    };
    LamClosable(ctx ~> ctx.unwatch(property, watch))
  }

  mutable fun unwatch(property: IEagerProperty, watch: IWatch): void {
    pPath = property.getPath();
    this.watchedObjects.maybeGet(pPath).each(elements -> {
      cleaned = elements.filter(w -> w != watch);
      if (cleaned.isEmpty()) {
        this.!watchedObjects = this.watchedObjects.remove(pPath);
        scope = this.getObjectScope(pPath);
        scope.unwatch(pPath.id);
      } else {
        this.!watchedObjects = this.watchedObjects.set(pPath, cleaned);
      }
    });
  }

  mutable fun output(property: IEagerProperty, watch: Watch): IClosable {
    pPath = property.getPath();
    this.outputs.maybeGet(pPath) match {
    | Some(values) ->
      this.!outputs = this.outputs.set(pPath, List.Cons(watch, values))
    | _ -> this.!outputs = this.outputs.set(pPath, List.Cons(watch, List.Nil()))
    };
    LamClosable(ctx ~> ctx.unoutput(property, watch))
  }

  mutable fun unoutput(property: IEagerProperty, watch: Watch): void {
    pPath = property.getPath();
    this.outputs.maybeGet(pPath).each(elements -> {
      cleaned = elements.filter(w -> w != watch);
      if (cleaned.isEmpty()) {
        this.!outputs = this.outputs.remove(pPath);
      } else {
        this.!outputs = this.outputs.set(pPath, cleaned);
      }
    });
  }

  readonly fun chill(): Context {
    Context(
      this.scope.chill(),
      this.logger.chill(),
      this.tick,
      this.globals,
      this.streams,
    )
  }

  readonly fun clone(): mutable Context {
    logger = this.logger.clone();
    mutable Context(
      this.scope.clone(logger),
      logger,
      this.tick,
      this.globals,
      this.streams,
    )
  }

  mutable fun read(id: IStreamID, manager: IStreamManager): void {
    this.!streams = this.streams.set(id, manager);
    readStream(id.toJSON(), manageNextChunck);
  }

  mutable fun manageNextChunck(
    id: IStreamID,
    chunk: Array<UInt8>,
    progress: Float,
    optError: ?JSON.Value,
  ): Bool {
    this.streams.maybeGet(id) match {
    | Some(manager) ->
      optError match {
      | Some(e) if (!(e is JSON.Null _)) ->
        manager.error(this, e);
        false
      | _ ->
        manager.manage(this, chunk, progress) match {
        | Some(nm) ->
          this.!streams = this.streams.set(id, nm);
          true
        | _ -> false
        }
      }
    | _ -> false
    }
  }
}

module end;
