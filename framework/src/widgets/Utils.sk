module Ui;

fun buildTooltip(
  context: mutable SKStore.Context,
  path: Ui.Path,
  ttGetter: Getter<?Text>,
): ?FWK.SourcedWidget {
  ttGetter(context).map(tt ->
    FWK.SourcedWidget(Some(path), (ctx, _root) ~>
      Some(
        Ui.Tooltip::create(
          ctx,
          path.makeChild("tooltip"),
          UiTooltip.LamController{text => _ctx ~> tt},
        ),
      )
    )
  )
}

base class Timed(tick: SKStore.Tick) extends SKStore.File {
  children =
  | TimedBool(value: Bool)
  | TimedString(value: String)
  | TimedInt(value: Int)
  | TimedRange(value: Range)
  | TimedStatus(value: Status)
}

fun getTextInfo(
  context: mutable SKStore.Context,
  textSupport: Ui.TextSupport,
  faceId: Font.FaceID,
  str: String,
): (String, Geometry.Size, Font.FaceID) {
  lineSpacing = context.getThemeThickness(UiTheme.LineSpacing());
  size = textSupport.getLinesSize(context, str, None(), faceId, _lh ->
    lineSpacing.toFloat()
  );
  (str, size, faceId)
}

fun drawConstrainedText(
  context: mutable SKStore.Context,
  support: Ui.DrawableSupport,
  textSupport: Ui.TextSupport,
  text: String,
  bounds: Geometry.Rect,
  color: .Color,
  faceId: Font.FaceID,
  drawables: mutable Vector<Ui.Drawable>,
  hAlignment: Text.FixedAlign = Text.Left(),
  vAlignment: Text.VAlign = Text.Middle(),
): void {
  lineSpacing = context.getThemeThickness(UiTheme.LineSpacing());
  lines = textSupport.getLines(
    context,
    text,
    bounds.size(),
    Text.Style{
      faceId,
      lineSpacing => Text.ConstLineSpacing(lineSpacing.toFloat()),
      vAlignment,
      hAlignment,
    },
  );
  lines.each(l ->
    l.fillDrawables(context, support, bounds.topLeft(), color, drawables)
  )
}

fun themeShadow(
  context: mutable SKStore.Context,
  support: DrawableSupport,
  offset: Geometry.Offset,
  size: Geometry.Size,
  radius: Float,
): Array<Ui.Drawable> {
  // The theme thickness is the blur radius (three standard deviations);
  // the shadow is cast down, as by a light from above, and a little
  // smaller than the element so that it does not show on top.
  color = context.getThemeColor(UiTheme.Shadow());
  blur = context.getThemeThickness(UiTheme.Shadow()).toFloat();
  Array[
    support.boxShadow(
      offset,
      size,
      blur / 3.0,
      color,
      radius,
      Geometry.Offset(0.0, blur / 5.0),
      -blur / 10.0,
    ),
  ]
}

module end;
