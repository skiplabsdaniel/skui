module Ui;

class ShadowData(scales: Array<Float>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ ShadowData _ -> x
    | _ -> invariant_violation("Must be Ui.ShadowData")
    }
  }
}

/**
 * A shadow below the decorated widget, as CSS box-shadow: the widget's
 * rectangle with rounded corners, moved by offset, grown by spread, blurred
 * and drawn in the shadow color.
 */
class Shadow{
  /**
   * The blur radius: the shadow fades out over about this distance (it is
   * three times the standard deviation of the gaussian blur).
   */
  radius: Int = 0,
  /**
   * Color that the shadow will be drawn with.
   */
  shadow: .Color = Colors.black(),
  padding: Geometry.InsetsGeometry = Geometry.Insets::all(0.0),
  optFill: ?Ui.Paint = None(),
  /**
   * The radius of the corners of the widget's rectangle.
   */
  optCornerRadius: ?Ui.Dim = None(),
  /**
   * The offset of the shadow, usually down to suggest a light from above.
   */
  offset: Geometry.Offset = Geometry.Offset::zero,
  /**
   * How much the shadow grows (or shrinks, if negative) on each side.
   */
  spread: Float = 0.0,
  /**
   * Hides the shadow below the widget, when its background is translucent.
   */
  clip: Bool = false,
} extends Decoration {
  fun getPadding(direction: Ui.HorizontalDirection): Geometry.Insets {
    Geometry.resolveInsest(this.padding, direction);
  }

  fun fillDrawables(
    _context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    offset: Geometry.Offset,
    size: Geometry.Size,
    _direction: Ui.HorizontalDirection,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    corner = this.optCornerRadius match {
    | Some(r @ RelativeToSize _) -> r.pixels(size.width, size.height)
    | Some(f @ FixedSize _) -> f.pixels()
    | None() -> 0.0
    };
    drawables.push(
      support.boxShadow(
        offset,
        size,
        this.radius.toFloat() / 3.0,
        this.shadow,
        corner,
        this.offset,
        this.spread,
        this.clip,
      ),
    );
    this.optFill.each(fill ->
      drawables.push(
        support.boxShadow(
          offset,
          size,
          this.radius.toFloat() / 30.0,
          fill,
          corner,
        ),
      )
    )
  }
}

fun shadow(
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  scalesX: Array<Float>,
  scalesY: Array<Float>,
  radius: Int,
): Float {
  midX = width / 2;
  midY = height / 2;
  radiusX = Math.min(midX, radius);
  radiusY = Math.min(midY, radius);
  (strX, strY) = if (x <= midX && y <= midY) {
    (scalesX[midX - radiusX + x], scalesY[midY - radiusY + y])
  } else if (x <= midX && y > midY) {
    (scalesX[midX - radiusX + x], scalesY[midY - radiusY + (height - y)])
  } else if (x > midX && y <= midY) {
    (scalesX[midX - radiusX + (width - x)], scalesY[midY - radiusY + y])
  } else {
    (
      scalesX[midX - radiusX + (width - x)],
      scalesY[midY - radiusY + (height - y)],
    )
  };
  Math.clamp(strX * strY, 0.0, 1.0);
}

module end;
