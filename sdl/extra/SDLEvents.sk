module SKUISDL;

private const PrimaryButton: Int = 1;
private const MiddleButton: Int = 2;
private const SecondaryButton: Int = 3;
private const WheelUpButton: Int = 4;
private const WheelDownButton: Int = 5;

@cpp_extern("SKIP_SKUISDL_launch")
native fun launch(wId: Int, title: String, framePerSecond: Int): void;

@debug
@cpp_extern("SKIP_SKUISDL_sendMessage")
native fun sendMessage(
  wId: Int,
  message: String,
  asyncMode: Bool,
  delay: UInt32,
): void;

@cpp_export("SKIP_SKUISDL_windowInitialized")
fun windowInitialized(wId: Int): void {
  pos = SKStore.newSkuiObstack();
  SKStore.Context::withoutGc(context ~> {
    context.setGlobal(
      "SKUIMessage.Sender",
      SKUIMessage.Sender((_ctx, message, asyncMode, delay) ~> {
        sendMessage(wId, message, asyncMode, delay);
        true
      }),
    );
    context.checkPendingMessages();
    context.updateIfRoot();
  });
  SKStore.destroySkuiObstack(pos);
}

// x and y are in logical pixels.
@cpp_export("SKIP_SKUISDL_manageMouseLocation")
private fun manageMouseLocation(_wId: Int, x: Float, y: Float): void {
  pos = SKStore.newSkuiObstack();
  SKStore.Context::withoutGc(context ~> {
    FWKMouse.execute(
      context,
      FWKMouse.Location(
        Geometry.Offset(x, y),
        context.systemTimeStamp(),
        context.getTick(),
      ),
    );
    context.updateIfRoot();
  });
  SKStore.destroySkuiObstack(pos);
}

@cpp_export("SKIP_SKUISDL_manageMouseButton")
private fun manageMouseButton(_wId: Int, button: Int, pressed: Bool): void {
  pos = SKStore.newSkuiObstack();
  SKStore.Context::withoutGc(context ~> {
    FWKMouse.execute(
      context,
      FWKMouse.Button(
        button match {
        | WheelUpButton -> FWK.WheelUp()
        | WheelDownButton -> FWK.WheelDown()
        | PrimaryButton -> FWK.Primary()
        | MiddleButton -> FWK.Middle()
        | SecondaryButton -> FWK.Secondary()
        | _ -> FWK.Unknown(button)
        },
        pressed,
        context.systemTimeStamp(),
        context.getTick(),
      ),
    );
    context.updateIfRoot();
  });
  SKStore.destroySkuiObstack(pos);
}

// w and h are in logical pixels, r is the pixel ratio in hundredths.
@cpp_export("SKIP_SKUISDL_manageResize")
fun manageResize(wId: Int, w: Int, h: Int, r: Int): void {
  pos = SKStore.newSkuiObstack();
  SKStore.Context::withoutGc(context ~> {
    context.getGlobal("FWK.Window.Size").map(FWK.Sizer::type).each(sizer ->
      sizer.value(context, wId, w, h, r.toFloat() / 100.0)
    );
    context.updateIfRoot();
  });
  SKStore.destroySkuiObstack(pos);
}

// code is the web code of the physical key (KeyboardEvent.code), symbol its
// web name in the current layout, and text the text it types ("" if none).
@cpp_export("SKIP_SKUISDL_manageKeyPressed")
private fun manageKeyPressed(
  _wId: Int,
  code: String,
  symbol: String,
  text: String,
  capsLock: Bool,
  numLock: Bool,
): void {
  pos = SKStore.newSkuiObstack();
  SKStore.Context::withoutGc(context ~> {
    FWKKeys.execute(
      context,
      FWKKeys.KeyPressed(
        code,
        symbol,
        if (text.isEmpty()) None() else Some(text),
        UiEvent.Locks(
          Some(UiEvent.Strict(capsLock)),
          Some(UiEvent.Strict(numLock)),
          None(),
        ),
        context.systemTimeStamp(),
        context.getTick(),
      ),
    );
    context.updateIfRoot()
  });
  SKStore.destroySkuiObstack(pos);
}

@cpp_export("SKIP_SKUISDL_manageKeyReleased")
fun manageKeyReleased(_wId: Int, code: String): void {
  pos = SKStore.newSkuiObstack();
  SKStore.Context::withoutGc(context ~> {
    FWKKeys.execute(
      context,
      FWKKeys.KeyReleased(code, context.systemTimeStamp(), context.getTick()),
    );
    context.updateIfRoot();
  });
  SKStore.destroySkuiObstack(pos);
}

// Text typed without a key of its own (input method, composed character):
// sent as a press and release of a key that types it.
@cpp_export("SKIP_SKUISDL_manageTextInput")
fun manageTextInput(wId: Int, text: String): void {
  manageKeyPressed(wId, "Unidentified", "Unidentified", text, false, false);
  manageKeyReleased(wId, "Unidentified");
}

@cpp_export("SKIP_SKUISDL_manageRequestClose")
fun manageRequestClose(wId: Int): Bool {
  pos = SKStore.newSkuiObstack();
  res = SKStore.Context::withoutGc(context ~>
    SystemProperties.quit(context, wId)
  );
  SKStore.destroySkuiObstack(pos);
  res;
}

module end;
