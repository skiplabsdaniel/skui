module SKUIMain;

fun display(
  optOutput: ?String,
  optError: ?String = None(),
  _html: Bool = false,
): void {
  optError.each(print_error);
  optOutput.each(print_string);
}

fun init(wId: Int, title: String, args: Cli.ParseResults): void {
  fps = args.getString("fps").toIntOption().default(60);
  SKUISDL.launch(wId, title, fps);
}

fun complete(command: Cli.Command): Cli.Command {
  command.arg(
    Cli.Arg::string("fps")
      .about("The frame per second refresh rate")
      .default("60"),
  )
}

module end;
