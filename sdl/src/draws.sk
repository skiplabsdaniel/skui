module SkuiSdl;

fun initDrawables(ctx: GL.Ctx, drawables: Vector<GLDrawable>): Context {
  initializer = mutable GLProgram.Initializer();
  drawablesUsage = drawables.map(d -> (d, d.prepare(initializer)));
  programs = initializer.programs.map((_, v) -> v(ctx));
  buffers = initializer.buffers.map((_, v) -> v(ctx));
  arrays = initializer.arrays.map((_, v) -> v(ctx));
  supplier = GLProgram.Supplier(programs.maybeGet);
  handles = mutable Vector<Ui.Handle>[];

  drawablesUsage.each(tuple -> {
    (drawable, used) = tuple;
    SKUIGL.DrawableSupport::toHandles(
      ctx,
      (used, drawable),
      buffers.maybeGet,
      arrId ->
        arrays.maybeGet(arrId).flatMap(array -> {
          buffers.maybeGet(array.buffer.value).map(buffer ->
            GLProgram.ArrayInfo(array, buffer)
          )
        }),
      supplier,
      handles,
    )
  });
  Context(handles.chill());
}

fun rounded(ctx: GL.Ctx, width: Int, height: Int): Context {
  initDrawables(
    ctx,
    Vector[
      GLDrawable.RoundedRectangle(
        .Colors.beige(),
        height.toFloat() / 10.0,
        2.0,
        Some(Ui.Border(.Colors.black(), 5.0)),
        Geometry.Rect::fromOffsetSize(
          Geometry.Offset(10.0, 10.0),
          Geometry.Size(width.toFloat() - 20.0, height.toFloat() - 20.0),
        ),
      ),
    ],
  )
}

fun rectangle(ctx: GL.Ctx, width: Int, height: Int): Context {
  initDrawables(
    ctx,
    Vector[
      GLDrawable.rectangle(
        Geometry.Offset(10.0, 10.0),
        Geometry.Size(width.toFloat() - 20.0, height.toFloat() - 20.0),
        .Colors.firebrick(),
      ),
    ],
  )
}

fun program(
  ctx: GL.Ctx,
  width: Int,
  height: Int,
  entity: GLSL.Entity,
  config: GLSL.Config = GLSL.Config{
    lights => 1,
    colors => 1,
    shininesses => 1,
    textures => 0,
  },
): Context {
  program = GLSL.Scene(entity, config);
  wood = SKIP_SKUISDLRes.woodImage();
  steel = SKIP_SKUISDLRes.steelImage();
  woodTex = GLTexture.Image(Some(wood.data), true, wood.width, wood.height);
  steelTex = GLTexture.Image(Some(steel.data), true, steel.width, steel.height);
  constValue: GLSL.Value -> GL.Ctx ~> ?(
    Geometry.Rect,
    Geometry.Size,
  ) ~> GLSL.Value = v -> (_ctx) ~> Some((_bs, _w) ~> v);

  scaledValue: GLSL.VVec -> GL.Ctx ~> ?(
    Geometry.Rect,
    Geometry.Size,
  ) ~> GLSL.Value = v ->
    (_ctx) ~>
      Some((bs, _w) ~>
        GLSL.VVec[v.x() / bs.width(), v.y() / bs.height(), v.z()]
      );

  ellipsoide = (_ctx) ~>
    Some((bs, _w) ~> {
      side = Math.max(bs.width(), bs.height());
      GLSL.VStruct(
        SortedMap[
          "center" => GLSL.VVec::v3(0.5, 0.5, 0.0),
          "radius" => GLSL.VVec::v3(
            0.5 * bs.width() / side,
            0.5 * bs.height() / side,
            0.5,
          ),
        ],
      )
    });

  textures = (ctx) ~> {
    t1 = woodTex.asTexture(ctx);
    t2 = steelTex.asTexture(ctx);
    Some((_bs, _w) ~> GLSL.VTextures[t2, t1]);
  };

  texture_sizes = (_ctx) ~> {
    Some((bs, _w) ~> {
      side = Math.max(bs.width(), bs.height());
      GLSL.VArray[
        GLSL.VVec::v2(
          steelTex.width.toFloat() / side,
          steelTex.height.toFloat() / side,
        ),
        GLSL.VVec::v2(
          woodTex.width.toFloat() / side,
          woodTex.height.toFloat() / side,
        ),
        GLSL.VVec::v2(0.0, 0.0),
        GLSL.VVec::v2(0.0, 0.0),
        GLSL.VVec::v2(0.0, 0.0),
        GLSL.VVec::v2(0.0, 0.0),
      ]
    })
  };

  initDrawables(
    ctx,
    Vector[
      GLSL.Drawable(
        program,
        Map[
          "u_filter" => constValue(GLSL.VVec::v1(0.0)),
          "u_shininesses" => constValue(GLSL.VVec[7.0, 10.0]),
          "u_textures" => textures,
          "u_texture_sizes" => texture_sizes,
          "u_smoothing" => (_ctx) ~>
            Some((bds, _) ~>
              GLSL.VVec::v1(4.0 / Math.min(bds.width(), bds.height()))
            ),
          "u_camera" => constValue(GLSL.VVec::v3(0.5, 0.5, 2.0)),
          "u_ambient" => constValue(GLSL.rgb(.Colors.transparent())),
          "u_colors" => constValue(
            GLSL.VArray[
              GLSL.rgba(.Color::rgbaInt(52, 152, 219)),
              GLSL.rgba(.Colors.yellow()),
              GLSL.rgba(.Colors.firebrick()),
            ],
          ),
          "u_start_end" => constValue(GLSL.VVec[0.0, 0.0, 1.0, 0.0]),
          "u_offsets" => constValue(GLSL.VVec[0.1, 0.5, 0.9]),
          "u_ellipsoide" => ellipsoide,
          "u_ligthcount" => constValue(GLSL.VVec[1.0]),
          "u_radius" => scaledValue(GLSL.VVec[12.0, 12.0, 0.8]),
          "u_lights" => constValue(
            GLSL.VArray[
              GLSL.VStruct[
                "color" => GLSL.rgb(.Colors.white()),
                "point" => GLSL.VVec::v1(1.0),
                "value" => GLSL.VVec::v3(0.5, -0.5, 1.5),
              ],
              GLSL.VStruct[
                "color" => GLSL.rgb(.Colors.green()),
                "point" => GLSL.VVec::v1(0.0),
                "value" => GLSL.VVec::v3(0.0, 0.5, 0.5) -
                  GLSL.VVec::v3(0.5, 0.5, 0.0),
              ],
              GLSL.VStruct[
                "color" => GLSL.rgb(.Colors.pink()),
                "point" => GLSL.VVec::v1(1.0),
                "value" => GLSL.VVec::v3(0.5, 1.5, 0.05),
              ],
            ],
          ),
        ],
        None(),
        //Some(GLSL.es300()),
        GLSL.High(),
        Geometry.Rect::fromOffsetSize(
          Geometry.Offset(10.0, 10.0),
          Geometry.Size(width.toFloat() / 2.0, height.toFloat() / 3.0),
        ),
      ),
    ],
  )
}

fun ellipsoide(ctx: GL.Ctx, width: Int, height: Int): Context {
  program(ctx, width, height, GLSL.Ellipsoide());
}

fun button1(ctx: GL.Ctx, width: Int, height: Int): Context {
  program(ctx, width, height, GLSL.Button1(Some(GLSL.Button1Material())));
}

fun tex_button1(ctx: GL.Ctx, width: Int, height: Int): Context {
  program(
    ctx,
    width,
    height,
    GLSL.Button1(Some(GLSL.TexturedButton1Material())),
    GLSL.Config{lights => 3, colors => 1, shininesses => 2, textures => 2},
  );
}

// Multi-light + texture showcase: compares 1 white light vs 3 colored lights
// (white point + green directional + pink point) on ellipsoid, metallic/wood
// textured button, and clipped rounded panel using GLRender.DrawList.
fun lights(ctx: GL.Ctx, width: Int, height: Int): Context {
  wood = SKIP_SKUISDLRes.woodImage();
  steel = SKIP_SKUISDLRes.steelImage();
  woodTex = GLTexture.Image(Some(wood.data), true, wood.width, wood.height);
  steelTex = GLTexture.Image(Some(steel.data), true, steel.width, steel.height);
  cval: GLSL.Value -> GL.Ctx ~> ?(
    Geometry.Rect,
    Geometry.Size,
  ) ~> GLSL.Value = v -> (_ctx) ~> Some((_bs, _w) ~> v);
  scaled: GLSL.VVec -> GL.Ctx ~> ?(
    Geometry.Rect,
    Geometry.Size,
  ) ~> GLSL.Value = v ->
    (_ctx) ~>
      Some((bs, _w) ~>
        GLSL.VVec[v.x() / bs.width(), v.y() / bs.height(), v.z()]
      );
  ellipsoide = (_ctx: GL.Ctx) ~>
    Some((bs: Geometry.Rect, _w: Geometry.Size) ~> {
      side = Math.max(bs.width(), bs.height());
      GLSL.VStruct(
        SortedMap[
          "center" => GLSL.VVec::v3(0.5, 0.5, 0.0),
          "radius" => GLSL.VVec::v3(
            0.5 * bs.width() / side,
            0.5 * bs.height() / side,
            0.5,
          ),
        ],
      )
    });
  textures = (c: GL.Ctx) ~> {
    t1 = woodTex.asTexture(c);
    t2 = steelTex.asTexture(c);
    Some((_bs: Geometry.Rect, _w: Geometry.Size) ~> GLSL.VTextures[t2, t1])
  };
  textureSizes = (_ctx: GL.Ctx) ~>
    Some((bs: Geometry.Rect, _w: Geometry.Size) ~> {
      side = Math.max(bs.width(), bs.height());
      GLSL.VArray[
        GLSL.VVec::v2(
          steelTex.width.toFloat() / side,
          steelTex.height.toFloat() / side,
        ),
        GLSL.VVec::v2(
          woodTex.width.toFloat() / side,
          woodTex.height.toFloat() / side,
        ),
      ]
    });
  makeValues = (lightCount: Float, baseColor: .Color) ->
    Map[
      "u_filter" => cval(GLSL.VVec::v1(0.0)),
      "u_shininesses" => cval(GLSL.VVec[12.0, 20.0]),
      "u_textures" => textures,
      "u_texture_sizes" => textureSizes,
      "u_smoothing" => (_ctx) ~>
        Some((bds, _) ~>
          GLSL.VVec::v1(4.0 / Math.min(bds.width(), bds.height()))
        ),
      "u_camera" => cval(GLSL.VVec::v3(0.5, 0.5, 2.0)),
      "u_ambient" => cval(GLSL.rgb(.Color::rgbaInt(25, 25, 30))),
      "u_colors" => cval(
        GLSL.VArray[
          GLSL.rgba(baseColor),
          GLSL.rgba(.Colors.gold()),
          GLSL.rgba(.Colors.firebrick()),
        ],
      ),
      "u_ellipsoide" => ellipsoide,
      "u_ligthcount" => cval(GLSL.VVec[lightCount]),
      "u_radius" => scaled(GLSL.VVec[14.0, 14.0, 0.8]),
      "u_lights" => cval(
        GLSL.VArray[
          GLSL.VStruct[
            "color" => GLSL.rgb(.Colors.white()),
            "point" => GLSL.VVec::v1(1.0),
            "value" => GLSL.VVec::v3(0.2, -0.3, 1.4),
          ],
          GLSL.VStruct[
            "color" => GLSL.rgb(.Color::rgbaInt(80, 240, 120)),
            "point" => GLSL.VVec::v1(0.0),
            "value" => GLSL.VVec::v3(-0.6, 0.2, 0.6),
          ],
          GLSL.VStruct[
            "color" => GLSL.rgb(.Color::rgbaInt(255, 90, 170)),
            "point" => GLSL.VVec::v1(1.0),
            "value" => GLSL.VVec::v3(0.9, 1.2, 0.4),
          ],
        ],
      ),
    ];

  ellScene = GLSL.Scene(
    GLSL.Ellipsoide(),
    GLSL.Config{lights => 3, colors => 1, shininesses => 1, textures => 0},
  );
  texScene = GLSL.Scene(
    GLSL.Button1(Some(GLSL.TexturedButton1Material())),
    GLSL.Config{lights => 3, colors => 1, shininesses => 2, textures => 2},
  );
  bg = GLDrawable.rectangle(
    Geometry.Offset(0.0, 0.0),
    Geometry.Size(width.toFloat(), height.toFloat()),
    .Color::rgbaInt(24, 26, 32),
  );
  // Top-left: single white light on ellipsoid.
  ell1 = GLSL.Drawable(
    ellScene,
    makeValues(1.0, .Color::rgbaInt(70, 150, 230)),
    None(),
    GLSL.High(),
    Geometry.Rect::fromLTWH(40.0, 40.0, 320.0, 220.0),
  );
  // Top-right: 3 colored lights on ellipsoid.
  ell3 = GLSL.Drawable(
    ellScene,
    makeValues(3.0, .Color::rgbaInt(210, 215, 225)),
    None(),
    GLSL.High(),
    Geometry.Rect::fromLTWH(420.0, 40.0, 320.0, 220.0),
  );
  // Bottom-left: textured steel/wood button with 1 white light.
  tex1 = GLSL.Drawable(
    texScene,
    makeValues(1.0, .Colors.white()),
    None(),
    GLSL.High(),
    Geometry.Rect::fromLTWH(40.0, 310.0, 320.0, 220.0),
  );
  // Bottom-right: textured steel/wood button with 3 colored lights + rounded shader clip.
  tex3 = GLSL.Drawable(
    texScene,
    makeValues(3.0, .Colors.white()),
    None(),
    GLSL.High(),
    Geometry.Rect::fromLTWH(420.0, 310.0, 320.0, 220.0),
  );
  list = GLRender.DrawList::prepare(
    ctx,
    Array[
      GLRender.Item(ell1, 10, 0.1, None()),
      GLRender.Item(ell3, 10, 0.1, None()),
      GLRender.Item(tex1, 10, 0.1, None()),
      GLRender.Item(
        tex3,
        10,
        0.1,
        Some(
          GLRender.Clip(
            Geometry.Rect::fromLTWH(440.0, 330.0, 280.0, 180.0),
            40.0,
          ),
        ),
      ),
      // Background submitted last on purpose to verify depth sorting (order 0).
      GLRender.Item(bg, 0, 0.9, None()),
    ],
  );
  Context(
    Vector[
      Ui.LambdaHandle((_shift, window, height, ratio, frame) ~>
        list.draw(ctx, window.width(), height, ratio, frame)
      ),
    ],
  )
}

module end;
