module SkuiSdl;

class Context(handles: Vector<Ui.Handle>)

class Env(fn: (GL.Ctx, Int, Int) ~> Context)

fun main(): void {
  available = mutable Vector[
    ("rounded", SkuiSdl.rounded),
    ("rectangle", SkuiSdl.rectangle),
    ("ellipsoide", SkuiSdl.ellipsoide),
    ("button1", SkuiSdl.button1),
    ("tex_button1", SkuiSdl.tex_button1),
    ("gradients", SkuiSdl.gradients),
    ("shapes", SkuiSdl.shapes),
    ("animation", SkuiSdl.animation),
    ("text", SkuiSdl.text),
    ("shadows", SkuiSdl.shadows),
  ];
  perform(available);
}

fun perform(
  available: readonly Vector<(String, (GL.Ctx, Int, Int) ~> Context)>,
): void {
  command = Cli.Command("skuisdl")
    .about("Skip UI's GL Shader Viewer")
    .arg(
      Cli.Arg::bool("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .help();
  available.each(v -> {
    (name, _) = v;
    !command = command.subcommand(
      Cli.Command(name).about(`Show ${name} shader example`),
    )
  });
  args = command.parseArgs();
  if (args.getBool("version")) {
    git_commit = #env ("GIT_COMMIT_HASH");
    print_string(`skuisdl (${git_commit})`)
  } else {
    args.maybeGetSubcommand() match {
    | Some(subcmd) ->
      available.filter(v -> v.i0 == subcmd).maybeGet(0) match {
      | Some((_, fn)) ->
        run(Env(fn), 0, 800, 600, "Skip UI's GL Shader Viewer", 60)
      | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
      }
    | None() -> print_string(Cli.usage(args.cmd, true))
    }
  }
}

@cpp_extern
native fun run(
  env: Env,
  wId: Int,
  width: Int,
  height: Int,
  title: String,
  framePerSecond: Int,
): void;

@cpp_export("SKIP_SkuiSdl_performFrame")
fun performFrame(
  env: Env,
  cid: Int,
  optContext: ?Context,
  width: Int,
  height: Int,
  ratio: UInt32,
  count: UInt32,
): Context {
  pos = SKStore.newSkuiObstack();
  fRatio = ratio.toFloat() / 100.0;
  ctx = GL.Ctx(UInt32::truncate(cid));
  ctx.bindMainFrameBuffer();
  ctx.enableBlend();
  ctx.straitAlphaBlending();
  // width and height are in logical pixels.
  ctx.viewport(
    int32(0),
    int32(0),
    uint32((width.toFloat() * fRatio).toInt()),
    uint32((height.toFloat() * fRatio).toInt()),
  );
  ctx.clearColor(1.0, 1.0, 1.0, 1.0);
  ctx.clear();
  context = optContext match {
  | Some(context) -> context
  | _ -> env.fn(ctx, width, height)
  };
  shift = Ui.Shift(0, 0);
  window = Geometry.Rectangle(
    Geometry.Point(0, 0),
    Geometry.Point(width, height),
  );
  context.handles.each(a ->
    a.draw(shift, window, height, fRatio, count.toInt())
  );
  ctx.flush();
  SKStore.destroySkuiObstackWithValue(pos, context);
}

module end;
