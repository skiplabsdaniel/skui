module SkuiSdlBuild;

// SDL 3, installed in SKUI_SDL3_DIR (default /opt/sdl3, see
// views/docker/Dockerfile).
fun sdlDir(): String {
  Environ.varOpt("SKUI_SDL3_DIR").default("/opt/sdl3")
}

@skui_build__source_dirs
fun source_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) Array["native/src"] else Array[]
}

@skui_build__include_dirs
fun include_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array[
      "native/src/includes",
      "../opengl/native/src/includes",
      "../base/native/src/includes",
      `${sdlDir()}/include`,
    ]
  } else {
    Array[]
  }
}

@skui_build__links
fun links(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) {
    lib = `${sdlDir()}/lib`;
    Array[`-L${lib}`, `-Wl,-rpath,${lib}`, "-lSDL3"]
  } else {
    Array[]
  }
}

@skui_build__resources
fun resources(_env: SkuiBuild.Env): Array<String> {
  Array["resources/textures/steel.rgba", "resources/textures/wood.rgba"]
}

module end;

@debug
fun main(): void {
  SkuiBuild.build("skuisdl") match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
