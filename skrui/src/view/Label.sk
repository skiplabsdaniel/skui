module alias O = SKROL;

module SKUILabel;

class State{layout: O.TLazyProperty<SKUI.INode, SKUI.IConstraints>}

module end;

module SKUI;

class Label{
  disabled: O.TEagerProperty<Bool>,
  text: O.TEagerProperty<Text>,
  icon: O.TEagerProperty<?SKUI.IIcon>,
  tooltip: O.TEagerProperty<?Text>,
  font: O.TEagerProperty<SKUIFont.Font>,
  config: O.TEagerProperty<?SKUI.IConfiguration>,
  optState: ?SKUILabel.State = None(),
} extends O.StatefullObject {
  //
  fun getReference(): this {
    Label{
      disabled => this.disabled,
      text => this.text,
      icon => this.icon,
      tooltip => this.tooltip,
      font => this.font,
      config => this.config,
      optState => None(),
    }
  }

  fun changes(_old: O.TimedObject): O.IChanges {
    invariant_violation("StatefullObject.changes new namaged in SKUI.Label.")
  }

  fun init(_scope: mutable O.IScope, _optCurrent: ?O.Object = None()): this {
    this
  }
}

module end;
