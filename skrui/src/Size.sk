base class LayoutSize extends ISize

base class FixedSize extends ValuedSize, LayoutSize {
  fun pixels(): Float;

  fun scale(scale: Float): this {
    static(this.value * scale)
  }

  overridable fun points(): Float {
    9.0 * this.pixels() / 12.0;
  }

  overridable fun inches(): Float {
    this.pixels() / 96.0;
  }

  overridable fun centimeters(): Float {
    this.inches() * 2.54;
  }

  overridable fun millimeters(): Float {
    this.centimeters() * 10.0;
  }

  overridable fun picas(): Float {
    this.points() / 12.0;
  }
}

class Px extends FixedSize {
  fun pixels(): Float {
    this.value;
  }
  protected fun unit(): String {
    "px"
  }
}

class Pt extends FixedSize {
  fun pixels(): Float {
    12.0 * this.value / 9.0;
  }
  fun pt(): Float {
    this.value;
  }
  protected fun unit(): String {
    "pt"
  }
}

class Inch extends FixedSize {
  fun pixels(): Float {
    96.0 * this.value;
  }
  fun inches(): Float {
    this.value;
  }
  protected fun unit(): String {
    "in"
  }
}

class Pica extends FixedSize {
  fun pixels(): Float {
    16.0 * this.value;
  }
  fun pt(): Float {
    12.0 * this.value;
  }
  fun pc(): Float {
    this.value;
  }
  protected fun unit(): String {
    "pc"
  }
}

class Centimeter extends FixedSize {
  // 1 in = 96px
  // 1 in	= 96px = 2.54 cm
  fun pixels(): Float {
    this.value * 96.0 / 2.54;
  }

  fun centimeters(): Float {
    this.value;
  }

  protected fun unit(): String {
    "cm"
  }
}

class Millimeter extends FixedSize {
  fun pixels(): Float {
    this.centimeters() * 96.0 / 2.54;
  }

  fun centimeters(): Float {
    this.value / 10.0;
  }

  fun millimeters(): Float {
    this.value;
  }

  protected fun unit(): String {
    "mm"
  }
}

base class RelativeSize extends LayoutSize {
  fun compute(size: FixedSize): FixedSize;
}

class ScaledSize(scale: Float) extends RelativeSize {
  //
  fun compute(size: FixedSize): FixedSize {
    size.scale(this.scale)
  }
}

module end;
