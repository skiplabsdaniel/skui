module alias O = SKROL;

module SKUIFont;

base class Style uses Orderable

class Text(value: String, font: Font) extends O.IParameter
class Displayed(
  value: String,
  style: Style,
  pxRange: Int = 8,
) extends O.IParameter
class Glyph(c: Char, font: Font) extends O.IParameter

class Support() extends O.StatefullObject uses O.ObjectToTyped {
  //
  fun getReference(): this {
    Support()
  }

  fun init(_scope: mutable O.IScope): this {
    // Font
    this
  }

  fun update(_scope: mutable O.IScope, _new: O.Object): Result<this, void> {
    Failure(void)
  }

  fun changes(_old: O.TimedObject, _mappable: mutable O.IMappable): O.IChanges {
    O.Change(this.getReference())
  }

  fun delete(_scope: mutable O.IScope): void {
    void
  }
}
