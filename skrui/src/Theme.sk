module alias O = SKROL;

module SKUITheme;

class Category() extends O.Category

class Changes(
  colors: SortedMap<String, Color>,
  fonts: SortedMap<String, SKUIFont.Font>,
) extends O.IChanges

class Properties{fonts: Fonts = Fonts{}, colors: Colors = Colors{}} {
  //
  fun changes(other: Properties): Changes {
    Changes(this.colors.changes(other.colors), this.fonts.changes(other.fonts))
  }
}

class State{colors: ColorsState, fonts: FontsState} {
  static fun fromProperties(
    scope: mutable O.IScope,
    properties: Properties,
  ): this {
    static{
      colors => ColorsState::fromColors(scope, properties.colors),
      fonts => FontsState::fromFonts(scope, properties.fonts),
    }
  }

  fun update(updater: mutable O.IUpdater, properties: Properties): void {
    this.colors.update(updater, properties.colors);
    this.fonts.update(updater, properties.fonts);
  }

  fun getColor(
    dependencies: mutable O.Dependencies,
    color: TColor,
    optReader: ?O.Reader = None(),
  ): Color {
    this.colors.getColor(dependencies, color, optReader)
  }

  fun getFont(
    dependencies: mutable O.Dependencies,
    color: TFont,
    optReader: ?O.Reader = None(),
  ): SKUIFont.Font {
    this.fonts.getFont(dependencies, color, optReader)
  }

  fun delete(scope: mutable O.IScope): void {
    this.colors.delete(scope);
    this.fonts.delete(scope);
  }
}

class Theme{
  properties: Properties,
  optState: ?State = None(),
} extends O.StatefullObject uses O.ObjectToTyped {
  //
  fun getReference(): this {
    Theme{properties => this.properties}
  }

  fun init(scope: mutable O.IScope): this {
    // Font
    !this.optState = Some(State::fromProperties(scope, this.properties));
    this
  }

  fun update(scope: mutable O.IScope, new: O.Object): Result<this, void> {
    new match {
    | theme @ Theme _ ->
      this.optState match {
      | Some(state) ->
        state.update(scope, theme.properties);
        Success(this)
      | _ -> Failure(void)
      }
    | _ -> Failure(void)
    }
  }

  fun changes(old: O.TimedObject, _mappable: mutable O.IMappable): O.IChanges {
    old.value match {
    | theme @ Theme _ -> this.properties.changes(theme.properties)
    | _ -> O.Change(this.getReference())
    }
  }

  fun delete(scope: mutable O.IScope): void {
    this.optState.each(state -> state.delete(scope))
  }
}

trait CheckChanges<V: frozen> {
  macro fun changes(other: inst): SortedMap<String, V> {
    diff = SortedMap<String, V>[];
    #forEachField (#field) {
      // Use isEqual to ensure that fields implement Equality
      if (native_eq(this.#field, other.#field) != 0) {
        !diff = diff.set("#field", this.#field)
      }
    };
    diff
  }
}

module end;
