    vec3 normal = normalize(vec3(grad, 1.0));

    // Lumière directionnelle
    float light = max(dot(normal, normalize(u_light_dir)), 0.0);

    vec3 lit_color = mix(vec3(0.0), u_text_color.rgb, light); // ombre -> couleur

    gl_FragColor = vec4(lit_color, u_text_color.a * alpha);
