    // --- Animation du décalage ---
    float offset_x = sin(u_time * u_speed) * u_amplitude;
    float offset_y = cos(u_time * u_speed * 0.8) * u_amplitude;
    vec2 shadow_offset = vec2(offset_x, offset_y);

    // --- Ombre ---
    vec2 shadow_uv = v_uv + shadow_offset;
    vec3 shadow_sample = texture2D(u_msdf, shadow_uv).rgb;
    float shadow_dist = median(shadow_sample) - 0.5;
    float shadow_alpha = smoothstep(-u_px_range, u_px_range, -shadow_dist);

    vec4 shadow = vec4(u_shadow_color.rgb, u_shadow_color.a * shadow_alpha);

    // --- Texte ---
    vec3 msdf_sample = texture2D(u_msdf, v_uv).rgb;
    float sd = median(msdf_sample) - 0.5;
    float text_alpha = clamp(smoothstep(-u_px_range, u_px_range, -sd), 0.0, 1.0);

    vec4 text = vec4(u_text_color.rgb, u_text_color.a * text_alpha);

    // --- Combine texte et ombre ---
    gl_FragColor = mix(shadow, text, text.a);
}

// Light + shadow

#version 100
precision mediump float;

uniform sampler2D u_msdf;
uniform vec4 u_text_color;
