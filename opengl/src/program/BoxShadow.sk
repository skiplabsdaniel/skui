module GLProgram;

const shadowFramentShader: String = source(
  Array[
    "precision highp float;",
    "varying vec2 v_position;",
    "uniform vec4 u_color;",
    "uniform vec2 u_offset;",
    "uniform float u_blur;",
    "",
    "float sdBox(vec2 p, vec2 b) {",
    "  vec2 d = abs(p) - b;",
    "  return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);",
    "}",
    "",
    "void main() {",
    "  vec2 centered = (v_position - u_offset) * 2.0 - 1.0;  // Move origin",
    "  float dist = sdBox(centered, vec2(1.0 - u_blur));",
    "",
    "  // Radial blur",
    "  float alpha = smoothstep(u_blur, 0.0, dist);",
    "",
    "  gl_FragColor = vec4(u_color.rgb, u_color.a * alpha);",
    "}",
  ],
);

class ShadowParameters(
  box: Geometry.Rect,
  color: .Color,
  offset: Geometry.Offset,
  blur: Float = 40.0,
) extends Parameters {
  static fun fromParams(obj: Parameters): this {
    obj match {
    | x @ ShadowParameters _ -> x
    | _ -> SKStore.cast_violation("GLProgram.ShadowParameters", obj)
    }
  }
}

class ShadowShader() extends FragmentShaderBuilder {
  fun source(): String {
    shadowFramentShader
  }

  fun build(program: GL.Prepared): FragmentShader {
    boxShadowColor = program.getIdxUniformLocation(uColor);
    boxShadowOffset = program.getIdxUniformLocation(uOffset);
    boxShadowBlur = program.getIdxUniformLocation(uBlur);

    LambdaFragmentShader((parameters, _) ~> {
      ctx = program.context();
      sps = ShadowParameters::fromParams(parameters);
      ctx.uniform4f(
        boxShadowColor,
        sps.color.red,
        sps.color.green,
        sps.color.blue,
        sps.color.alpha,
      );
      ctx.uniform2f(boxShadowOffset, sps.offset.dx, sps.offset.dy);
      ctx.uniform1f(
        boxShadowBlur,
        sps.blur / Math.min(sps.box.width(), sps.box.height()),
      );
    })
  }
}

module end;
