module alias T = SKTest;

module SKUIGLTest;

// Rendering tests of GL drawables without a window system (see
// GLOffscreen). To look at the rendered images, set SKUI_GL_IMAGES to a
// directory: each test writes its images there as PPM files.

fun render(
  name: String,
  drawables: Array<GLDrawable>,
  width: Int,
  height: Int,
  ratio: Float = 1.0,
): Ui.Image {
  GLOffscreen.render(drawables, width, height, ratio) match {
  | Some(image) ->
    Environ.varOpt("SKUI_GL_IMAGES").each(dir ->
      GLOffscreen.writePPM(image, `${dir}/${name}.ppm`)
    );
    image
  | None() -> throw T.ExpectationError("OpenGL", "available", "unavailable")
  }
}

fun pixel(image: Ui.Image, x: Int, y: Int): (Int, Int, Int) {
  p = image.data[y * image.width + x];
  (p.red.toInt(), p.green.toInt(), p.blue.toInt())
}

fun expectPixel(
  image: Ui.Image,
  x: Int,
  y: Int,
  expected: (Int, Int, Int),
  msg: String,
  tolerance: Int = 2,
): void {
  actual = pixel(image, x, y);
  (r, g, b) = actual;
  (er, eg, eb) = expected;
  if (
    Math.abs(r - er) > tolerance ||
    Math.abs(g - eg) > tolerance ||
    Math.abs(b - eb) > tolerance
  ) {
    throw T.ExpectationError(
      `${msg} at (${x}, ${y})`,
      `${expected}`,
      `${actual}`,
    )
  }
}

const white: (Int, Int, Int) = (255, 255, 255);
const red: (Int, Int, Int) = (255, 0, 0);

@test
fun solidRectangle(): void {
  image = render(
    "rectangle",
    Array[
      GLDrawable.rectangle(
        Geometry.Offset(10.0, 5.0),
        Geometry.Size(20.0, 10.0),
        Colors.red(),
      ),
    ],
    40,
    20,
  );
  T.expectEq(image.width, 40, "width");
  T.expectEq(image.height, 20, "height");
  // Inside, on the inner edges, and just outside the rectangle.
  expectPixel(image, 20, 10, red, "center");
  expectPixel(image, 10, 5, red, "top left");
  expectPixel(image, 29, 14, red, "bottom right");
  expectPixel(image, 9, 10, white, "left");
  expectPixel(image, 30, 10, white, "right");
  expectPixel(image, 20, 4, white, "above");
  expectPixel(image, 20, 15, white, "below");
}

@test
fun pixelRatio(): void {
  // At a pixel ratio of 2, the same logical rectangle covers twice as many
  // device pixels in each direction.
  image = render(
    "rectangle_ratio2",
    Array[
      GLDrawable.rectangle(
        Geometry.Offset(10.0, 5.0),
        Geometry.Size(20.0, 10.0),
        Colors.red(),
      ),
    ],
    40,
    20,
    2.0,
  );
  T.expectEq(image.width, 80, "width");
  T.expectEq(image.height, 40, "height");
  expectPixel(image, 20, 10, red, "top left");
  expectPixel(image, 59, 29, red, "bottom right");
  expectPixel(image, 19, 20, white, "left");
  expectPixel(image, 60, 20, white, "right");
  expectPixel(image, 40, 9, white, "above");
  expectPixel(image, 40, 30, white, "below");
}

@test
fun roundedRectangle(): void {
  image = render(
    "rounded",
    Array[
      GLDrawable.RoundedRectangle(
        Colors.red(),
        10.0,
        1.0,
        None(),
        Geometry.Rect::fromOffsetSize(
          Geometry.Offset(0.0, 0.0),
          Geometry.Size(40.0, 40.0),
        ),
      ),
    ],
    40,
    40,
  );
  // The corners are cut, the middle of the edges is filled.
  expectPixel(image, 0, 0, white, "corner");
  expectPixel(image, 39, 39, white, "opposite corner");
  expectPixel(image, 20, 1, red, "top edge");
  expectPixel(image, 1, 20, red, "left edge");
  expectPixel(image, 20, 20, red, "center");
}

@test
fun radialGradient(): void {
  // Center (60, 50) in the window, radius 50: red at the center, green at 25
  // pixels and blue from 50 pixels, in every direction.
  image = render(
    "radial",
    Array[
      GLDrawable.rectangle(
        Geometry.Offset(10.0, 10.0),
        Geometry.Size(100.0, 80.0),
        Ui.RadialGradient(
          Geometry.Offset(50.0, 40.0),
          50.0,
          Array[
            Ui.Stop(0.0, Colors.red()),
            Ui.Stop(0.5, Colors.lime()),
            Ui.Stop(1.0, Colors.blue()),
          ],
        ),
      ),
    ],
    120,
    100,
  );
  expectPixel(image, 60, 50, (255, 0, 0), "center", 10);
  expectPixel(image, 85, 50, (0, 255, 0), "right", 10);
  expectPixel(image, 35, 50, (0, 255, 0), "left", 10);
  expectPixel(image, 60, 75, (0, 255, 0), "below", 10);
  expectPixel(image, 109, 89, (0, 0, 255), "corner", 10);
  expectPixel(image, 5, 5, white, "outside");
}

// The opacity of the shadow of the rectangle [x0, x1] x [y0, y1], blurred
// with a gaussian of standard deviation sigma, at (x, y): the exact value
// for square corners.
fun shadowCoverage(
  x: Float,
  y: Float,
  box: (Float, Float, Float, Float),
  sigma: Float,
): Float {
  (x0, y0, x1, y1) = box;
  cdf = (t: Float) -> 0.5 * (1.0 + erf(t / (sigma * Math.sqrt(2.0))));
  (cdf(x - x0) - cdf(x - x1)) * (cdf(y - y0) - cdf(y - y1))
}

// The error function (Abramowitz and Stegun 7.1.26, error below 1.5e-7).
fun erf(x: Float): Float {
  sign = if (x < 0.0) -1.0 else 1.0;
  a = Math.abs(x);
  t = 1.0 / (1.0 + 0.3275911 * a);
  y =
    1.0 -
    (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) *
      t +
      0.254829592) *
      t *
      Math.exp(-a * a);
  sign * y
}

// The red channel expected for a black shadow of opacity alpha on white.
fun shadowRed(coverage: Float, alpha: Float): Int {
  Math.round(255.0 * (1.0 - alpha * coverage)).toInt()
}

fun shadowImage(
  name: String,
  shadow: GLDrawable,
  ratio: Float = 1.0,
): Ui.Image {
  render(name, Array[shadow], 160, 110, ratio)
}

@test
fun boxShadowSquare(): void {
  // Without radius, the shadow is the exact gaussian blur of the box.
  sigma = 8.0;
  alpha = 160.0 / 255.0;
  shadow = GLDrawable.BoxShadow::create{
    offset => Geometry.Offset(40.0, 30.0),
    size => Geometry.Size(80.0, 50.0),
    sigma,
    color => Color::rgbaInt(0, 0, 0, 160),
  };
  for (ratio in Array[1.0, 2.0]) {
    image = shadowImage(`shadow_square_x${ratio.toInt()}`, shadow, ratio);
    for (x in Array[20, 34, 40, 46, 60, 80, 126]) {
      for (y in Array[18, 30, 55, 76, 90]) {
        // The center of the pixel, in logical pixels.
        px = (x.toFloat() * ratio).toInt();
        py = (y.toFloat() * ratio).toInt();
        center = (v: Int) -> (v.toFloat() + 0.5) / ratio;
        expected = shadowRed(
          shadowCoverage(
            center(px),
            center(py),
            (40.0, 30.0, 120.0, 80.0),
            sigma,
          ),
          alpha,
        );
        (r, _, _) = pixel(image, px, py);
        T.expectEq(
          Math.abs(r - expected) <= 3,
          true,
          `(${x}, ${y}): ${r} ${expected}`,
        )
      }
    }
  }
}

@test
fun boxShadowRounded(): void {
  // A sharp shadow (sigma 0) is the rounded rectangle itself.
  image = shadowImage(
    "shadow_sharp_rounded",
    GLDrawable.BoxShadow::create{
      offset => Geometry.Offset(40.0, 30.0),
      size => Geometry.Size(80.0, 50.0),
      sigma => 0.0,
      color => Colors.black(),
      radius => 20.0,
    },
  );
  expectPixel(image, 80, 55, (0, 0, 0), "center");
  expectPixel(image, 41, 31, white, "corner");
  expectPixel(image, 45, 35, white, "inside the corner radius");
  expectPixel(image, 41, 55, (0, 0, 0), "left edge");
  expectPixel(image, 80, 31, (0, 0, 0), "top edge");
  // Blurred, the corner is lighter than with square corners, the middle of
  // the edges is the same.
  sigma = 6.0;
  square = shadowImage(
    "shadow_blur_square",
    GLDrawable.BoxShadow::create{
      offset => Geometry.Offset(40.0, 30.0),
      size => Geometry.Size(80.0, 50.0),
      sigma,
      color => Colors.black(),
    },
  );
  rounded = shadowImage(
    "shadow_blur_rounded",
    GLDrawable.BoxShadow::create{
      offset => Geometry.Offset(40.0, 30.0),
      size => Geometry.Size(80.0, 50.0),
      sigma,
      color => Colors.black(),
      radius => 20.0,
    },
  );
  (squareCorner, _, _) = pixel(square, 42, 32);
  (roundedCorner, _, _) = pixel(rounded, 42, 32);
  T.expectEq(
    roundedCorner > squareCorner + 40,
    true,
    `corner ${squareCorner} ${roundedCorner}`,
  );
  for (point in Array[(80, 55), (80, 30), (40, 55), (80, 20)]) {
    (x, y) = point;
    (a, _, _) = pixel(square, x, y);
    (b, _, _) = pixel(rounded, x, y);
    T.expectEq(Math.abs(a - b) <= 3, true, `edge (${x}, ${y}): ${a} ${b}`)
  }
}

@test
fun boxShadowOffsetSpreadClip(): void {
  // Offset and spread move and grow the shadow; with clip it is not drawn
  // below the element.
  image = shadowImage(
    "shadow_offset_spread_clip",
    GLDrawable.BoxShadow::create{
      offset => Geometry.Offset(40.0, 30.0),
      size => Geometry.Size(60.0, 40.0),
      sigma => 0.0,
      color => Colors.black(),
      shadowOffset => Geometry.Offset(10.0, 8.0),
      spread => 4.0,
      clip => true,
    },
  );
  // The shadow covers [46, 114] x [34, 82] (moved by (10, 8), grown by 4),
  // minus the element [40, 100] x [30, 70].
  expectPixel(image, 70, 50, white, "below the element");
  expectPixel(image, 105, 50, (0, 0, 0), "right of the element");
  expectPixel(image, 70, 76, (0, 0, 0), "below the element");
  // Spread rounds the corners by its own value (as CSS box-shadow).
  expectPixel(image, 110, 78, (0, 0, 0), "near the bottom right corner");
  expectPixel(image, 113, 81, white, "rounded bottom right corner");
  expectPixel(image, 116, 50, white, "beyond the spread");
  expectPixel(image, 44, 76, white, "left of the moved shadow");
}

// Text, drawn as the framework does it: glyph MSDFs generated once at
// msdfSize, placed from the glyph origin at the drawn size, and scaled to
// device pixels at draw time.

const msdfSize: Float = 45.0;

fun liberation(): TrueType.Font {
  TrueType.parse(SKIP_SKUIFontTestsRes.liberationBin())
}

fun glyphAt(font: TrueType.Font, size: Float, c: Char): Font.Glyph {
  TrueType.Face::make(font, Font.Options{size, dpi => 72.0})
    .getGlyph(c)
    .fromSome()
}

// The drawables of text at size, with its baseline at y = baseline.
fun textDrawables(
  font: TrueType.Font,
  text: String,
  size: Float,
  left: Float,
  baseline: Float,
  effects: Ui.TextEffects = Ui.TextEffects::none,
  color: .Color = Colors.black(),
  pxRange: Int = 8,
): Array<GLDrawable> {
  pen = left;
  drawables = mutable Vector<GLDrawable>[];
  for (c in text.chars()) {
    glyph = glyphAt(font, size, c);
    reference = glyphAt(font, msdfSize, c);
    glyph.optPath.each(_ -> {
      (image, place) = MTSDF.toMSDF{
        shape => MTSDF.Shape::fromPath(
          reference.optPath.fromSome().translate(reference.topLeft()),
        ),
        pxRange,
        trueDistance => true,
      };
      topLeft = glyph.topLeft();
      imageSize = Geometry.Size(
        glyph.imageWidth().toFloat(),
        glyph.imageHeight().toFloat(),
      );
      offset = Geometry.Offset(pen, baseline) + topLeft;
      drawables.push(
        GLDrawable.Msdf::create(
          ctx ~> SKUI.pictureToTexturable(image).map(t -> t.asTexture(ctx)),
          r ~> {
            ratio = r.width() / imageSize.width;
            place(
              Geometry.Rect::fromOffsetSize(
                r.topLeft() - topLeft * ratio,
                Geometry.Size(0.0, 0.0),
              ),
              size * ratio / msdfSize,
            )
          },
          pxRange,
          color,
          0.0,
          offset,
          imageSize,
          effects,
        ),
      )
    });
    !pen = pen + glyph.advance();
  };
  drawables.toArray()
}

// The rows of the image that have dark pixels in columns [x0, x1).
fun inkRows(image: Ui.Image, x0: Int, x1: Int): (Int, Int) {
  top = image.height;
  bottom = -1;
  for (y in Range(0, image.height)) {
    for (x in Range(x0, x1)) {
      (r, _, _) = pixel(image, x, y);
      if (r < 128) {
        !top = Math.min(top, y);
        !bottom = Math.max(bottom, y)
      }
    }
  };
  (top, bottom)
}

@test
fun msdfText(): void {
  font = liberation();
  size = 13.0;
  text = "aeoxnsu";
  image = render("text13", textDrawables(font, text, size, 2.0, 14.0), 64, 20);
  // Every lowercase letter sits on the baseline, at y = 14: the last row
  // of ink of each glyph is the row just above it.
  pen = 2.0;
  for (c in text.chars()) {
    advance = glyphAt(font, size, c).advance();
    (_, bottom) = inkRows(
      image,
      Math.ceil(pen).toInt(),
      Math.floor(pen + advance).toInt(),
    );
    T.expectEq(bottom, 13, `baseline of ${c}`);
    !pen = pen + advance
  }
}

@test
fun msdfTextPixelRatio(): void {
  font = liberation();
  drawables = textDrawables(font, "x", 13.0, 2.0, 14.0);
  image1 = render("x13", drawables, 16, 20);
  image2 = render("x13_ratio2", drawables, 16, 20, 2.0);
  // At a pixel ratio of 2, the glyph covers twice as many device pixels:
  // it is not drawn at its logical size in the larger image.
  (top1, bottom1) = inkRows(image1, 0, 16);
  (top2, bottom2) = inkRows(image2, 0, 32);
  height1 = bottom1 - top1 + 1;
  height2 = bottom2 - top2 + 1;
  T.expectEq(
    Math.abs(height2 - 2 * height1) <= 1,
    true,
    `${height1} ${height2}`,
  );
  T.expectEq(bottom2, 27, "baseline");
}

// The exact rendering of text, to compare with the MSDF rendering: the
// coverage of each device pixel by the glyph outlines at size, computed
// with 16 x 16 samples per pixel.
fun referenceText(
  font: TrueType.Font,
  text: String,
  size: Float,
  left: Float,
  baseline: Float,
  width: Int,
  height: Int,
  ratio: Float,
): Ui.Image {
  dWidth = (width.toFloat() * ratio).toInt();
  dHeight = (height.toFloat() * ratio).toInt();
  // The outlines in device pixels.
  contours = mutable Vector<MTSDF.Contour>[];
  pen = left;
  for (c in text.chars()) {
    glyph = glyphAt(font, size, c);
    glyph.optPath.each(path -> {
      origin = Geometry.Offset(pen, baseline) + glyph.topLeft();
      shape = MTSDF.Shape::fromPath(path.transform(p ~> (origin + p) * ratio));
      shape.contours.each(contours.push)
    });
    !pen = pen + glyph.advance()
  };
  shape = MTSDF.Shape(contours.toArray(), false);
  samples = 16;
  coverage = Array::mfill(dWidth * dHeight, 0);
  for (sy in Range(0, dHeight * samples)) {
    y = (sy.toFloat() + 0.5) / samples.toFloat();
    scanline = shape.scanline(y);
    for (sx in Range(0, dWidth * samples)) {
      x = (sx.toFloat() + 0.5) / samples.toFloat();
      if (scanline.filled(x, MTSDF.NonZero())) {
        i = (sy / samples) * dWidth + sx / samples;
        coverage.set(i, coverage[i] + 1)
      }
    }
  };
  Ui.Image::make(dWidth, dHeight, (x, y) -> {
    ink = coverage[y * dWidth + x].toFloat() / (samples * samples).toFloat();
    v = UInt8::truncate((255.0 * (1.0 - ink) + 0.5).toInt());
    Ui.Pix(v, v, v, UInt8::truncate(255))
  })
}

// One image with, from top to bottom, the MSDF rendering, the reference
// rendering, and their difference (darker is more different, amplified 4
// times), each separated by a red line.
fun comparison(msdf: Ui.Image, reference: Ui.Image): Ui.Image {
  w = msdf.width;
  h = msdf.height;
  Ui.Image::make(w, 3 * h + 2, (x, y) -> {
    band = if (y < h) 0 else if (y == h) -1 else if (y <= 2 * h) 1 else if (
      y ==
      2 * h + 1
    ) {
      -1
    } else {
      2
    };
    band match {
    | -1 ->
      Ui.Pix(
        UInt8::truncate(255),
        UInt8::zero,
        UInt8::zero,
        UInt8::truncate(255),
      )
    | 0 -> msdf.data[y * w + x]
    | 1 -> reference.data[(y - h - 1) * w + x]
    | _ ->
      i = (y - 2 * h - 2) * w + x;
      d = Math.abs(msdf.data[i].red.toInt() - reference.data[i].red.toInt());
      v = UInt8::truncate(Math.max(0, 255 - 4 * d));
      Ui.Pix(v, v, v, UInt8::truncate(255))
    }
  })
}

// The mean and maximum difference between the MSDF and reference
// renderings, in 0-255 grey levels.
fun difference(msdf: Ui.Image, reference: Ui.Image): (Float, Int) {
  total = 0;
  max = 0;
  msdf.data.eachWithIndex((i, p) -> {
    d = Math.abs(p.red.toInt() - reference.data[i].red.toInt());
    !total = total + d;
    !max = Math.max(max, d)
  });
  (total.toFloat() / msdf.data.size().toFloat(), max)
}

@test
fun msdfTextReference(): void {
  font = liberation();
  text = "Hamburgefonstiv";
  for (size in Array[11.0, 13.0, 17.0, 24.0]) {
    for (ratio in Array[1.0, 2.0]) {
      width = (size * 8.5).toInt();
      height = (size * 1.6).toInt();
      baseline = Math.round(size * 1.2);
      msdf = render(
        `text_${size.toInt()}_x${ratio.toInt()}_msdf`,
        textDrawables(font, text, size, 2.0, baseline),
        width,
        height,
        ratio,
      );
      reference = referenceText(
        font,
        text,
        size,
        2.0,
        baseline,
        width,
        height,
        ratio,
      );
      Environ.varOpt("SKUI_GL_IMAGES").each(dir ->
        GLOffscreen.writePPM(
          comparison(msdf, reference),
          `${dir}/text_${size.toInt()}_x${ratio.toInt()}_compare.ppm`,
        )
      );
      (mean, _max) = difference(msdf, reference);
      // The MSDF rendering stays close to the exact coverage of the glyph
      // outlines (mean differences from 0.5 to 2.4 grey levels): a glyph
      // off by one pixel gives a mean difference several times larger.
      T.expectEq(
        mean < 4.0,
        true,
        `mean difference ${mean} at ${size} x${ratio}`,
      );
    }
  }
}

// Text effects: an outline and a shadow drawn from the true distance of the
// glyph MSDFs (MTSDF), compared with renderings computed from the glyph
// outlines.

// The glyph outlines of text in device pixels, as a single shape.
fun textShape(
  font: TrueType.Font,
  text: String,
  size: Float,
  left: Float,
  baseline: Float,
  ratio: Float,
): MTSDF.Shape {
  contours = mutable Vector<MTSDF.Contour>[];
  pen = left;
  for (c in text.chars()) {
    glyph = glyphAt(font, size, c);
    glyph.optPath.each(path -> {
      origin = Geometry.Offset(pen, baseline) + glyph.topLeft();
      MTSDF.Shape::fromPath(
        path.transform(p ~> (origin + p) * ratio),
      ).contours.each(contours.push)
    });
    !pen = pen + glyph.advance()
  };
  MTSDF.Shape(contours.toArray(), false)
}

// The exact rendering of text with an outline of width w and a sharp shadow
// moved by shadowOffset (device pixels), each pixel sampled samples x
// samples times: a sample is the text color when inside the glyphs, else
// the outline color when closer than w to them, else the shadow color when
// the shifted glyphs cover it, else white.
fun referenceEffects(
  shape: MTSDF.Shape,
  dWidth: Int,
  dHeight: Int,
  textColor: (Int, Int, Int),
  optOutline: ?((Int, Int, Int), Float),
  optShadow: ?((Int, Int, Int), Geometry.Offset),
): Ui.Image {
  samples = 4;
  finder = MTSDF.ShapeDistanceFinder::make(
    shape,
    MTSDF.SimpleSelectors::make(shape, MTSDF.Single()),
  );
  sums = Array::mfill(dWidth * dHeight * 3, 0);
  for (sy in Range(0, dHeight * samples)) {
    y = (sy.toFloat() + 0.5) / samples.toFloat();
    scanline = shape.scanline(y);
    optShadowScanline = optShadow.map(s -> shape.scanline(y - s.i1.dy));
    for (sx in Range(0, dWidth * samples)) {
      x = (sx.toFloat() + 0.5) / samples.toFloat();
      color = if (scanline.filled(x, MTSDF.NonZero())) {
        textColor
      } else {
        inOutline = optOutline
          .map(o -> {
            d = finder.distance(MTSDF.Vector2(x, y)).resolve();
            Math.abs(d) < o.i1
          })
          .default(false);
        if (inOutline) {
          optOutline.fromSome().i0
        } else {
          shadowed = optShadow
            .map(s ->
              optShadowScanline.fromSome().filled(x - s.i1.dx, MTSDF.NonZero())
            )
            .default(false);
          if (shadowed) optShadow.fromSome().i0 else (255, 255, 255)
        }
      };
      i = ((sy / samples) * dWidth + sx / samples) * 3;
      (r, g, b) = color;
      sums.set(i, sums[i] + r);
      sums.set(i + 1, sums[i + 1] + g);
      sums.set(i + 2, sums[i + 2] + b);
    }
  };
  n = samples * samples;
  Ui.Image::make(dWidth, dHeight, (x, y) -> {
    i = (y * dWidth + x) * 3;
    Ui.Pix(
      UInt8::truncate(sums[i] / n),
      UInt8::truncate(sums[i + 1] / n),
      UInt8::truncate(sums[i + 2] / n),
      UInt8::truncate(255),
    )
  })
}

// The mean difference over the three channels, in 0-255 levels.
fun colorDifference(a: Ui.Image, b: Ui.Image): Float {
  total = 0;
  a.data.eachWithIndex((i, p) -> {
    q = b.data[i];
    !total =
      total +
      Math.abs(p.red.toInt() - q.red.toInt()) +
      Math.abs(p.green.toInt() - q.green.toInt()) +
      Math.abs(p.blue.toInt() - q.blue.toInt())
  });
  total.toFloat() / (3 * a.data.size()).toFloat()
}

fun colorComparison(msdf: Ui.Image, reference: Ui.Image): Ui.Image {
  w = msdf.width;
  h = msdf.height;
  red = Ui.Pix(
    UInt8::truncate(255),
    UInt8::zero,
    UInt8::zero,
    UInt8::truncate(255),
  );
  Ui.Image::make(w, 3 * h + 2, (x, y) -> {
    if (y < h) {
      msdf.data[y * w + x]
    } else if (y == h || y == 2 * h + 1) {
      red
    } else if (y <= 2 * h) {
      reference.data[(y - h - 1) * w + x]
    } else {
      i = (y - 2 * h - 2) * w + x;
      p = msdf.data[i];
      q = reference.data[i];
      d =
        Math.abs(p.red.toInt() - q.red.toInt()) +
        Math.abs(p.green.toInt() - q.green.toInt()) +
        Math.abs(p.blue.toInt() - q.blue.toInt());
      v = UInt8::truncate(Math.max(0, 255 - 2 * d));
      Ui.Pix(v, v, v, UInt8::truncate(255))
    }
  })
}

// Checks the rendering of text with effects against the reference, at two
// sizes and pixel ratios. The effects are right when the mean difference
// stays below maxMean: an outline or a shadow off by one pixel gives a
// mean difference from 9 to 26. The soft edge of the shadow (one device
// pixel) makes its difference higher than the outline one.
fun checkEffects(
  name: String,
  effects: Ui.TextEffects,
  optOutline: ?((Int, Int, Int), Float),
  optShadow: ?((Int, Int, Int), Geometry.Offset),
  maxMean: Float,
): void {
  font = liberation();
  text = "Hamburgefonstiv";
  for (size in Array[13.0, 24.0]) {
    for (ratio in Array[1.0, 2.0]) {
      width = (size * 8.5).toInt();
      height = (size * 1.6).toInt();
      baseline = Math.round(size * 1.2);
      // The MSDF must hold distances up to the effect extent: at msdfSize,
      // extent * msdfSize / size texture pixels on each side.
      reach = effects.extent() * msdfSize / size;
      pxRange = Math.max(8, 2 * Math.ceil(reach + 2.0).toInt());
      msdf = render(
        `${name}_${size.toInt()}_x${ratio.toInt()}_msdf`,
        textDrawables(
          font,
          text,
          size,
          2.0,
          baseline,
          effects,
          Colors.black(),
          pxRange,
        ),
        width,
        height,
        ratio,
      );
      shape = textShape(font, text, size, 2.0, baseline, ratio);
      reference = referenceEffects(
        shape,
        msdf.width,
        msdf.height,
        (0, 0, 0),
        optOutline.map(o -> (o.i0, o.i1 * ratio)),
        optShadow.map(s -> (s.i0, s.i1 * ratio)),
      );
      Environ.varOpt("SKUI_GL_IMAGES").each(dir ->
        GLOffscreen.writePPM(
          colorComparison(msdf, reference),
          `${dir}/${name}_${size.toInt()}_x${ratio.toInt()}_compare.ppm`,
        )
      );
      mean = colorDifference(msdf, reference);
      T.expectEq(
        mean < maxMean,
        true,
        `${name}: mean difference ${mean} at ${size} x${ratio}`,
      );
    }
  }
}

@test
fun msdfTextOutline(): void {
  checkEffects(
    "outline",
    Ui.TextEffects{optOutline => Some(Ui.TextOutline(Colors.red(), 2.0))},
    Some(((255, 0, 0), 2.0)),
    None(),
    4.0,
  )
}

@test
fun msdfTextShadow(): void {
  offset = Geometry.Offset(2.0, 2.0);
  checkEffects(
    "shadow",
    Ui.TextEffects{optShadow => Some(Ui.TextShadow(Colors.blue(), offset))},
    None(),
    Some(((0, 0, 255), offset)),
    8.0,
  )
}

@test
fun msdfTextOutlineAndShadow(): void {
  offset = Geometry.Offset(3.0, 3.0);
  checkEffects(
    "outline_shadow",
    Ui.TextEffects{
      optOutline => Some(Ui.TextOutline(Colors.red(), 1.5)),
      optShadow => Some(Ui.TextShadow(Colors.blue(), offset)),
    },
    Some(((255, 0, 0), 1.5)),
    Some(((0, 0, 255), offset)),
    8.0,
  )
}

// Color glyphs (COLR): each layer is drawn with its own MSDF, bottom to
// top, placed like the glyph it belongs to.

// The drawables of the color glyph of c drawn at size with its origin at
// (left, baseline): one per layer, in the layer color or textColor.
fun colorGlyphDrawables(
  font: TrueType.Font,
  c: Char,
  size: Float,
  left: Float,
  baseline: Float,
  textColor: .Color,
): Array<GLDrawable> {
  glyph = glyphAt(font, size, c);
  reference = glyphAt(font, msdfSize, c);
  topLeft = glyph.topLeft();
  imageSize = Geometry.Size(
    glyph.imageWidth().toFloat(),
    glyph.imageHeight().toFloat(),
  );
  offset = Geometry.Offset(left, baseline) + topLeft;
  reference.colorLayers.map(layer -> {
    (image, place) = MTSDF.toMSDF{
      shape => MTSDF.Shape::fromPath(layer.path.translate(reference.topLeft())),
      pxRange => 8,
      trueDistance => true,
    };
    msdf = GLDrawable.Msdf::create(
      ctx ~> SKUI.pictureToTexturable(image).map(t -> t.asTexture(ctx)),
      r ~> {
        ratio = r.width() / imageSize.width;
        place(
          Geometry.Rect::fromOffsetSize(
            r.topLeft() - topLeft * ratio,
            Geometry.Size(0.0, 0.0),
          ),
          size * ratio / msdfSize,
        )
      },
      8,
      layer.color.default(textColor),
      0.0,
      offset,
      imageSize,
    );
    drawable: GLDrawable = msdf;
    drawable
  })
}

// The exact rendering of the color glyph: the coverage of each layer by its
// outline, composited bottom to top over white.
fun referenceColorGlyph(
  font: TrueType.Font,
  c: Char,
  size: Float,
  left: Float,
  baseline: Float,
  textColor: .Color,
  dWidth: Int,
  dHeight: Int,
  ratio: Float,
): Ui.Image {
  glyph = glyphAt(font, size, c);
  origin = Geometry.Offset(left, baseline) + glyph.topLeft();
  samples = 8;
  n = (samples * samples).toFloat();
  pixels = Array::mfill(dWidth * dHeight * 3, 1.0);
  for (layer in glyph.colorLayers) {
    color = layer.color.default(textColor);
    shape = MTSDF.Shape::fromPath(
      layer.path.transform(p ~> (origin + p) * ratio),
    );
    coverage = Array::mfill(dWidth * dHeight, 0);
    for (sy in Range(0, dHeight * samples)) {
      scanline = shape.scanline((sy.toFloat() + 0.5) / samples.toFloat());
      for (sx in Range(0, dWidth * samples)) {
        if (
          scanline.filled(
            (sx.toFloat() + 0.5) / samples.toFloat(),
            MTSDF.NonZero(),
          )
        ) {
          i = (sy / samples) * dWidth + sx / samples;
          coverage.set(i, coverage[i] + 1)
        }
      }
    };
    for (i in Range(0, dWidth * dHeight)) {
      a = color.alpha * coverage[i].toFloat() / n;
      Array[color.red, color.green, color.blue].eachWithIndex((k, v) ->
        pixels.set(i * 3 + k, v * a + pixels[i * 3 + k] * (1.0 - a))
      )
    }
  };
  toByte = v -> UInt8::truncate((v * 255.0 + 0.5).toInt());
  Ui.Image::make(dWidth, dHeight, (x, y) -> {
    i = (y * dWidth + x) * 3;
    Ui.Pix(
      toByte(pixels[i]),
      toByte(pixels[i + 1]),
      toByte(pixels[i + 2]),
      UInt8::truncate(255),
    )
  })
}

@test
fun colorGlyph(): void {
  font = TrueType.parse(SKIP_SKUIFontTestsRes.colrBin());
  textColor = Colors.green();
  for (size in Array[24.0, 48.0]) {
    for (ratio in Array[1.0, 2.0]) {
      width = (size * 1.0).toInt();
      height = (size * 1.2).toInt();
      baseline = Math.round(size);
      drawables = colorGlyphDrawables(
        font,
        'A',
        size,
        2.0,
        baseline,
        textColor,
      );
      T.expectEq(drawables.size(), 2, "layers");
      msdf = render(
        `colr_${size.toInt()}_x${ratio.toInt()}_msdf`,
        drawables,
        width,
        height,
        ratio,
      );
      reference = referenceColorGlyph(
        font,
        'A',
        size,
        2.0,
        baseline,
        textColor,
        msdf.width,
        msdf.height,
        ratio,
      );
      Environ.varOpt("SKUI_GL_IMAGES").each(dir ->
        GLOffscreen.writePPM(
          colorComparison(msdf, reference),
          `${dir}/colr_${size.toInt()}_x${ratio.toInt()}_compare.ppm`,
        )
      );
      // The bottom layer is the square (0, 0)-(600, 600) and the top one
      // (200, 200)-(400, 400), in units of 1/1000 em above the baseline at
      // x = 2: the center of the glyph is in the text color, the middle of
      // its left side is the half transparent red over white.
      toDevice = (u, v) ->
        (
          ((2.0 + u * size / 1000.0) * ratio).toInt(),
          ((baseline - v * size / 1000.0) * ratio).toInt(),
        );
      (cx, cy) = toDevice(300.0, 300.0);
      expectPixel(msdf, cx, cy, (0, 128, 0), `top layer ${size}`);
      (bx, by) = toDevice(100.0, 300.0);
      expectPixel(msdf, bx, by, (255, 127, 127), `bottom layer ${size}`);
      (ox, oy) = toDevice(700.0, 300.0);
      expectPixel(msdf, ox, oy, (255, 255, 255), `outside ${size}`);
      mean = colorDifference(msdf, reference);
      T.expectEq(
        mean < 4.0,
        true,
        `mean difference ${mean} at ${size} x${ratio}`,
      );
    }
  }
}

fun renderList(
  name: String,
  items: Array<GLRender.Item>,
  width: Int,
  height: Int,
  ratio: Float = 1.0,
): Ui.Image {
  GLOffscreen.renderItems(items, width, height, ratio) match {
  | Some(image) ->
    Environ.varOpt("SKUI_GL_IMAGES").each(dir ->
      GLOffscreen.writePPM(image, `${dir}/${name}.ppm`)
    );
    image
  | None() -> throw T.ExpectationError("OpenGL", "available", "unavailable")
  }
}

@test
fun shaderClipRoundedPrimitives(): void {
  // Full-screen red rectangle clipped by a rounded rectangle (10, 10)-(70, 50)
  // with corner radius 15: inside center is red, corners of the clip rect are
  // cut to white, outside the clip rect is white. Also tested at ratio 2.
  rect = GLDrawable.rectangle(
    Geometry.Offset(0.0, 0.0),
    Geometry.Size(80.0, 60.0),
    Colors.red(),
  );
  clip = GLRender.Clip(Geometry.Rect::fromLTWH(10.0, 10.0, 60.0, 40.0), 15.0);
  for (ratio in Array[1.0, 2.0]) {
    img = renderList(
      `clip_rect_x${ratio.toInt()}`,
      Array[GLRender.Item(rect, 0, 0.0, Some(clip))],
      80,
      60,
      ratio,
    );
    s = ratio.toInt();
    expectPixel(img, 40 * s, 30 * s, red, `center x${s}`);
    expectPixel(img, 12 * s, 30 * s, red, `left edge mid x${s}`);
    expectPixel(img, 67 * s, 30 * s, red, `right edge mid x${s}`);
    expectPixel(img, 40 * s, 12 * s, red, `top edge mid x${s}`);
    expectPixel(img, 40 * s, 47 * s, red, `bottom edge mid x${s}`);
    // Rounded corners of the clip rect are cut away.
    expectPixel(img, 11 * s, 11 * s, white, `cut top-left corner x${s}`);
    expectPixel(img, 68 * s, 48 * s, white, `cut bottom-right corner x${s}`);
    // Outside clip rect is completely clipped away.
    expectPixel(img, 5 * s, 30 * s, white, `outside left x${s}`);
    expectPixel(img, 75 * s, 30 * s, white, `outside right x${s}`);
  }
}

@test
fun shaderClipMsdfTextAndShadow(): void {
  // MSDF text ("AAAA") clipped to the left half [0, 24) x [0, 32): ink must
  // appear in the left half and be completely absent in the right half,
  // confirming MSDF fwidth works cleanly before clip coverage is applied.
  font = liberation();
  textDraws = textDrawables(font, "AAAA", 20.0, 2.0, 22.0);
  clip = GLRender.Clip(Geometry.Rect::fromLTWH(0.0, 0.0, 24.0, 32.0), 0.0);
  items = textDraws.map(d -> GLRender.Item(d, 0, 0.0, Some(clip)));
  img = renderList("clip_msdf", items, 64, 32);
  (topL, botL) = inkRows(img, 2, 22);
  (_, botR) = inkRows(img, 26, 62);
  T.expectEq(botL >= topL, true, "text visible inside clip");
  T.expectEq(botR, -1, "text clipped outside clip");

  // BoxShadow clipped to [0, 30) x [0, 60): shadow extends right of x=30,
  // must be visible at x=25 and white at x=35 (confirming u_skui_clip* does
  // not clash with BoxShadow's own u_clip exclusion uniforms).
  shadow = GLDrawable.BoxShadow::create{
    offset => Geometry.Offset(15.0, 20.0),
    size => Geometry.Size(20.0, 20.0),
    sigma => 5.0,
    color => Colors.black(),
    radius => 4.0,
    clip => true,
  };
  sClip = GLRender.Clip(Geometry.Rect::fromLTWH(0.0, 0.0, 30.0, 60.0), 0.0);
  sImg = renderList(
    "clip_shadow",
    Array[GLRender.Item(shadow, 0, 0.0, Some(sClip))],
    60,
    60,
  );
  // Just above the box inside the clip (x=25, y=16): darkened by blur.
  (sr, _, _) = pixel(sImg, 25, 16);
  T.expectEq(sr < 220, true, `shadow visible inside clip, got r=${sr}`);
  // Inside the excluded box itself (x=22, y=30): still white thanks to BoxShadow clip.
  expectPixel(sImg, 22, 30, white, "box shadow inner exclusion still works");
  // Right of shader clip (x=36, y=30): clipped away to white.
  expectPixel(sImg, 36, 30, white, "shadow clipped outside shader clip");
}

@test
fun depthOrderSortsTranslucentDrawables(): void {
  // Submit a front translucent blue square BEFORE a back opaque red square,
  // with orders 20 (front) and 10 (back). Painter's sort must draw red first
  // then blend translucent blue (50% alpha) over red -> purple ~(128, 0, 128).
  // (If order were ignored, red would overwrite blue -> pure red.)
  frontBlue = GLDrawable.rectangle(
    Geometry.Offset(10.0, 10.0),
    Geometry.Size(20.0, 20.0),
    .Color::rgbaInt(0, 0, 255, 128),
  );
  backRed = GLDrawable.rectangle(
    Geometry.Offset(0.0, 0.0),
    Geometry.Size(40.0, 40.0),
    Colors.red(),
  );
  img = renderList(
    "depth_sort",
    Array[
      GLRender.Item(frontBlue, 20, -0.5, None()),
      GLRender.Item(backRed, 10, 0.5, None()),
    ],
    40,
    40,
  );
  // Outside overlap: pure red.
  expectPixel(img, 5, 5, red, "back red outside overlap");
  // Inside overlap: 50% blue over red -> (127, 0, 128).
  expectPixel(img, 20, 20, (127, 0, 128), "translucent blue blended over red");
}

@test
fun glslLightingRespectsLightColorAndDirection(): void {
  // Render a GLSL.Ellipsoide lit by a single colored point light (green) from
  // above-left: the lit highlight must be greenish (g >> r, g >> b) and much
  // brighter on the upper half (facing the light) than on the bottom edge.
  scene = GLSL.Scene(
    GLSL.Ellipsoide(),
    GLSL.Config{lights => 1, colors => 1, shininesses => 1, textures => 0},
  );
  cval = (v: GLSL.Value) ->
    (_ctx: GL.Ctx) ~> Some((_b: Geometry.Rect, _w: Geometry.Size) ~> v);
  ellipsoide = (_ctx: GL.Ctx) ~>
    Some((bs: Geometry.Rect, _w: Geometry.Size) ~> {
      side = Math.max(bs.width(), bs.height());
      GLSL.VStruct(
        SortedMap[
          "center" => GLSL.VVec::v3(0.5, 0.5, 0.0),
          "radius" => GLSL.VVec::v3(
            0.5 * bs.width() / side,
            0.5 * bs.height() / side,
            0.5,
          ),
        ],
      )
    });
  drawable = GLSL.Drawable(
    scene,
    Map[
      "u_filter" => cval(GLSL.VVec::v1(0.0)),
      "u_shininesses" => cval(GLSL.VVec[12.0]),
      "u_smoothing" => (_ctx) ~>
        Some((bds, _) ~>
          GLSL.VVec::v1(4.0 / Math.min(bds.width(), bds.height()))
        ),
      "u_camera" => cval(GLSL.VVec::v3(0.5, 0.5, 2.0)),
      "u_ambient" => cval(GLSL.rgb(.Color::rgbaInt(20, 20, 20))),
      "u_colors" => cval(GLSL.VArray[GLSL.rgba(Colors.white())]),
      "u_ellipsoide" => ellipsoide,
      "u_ligthcount" => cval(GLSL.VVec[1.0]),
      "u_lights" => cval(
        GLSL.VArray[
          GLSL.VStruct[
            "color" => GLSL.rgb(Colors.green()),
            "point" => GLSL.VVec::v1(1.0),
            "value" => GLSL.VVec::v3(0.5, 0.0, 1.5),
          ],
        ],
      ),
    ],
    None(),
    GLSL.High(),
    Geometry.Rect::fromLTWH(0.0, 0.0, 80.0, 80.0),
  );
  // Clip the right half of the lit ellipsoid to verify GLSL-generated shaders
  // also receive the shared shader clip prelude.
  clip = GLRender.Clip(Geometry.Rect::fromLTWH(0.0, 0.0, 50.0, 80.0), 0.0);
  img = renderList(
    "glsl_light_clip",
    Array[GLRender.Item(drawable, 0, 0.0, Some(clip))],
    80,
    80,
  );
  // Upper-center (40, 22) faces the green light: strong green, low red/blue.
  (rTop, gTop, bTop) = pixel(img, 40, 22);
  T.expectEq(
    gTop > 80,
    true,
    `green light bright on top: (${rTop},${gTop},${bTop})`,
  );
  T.expectEq(
    gTop > rTop + 40 && gTop > bTop + 40,
    true,
    `light tint is green: (${rTop},${gTop},${bTop})`,
  );
  // Lower-center (40, 72) tilts away from the light -> darker than upper-center.
  (_, gBot, _) = pixel(img, 40, 72);
  T.expectEq(gTop > gBot, true, `top (${gTop}) brighter than bottom (${gBot})`);
  // Right of clip x=60 -> clipped away to white background.
  expectPixel(img, 60, 40, white, "GLSL shader clipped at x=50");
}

module end;
