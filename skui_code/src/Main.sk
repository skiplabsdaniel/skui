  SKStore.destroyObstack(mainPos);
}

fun readLine(): ?Array<Char> {
  buffer = mutable Vector[];
  try {
    loop {
      c = getChar();
      if (c == '\n') break Some(buffer.toArray());
      buffer.push(c);
    }
  } catch {
  | EndOfFile() -> if (buffer.isEmpty()) None() else Some(buffer.toArray())
  | ex ->
    debug(ex);
    throw ex
  }
}

fun initContext(context: mutable SKStore.Context): void {
  _ = context
    .makeDir(SKStore.IID::keyType, TextLineFile::btype, linesDir, Array[])
    .map(
      CharsID::keyType,
      SKStore.IntFile::type,
      context,
      uniquesDir,
      (_ctx, writer, key, it) ~> {
        it.first match {
        | CharsFile(chars) ->
          writer.set(CharsID(chars), SKStore.IntFile(key.value))
        | _ -> void
        }
      },
    )
    .map(
      LineID::keyType,
      SKStore.IntFile::type,
      context,
      linesUtilsDir,
      (_ctx, writer, key, it) ~> {
        writer.set(
          LineID(toLine(key.value, SkuiCodeSkip.bracketsBuilder)),
          it.first,
        )
      },
    )
    .map(
      LineID::keyType,
      Tokens::type,
      context,
      tokensDir,
      (_ctx, writer, key, it) ~> {
        if (inRange(it, 0, 100)) {
          line = key.value;
          words = toWords(line.text);
          map = SortedMap<Int, Array<Char>>[];
          line.brackets.each(b -> !map = map.add(b.index, b.value));
          writer.set(key, words.lex(map))
        }
      },
    )
}

fun inRange(it: mutable Iterator<SKStore.IntFile>, min: Int, max: Int): Bool {
  loop {
    it.next() match {
    | Some(v) if (v.value >= min && v.value < max) -> break true
    | None() -> break false
    | _ -> void
    }
  }
}

fun initContext2(context: mutable SKStore.Context): void {
  _ = context
    .makeDir(SKStore.IID::keyType, TextLineFile2::btype, linesDir, Array[])
    .map(
      CharsID2::keyType,
      SKStore.IntFile::type,
      context,
      uniquesDir,
      (_ctx, writer, key, it) ~> {
        it.first match {
        | CharsFile2(chars) ->
          writer.set(CharsID2(chars), SKStore.IntFile(key.value))
        | _ -> void
        }
      },
    )
}
