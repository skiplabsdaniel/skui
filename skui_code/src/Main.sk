module SkuiCode;

const linesDir: SKStore.DirName = SKStore.DirName::create("/skui_code/lines/");
const linesHdl: SKStore.IHandle<SKStore.IID, TextLineFile> = SKStore.IHandle(
  SKStore.IID::keyType,
  TextLineFile::btype,
  linesDir,
);
const linesHdl2: SKStore.IHandle<SKStore.IID, TextLineFile2> = SKStore.IHandle(
  SKStore.IID::keyType,
  TextLineFile2::btype,
  linesDir,
);
const countIDD: SKStore.IID = SKStore.IID(-1);
const uniquesDir: SKStore.DirName = SKStore.DirName::create(
  "/skui_code/uniques/",
);
const linesUtilsDir: SKStore.DirName = SKStore.DirName::create(
  "/skui_code/lines_utils/",
);
const tokensDir: SKStore.DirName = SKStore.DirName::create(
  "/skui_code/tokens/",
);

const units: Array<String> = Array[
  "B",
  "kB",
  "MB",
  "GB",
  "TB",
  "PB",
  "EB",
  "ZB",
  "YB",
];

fun humanSize(bytes: Int): String {
  dBytes = bytes.toFloat();
  thresh = 1024.0;
  for (u in units) {
    if (Math.abs(dBytes) < thresh) {
      break `${Math.round(dBytes * 10.0) / 10.0} ${u}`;
    };
    !dBytes = dBytes / thresh;
  } else {
    `${Math.round(dBytes * 10.0) / 10.0} ${units.last()}`;
  }
}

fun main(): void {
  mainPos = SKStore.newObstack();
  if (SKStore.gHasContext() == 0) {
    SKStore.gContextInit(SKStore.Context{});
    SKStore.Context::withoutGc(initContext);
  };
  print_debug(`Info: ${humanSize(60000 * 80)}`);
  print_debug(`Persistent size before: ${humanSize(SKStore.persistentSize())}`);
  print_debug(`Obstack size before: ${humanSize(SKStore.obstackSize())}`);
  fromContext = SKStore.gUnsafeContextGet();
  fromTick = fromContext.tick;
  context = SKStore.Context::fromSaved(fromContext);
  optPos: ?SKStore.Obstack = None();
  try {
    count = linesHdl
      .maybeGetValue(context, countIDD, true)
      .map(CountFile::type)
      .map(v -> v.value)
      .default(0);
    !optPos = context.loopWithGC(
      ctx -> {
        readLine() match {
        | Some(line) ->
          linesHdl.write(
            ctx,
            SKStore.IID(count),
            CharsFile(toInternalLine(line, 4)),
          )
        | _ -> return true
        };
        !count = count + 1;
        return false;
      },
      () -> count % 1000 == 0,
    );
    linesHdl.write(context, countIDD, CountFile(count));
    print_debug(`Count: ${count}`);
    sContext = SKStore.gContextSync(
      fromTick,
      fromContext,
      context.clone(),
      None(),
      UInt32::truncate(0),
      None(),
    );
    SKStore.gUnsafeFree(sContext);
    SKStore.destroyObstack(optPos.fromSome());
  } catch {
  | ex ->
    print_debug(ex.getMessage());
    SKStore.gUnsafeFree(fromContext);
    optPos match {
    | Some(pos) ->
      cexn = SKStore.destroyObstackWithValue(pos, List[ex]).getHead();
      throw cexn
    | _ -> throw ex
    };
    throw ex
  };
  print_debug(
    `Persistent size before update: ${humanSize(SKStore.persistentSize())}`,
  );
  print_debug(
    `Obstack size before update: ${humanSize(SKStore.obstackSize())}`,
  );
  SKStore.Context::withoutGc(ctx ~> ctx.update());
  print_debug(`Persistent size after: ${humanSize(SKStore.persistentSize())}`);
  print_debug(`Obstack size after: ${humanSize(SKStore.obstackSize())}`);

  SKStore.destroyObstack(mainPos);
}

