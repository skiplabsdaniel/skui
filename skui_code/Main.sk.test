module SkuiCode;

const linesDir: SKStore.DirName = SKStore.DirName::create("/skui_code/lines/");
const linesHdl: SKStore.IHandle<
  SKStore.IID,
  SKStore.StringFile,
> = SKStore.IHandle(SKStore.IID::keyType, SKStore.StringFile::type, linesDir);
const countIDD: SKStore.IID = SKStore.IID(-1);

fun main(): void {
  pos = SKStore.newObstack();
  if (SKStore.gHasContext() == 0) {
    SKStore.gContextInit(SKStore.Context{});
    SKStore.Context::withoutGc(initContext);
  };
  print_debug(`Persistent size before: ${SKStore.persistentSize()}`);
  SKStore.Context::withoutGc(ctx ~> {
    count = linesHdl
      .maybeGetValue(ctx, countIDD, true)
      .map(v -> v.value.toInt())
      .default(0);
    loop {
      readLine() match {
      | Some(line) ->
        linesHdl.write(ctx, SKStore.IID(count), SKStore.StringFile(line))
      | _ -> break void
      };
      !count = count + 1;
    };
    linesHdl.write(ctx, countIDD, SKStore.StringFile(count.toString()));
    ctx.update();
    print_debug(`Count: ${count}`);
  });
  print_debug(`Persistent size after: ${SKStore.persistentSize()}`);
  SKStore.Context::withoutGc(ctx ~> {
    count = linesHdl.getValue(ctx, countIDD, true).value.toInt();
    for (i in Range(0, count)) {
      print_debug(
        `Line[${i +
          1}]: ${linesHdl.getValue(
          ctx,
          SKStore.IID(i),
          true,
        ).value}}`,
      );
    }
  });
  print_debug(`Persistent size after: ${SKStore.persistentSize()}`);
  SKStore.destroyObstack(pos);
}

fun readLine(): ?String {
  buffer = mutable Vector[];
  try {
    loop {
      c = getChar();
      if (c == '\n') break Some(String::fromChars(buffer.toArray()));
      buffer.push(c);
    }
  } catch {
  | EndOfFile() ->
    if (buffer.isEmpty()) None() else Some(String::fromChars(buffer.toArray()))
  | ex -> throw ex
  }
}

fun initContext(context: mutable SKStore.Context): void {
  _ = context.makeDir(
    SKStore.IID::keyType,
    SKStore.StringFile::type,
    linesDir,
    Array[],
  );
}

module end;

