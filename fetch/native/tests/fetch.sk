module alias T = SKTest;

module SKFetchTests;

@test
fun test_fetch_ffi_simple_get(): void {
  SKFetch.fetch("https://httpbin.org/get") match {
  | Success(SKFetch.Result(200, _, Some(payload))) ->
    json = JSON.decode(payload).expectObject();
    T.expectEq(json.getString("url"), "https://httpbin.org/get")
  | Success(SKFetch.Result(503, _, _)) -> void
  | Failure(exn) -> T.fail(exn.getMessage())
  | res -> T.fail(`Unexpected results: ${inspect(res)}`)
  }
}

@test
fun test_fetch_with_post(): void {
  options = SKFetch.Settings{
    method => SKFetch.Post(),
    body => Some("hello=world"),
    headers => Map["Content-Type" => "application/x-www-form-urlencoded"],
  };
  SKFetch.fetch("https://httpbin.org/post", options) match {
  | Success(SKFetch.Result(200, _, Some(payload))) ->
    json = JSON.decode(payload).expectObject();
    T.expectEq(json.getObject("form").getString("hello"), "world")
  | Success(SKFetch.Result(503, _, _)) -> void
  | Failure(exn) -> T.fail(exn.getMessage())
  | res -> T.fail(`Unexpected results: ${inspect(res)}`)
  }
}

@test
fun test_fetch_not_found(): void {
  SKFetch.fetch("https://httpbin.org/status/404") match {
  | Success(SKFetch.Result(404, _, _)) -> void
  | Success(SKFetch.Result(503, _, _)) -> void
  | Failure(exn) -> T.fail(exn.getMessage())
  | res -> T.fail(`Expected 404, got ${inspect(res)}`)
  }
}

@test
fun test_fetch_with_custom_headers(): void {
  options = SKFetch.Settings{headers => Map["X-Test-Header" => "Karamel"]};
  SKFetch.fetch("https://httpbin.org/headers", options) match {
  | Success(SKFetch.Result(200, _, Some(payload))) ->
    json = JSON.decode(payload).expectObject();
    T.expectEq(json.getObject("headers").getString("X-Test-Header"), "Karamel")
  | Success(SKFetch.Result(503, _, _)) -> void
  | Failure(exn) -> T.fail(exn.getMessage())
  | res -> T.fail(`Unexpected results: ${inspect(res)}`)
  }
}

@test
fun test_fetch_post_json_body(): void {
  options = SKFetch.Settings{
    method => SKFetch.Post(),
    body => Some(`{"foo": "bar"}`),
    headers => Map["Content-Type" => "application/json"],
  };
  SKFetch.fetch("https://httpbin.org/post", options) match {
  | Success(SKFetch.Result(200, _, Some(payload))) ->
    json = JSON.decode(payload).expectObject();
    data = JSON.decode(json.getString("data")).expectObject();
    T.expectEq(data.getString("foo"), "bar")
  | Success(SKFetch.Result(503, _, _)) -> void
  | Failure(exn) -> T.fail(exn.getMessage())
  | res -> T.fail(`Unexpected results: ${inspect(res)}`)
  }
}

@test
fun test_fetch_timeout(): void {
  options = SKFetch.Settings{timeout_s => 1};
  SKFetch.fetch("https://httpbin.org/delay/3", options) match {
  | Success(SKFetch.Result(503, _, _)) -> void
  | Failure _ -> void
  | _ -> T.fail("Expected timeout failure")
  }
}

module end;
