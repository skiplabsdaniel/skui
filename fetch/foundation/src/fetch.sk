module SKFetch;

class Exception(message: String) extends .Exception

base class Method uses Orderable, Show {
  children =
  | Get()
  | Post()
  | Put()
  | Delete()
  | Head()
  | Options()
  | Connect()
  | Trace()
  | Patch()

  fun toString(): String
  | Get() -> "GET"
  | Post() -> "POST"
  | Put() -> "PUT"
  | Delete() -> "DELETE"
  | Head() -> "HEAD"
  | Options() -> "OPTIONS"
  | Connect() -> "CONNECT"
  | Trace() -> "TRACE"
  | Patch() -> "PATCH"

  static fun fromString(m: String): Method {
    m.uppercase() match {
    | "GET" -> Get()
    | "POST" -> Post()
    | "PUT" -> Put()
    | "DELETE" -> Delete()
    | "HEAD" -> Head()
    | "OPTIONS" -> Options()
    | "CONNECT" -> Connect()
    | "TRACE" -> Trace()
    | "PATCH" -> Patch()
    | _ -> invariant_violation(`Unknown method ${m}`)
    }
  }
}

class Settings{
  method: Method = Get(),
  headers: Map<String, String> = Map[],
  body: ?String = None(),
  timeout_s: Int = 5,
}

class Result(status: Int, headers: Map<String, String>, text: ?String) {
  fun json<T>(conv: JSON.Value ~> T): .Result<T, .Exception> {
    this.text match {
    | Some(text) -> .Result::guard(() -> conv(JSON.decode(text)))
    | _ -> Failure(Exception("No data available"))
    }
  }

  fun skjson<T>(conv: SKJSON.CJSON ~> T): .Result<T, .Exception> {
    this.text match {
    | Some(text) -> .Result::guard(() -> conv(SKJSON.decode(text)))
    | _ -> Failure(Exception("No data available"))
    }
  }
}

@export("sk_create_result")
fun createResult(
  status: Int,
  headers: ?String,
  payload: ?String,
  error: ?String,
): .Result<Result, Exception> {
  error match {
  | Some(e) -> Failure(Exception(e))
  | _ ->
    payload match {
    | Some(data) ->
      Success(
        Result(
          status.toInt(),
          headers
            .map(h ->
              JSON.decode(h).expectObject().value.map((_, v) ->
                v.expectString()
              )
            )
            .default(Map[]),
          Some(data),
        ),
      )
    | _ -> Success(Result(status.toInt(), Map[], None()))
    }
  };
}

module end;
