module RUi;

// Window size stored in an input directory.
class WindowSizeFile(size: Geometry.Size) extends SKStore.File

// Geometry of an element in window coordinates.
class ElementGeometry(
  id: ElementId,
  offset: Geometry.Offset,
  size: Geometry.Size,
) extends SKStore.File {
  fun rect(): Geometry.Rect {
    Geometry.Rect::fromOffsetSize(this.offset, this.size)
  }
}

// Stacking order of an element, computed apart from layout and paint.
// A higher order (or higher z) draws above a lower one.
// `z` is mapped into (-1.0, 1.0) for OpenGL depth ordering; painter's
// algorithm sorts by `order` ascending (back to front).
class ElementDepth(
  id: ElementId,
  layer: StackingLayer,
  order: Int,
  z: Float,
) extends SKStore.File

// Local-coordinate paint output of an element: an array of Drawables in
// painter order (background -> content -> foreground, all local to this
// element). Does not depend on depth or absolute offset.
class ElementPaint(drawables: Array<Ui.Drawable>) extends SKStore.File

// One entry of the final sorted draw list produced by the pipeline.
class DrawEntry(
  id: ElementId,
  offset: Geometry.Offset,
  depth: ElementDepth,
  drawable: Ui.Drawable,
)

// Helper for depth sorting: collects (layer, preOrder, id) entries.
private class DepthItem(
  layer: StackingLayer,
  preOrder: Int,
  id: ElementId,
) uses Orderable {
  fun compare(other: DepthItem): Order {
    this.layer.compare(other.layer) match {
    | EQ() -> this.preOrder.compare(other.preOrder)
    | ord -> ord
    }
  }
}

// Walks the layout tree from ElementId::root to compute absolute window
// geometry for every laid-out element.
fun collectGeometry(
  context: mutable SKStore.Context,
  layoutHdl: SKStore.LHandle<LayoutKey, LayoutResult>,
  writer: mutable SKStore.TWriter<ElementId, ElementGeometry>,
  id: ElementId,
  constraints: BoxConstraints,
  absOffset: Geometry.Offset,
): void {
  res = layoutHdl.get(context, LayoutKey(id, constraints));
  writer.set(id, ElementGeometry(id, absOffset, res.size));
  for (placement in res.placements) {
    collectGeometry(
      context,
      layoutHdl,
      writer,
      placement.id,
      placement.constraints,
      absOffset + placement.offset,
    )
  }
}

// Walks the element tree in pre-order to collect (layer, preOrder, id) for
// every element. `Layer` nodes switch the active stacking layer for their
// subtree; changing a Layer's value only recomputes this depth stage.
fun collectDepthItems(
  context: mutable SKStore.Context,
  elementsHdl: SKStore.EHandle<ElementId, Element>,
  id: ElementId,
  inheritedLayer: StackingLayer,
  counter: mutable Ref<Int>,
  out: mutable Vector<DepthItem>,
): void {
  element = elementsHdl.get(context, id);
  layer = element.node match {
  | Layer{layer => layerVal} -> layerVal.get(context)
  | _ -> inheritedLayer
  };
  order = counter.value;
  counter.!value = order + 1;
  out.push(DepthItem(layer, order, id));
  for (cid in element.childIds) {
    collectDepthItems(context, elementsHdl, cid, layer, counter, out)
  }
}

// Computes the depth stage: maps each element to its StackingLayer, global
// stacking order (0 = furthest back, n-1 = frontmost), and OpenGL z value.
// Higher order -> smaller NDC z in (-1, 1) (OpenGL default GL_LESS: nearer
// surfaces have smaller z; painters sort by `order` ascending).
fun buildDepthDir(
  context: mutable SKStore.Context,
  elementsHdl: SKStore.EHandle<ElementId, Element>,
  dirName: SKStore.DirName,
): SKStore.EHandle<ElementId, ElementDepth> {
  // Drive from the root element so the whole tree's stacking order is computed
  // in one pass without depending on layout or paint.
  rootOnly = elementsHdl.map(
    SKStore.UnitID::keyType,
    Element::type,
    context,
    dirName.sub("trigger"),
    (_context, writer, key, values) ~> {
      if (key.isRoot()) {
        writer.set(SKStore.UnitID::singleton, values.first)
      }
    },
  );
  rootOnly.map(
    ElementId::keyType,
    ElementDepth::type,
    context,
    dirName,
    (context, writer, _key, _values) ~> {
      items = mutable Vector<DepthItem>[];
      counter = mutable Ref(0);
      collectDepthItems(
        context,
        elementsHdl,
        ElementId::root,
        BaseLayer(),
        counter,
        items,
      );
      sorted = items.toArray().sorted();
      n = sorted.size();
      denom = (n + 1).toFloat();
      for (i in Range(0, n)) {
        item = sorted[i];
        // Map order i in [0, n-1] strictly inside (-1, 1), back -> +1, front -> -1.
        z = 1.0 - 2.0 * (i + 1).toFloat() / denom;
        writer.set(item.id, ElementDepth(item.id, item.layer, i, z))
      }
    },
  )
}

// Resolves the active Theme for an element by walking up ThemeScope ancestors
// to the root theme directory. Memoized lazily per ElementId so changing a
// ThemeScope only affects its subtree.
fun buildElementThemesDir(
  context: mutable SKStore.Context,
  elementsHdl: SKStore.EHandle<ElementId, Element>,
  rootThemeHdl: SKStore.EHandle<SKStore.UnitID, Theme>,
  dirName: SKStore.DirName,
): SKStore.LHandle<ElementId, Theme> {
  makeLazyDir(
    ElementId::keyType,
    Theme::type,
    context,
    dirName,
    (context, self, id) ~> {
      element = elementsHdl.get(context, id);
      element.node match {
      | ThemeScope{theme} -> theme.get(context)
      | _ ->
        element.parent match {
        | Some(pid) -> self.get(context, pid)
        | None() -> rootThemeHdl.get(context, SKStore.UnitID::singleton)
        }
      }
    },
  )
}

// Resolves each element's style through its active Skin and Theme.
fun buildStylesDir(
  context: mutable SKStore.Context,
  elementsHdl: SKStore.EHandle<ElementId, Element>,
  elementThemesHdl: SKStore.LHandle<ElementId, Theme>,
  dirName: SKStore.DirName,
): SKStore.EHandle<ElementId, ResolvedStyle> {
  elementsHdl.map(
    ElementId::keyType,
    ResolvedStyle::type,
    context,
    dirName,
    (context, writer, id, values) ~> {
      element = values.first;
      style = nodeSkinKey(context, element.node) match {
      | Some(sk) ->
        theme = elementThemesHdl.get(context, id);
        theme.skinFor(sk.kind, sk.variant) match {
        | Some(skin) -> skin.resolveStyle(context, element.node, theme)
        | None() -> ResolvedStyle::empty
        }
      | None() -> ResolvedStyle::empty
      };
      writer.set(id, style)
    },
  )
}

// Paints a single element in its local coordinates (origin 0, 0) through its
// active Skin. Does not depend on depth or absolute position, so restacking
// or shifting an element does not re-run paint.
fun paintElement(
  pctx: mutable PaintContext,
  element: Element,
  theme: Theme,
  style: ResolvedStyle,
  state: ElementState,
  interaction: InteractionState,
  size: Geometry.Size,
): Array<Ui.Drawable> {
  nodeSkinKey(pctx.context, element.node) match {
  | Some(sk) ->
    theme.skinFor(sk.kind, sk.variant) match {
    | Some(skin) ->
      skin.paint(pctx, element.node, style, state, interaction, theme, size)
    | None() -> Array[]
    }
  | None() -> Array[]
  }
}

// Whether an element is interactive (eligible as a hover/hit target).
fun isInteractiveNode(node: Node): Bool {
  node match {
  | Button _
  | Toggle _ ->
    true
  | _ -> false
  }
}

// Whether an element is currently disabled.
fun isNodeDisabled(context: mutable SKStore.Context, node: Node): Bool {
  node match {
  | Button{enabled} -> !enabled.get(context)
  | Toggle{enabled} -> !enabled.get(context)
  | _ -> false
  }
}

// Whether an element is currently pressed (armed).
fun isStatePressed(state: ElementState): Bool {
  state match {
  | ButtonState(armed) -> armed
  | ToggleState(armed, _) -> armed
  | EmptyState() -> false
  }
}

// Finds the topmost interactive element at `pos` using tracked reads of
// elements, geometry, and depth so hover updates automatically when layout
// moves under a stationary pointer.
fun findHoveredElement(
  context: mutable SKStore.Context,
  elementsHdl: SKStore.EHandle<ElementId, Element>,
  geometryHdl: SKStore.EHandle<ElementId, ElementGeometry>,
  depthHdl: SKStore.EHandle<ElementId, ElementDepth>,
  pos: Geometry.Offset,
): ?ElementId {
  bestId: ?ElementId = None();
  bestOrder = -1;
  stack = mutable Vector<ElementId>[ElementId::root];
  while (!stack.isEmpty()) {
    id = stack.pop();
    elementsHdl.maybeGet(context, id).each(el -> {
      if (isInteractiveNode(el.node)) {
        geometryHdl.maybeGet(context, id).each(geom -> {
          if (geom.rect().contains(pos)) {
            depthHdl.maybeGet(context, id).each(d -> {
              if (d.order > bestOrder) {
                !bestOrder = d.order;
                !bestId = Some(id)
              }
            })
          }
        })
      };
      for (cid in el.childIds) {
        stack.push(cid)
      }
    })
  };
  bestId
}

// The incremental pipeline for RUi (steps 3-5):
//
//   inputs: rootNode + windowSize + rootTheme + fonts + pointerFact + focusFact + states
//     -> elementsHdl      (Node descriptions expanded by ElementId)
//     -> elementThemesHdl (active Theme per ElementId, respecting ThemeScope)
//     -> stylesHdl        (ResolvedStyle per ElementId via Skin + Theme)
//     -> layoutHdl        (lazy memoized layout per (ElementId, BoxConstraints))
//     -> geometryHdl      (absolute rects in window coordinates)
//     -> depthHdl         (stacking layers -> global order and GL z)
//     -> hoveredHdl       (derived topmost hovered ElementId from pointer + geometry + depth)
//     -> interactionHdl   (derived per-element InteractionState: hover, pressed, focused, disabled)
//     -> semanticsHdl     (derived per-element SemanticsInfo for accessibility & focus order)
//     -> paintHdl         (local drawables per ElementId via Skin)
//
//   input events (outside the graph):
//     Pipeline.dispatch(context, events) -> route -> pure reducers -> commit -> update -> effects
class Pipeline private (
  rootNodeHdl: SKStore.EHandle<SKStore.UnitID, NodeFile>,
  windowSizeHdl: SKStore.EHandle<SKStore.UnitID, WindowSizeFile>,
  themeHdl: SKStore.EHandle<SKStore.UnitID, Theme>,
  pointerHdl: SKStore.EHandle<SKStore.UnitID, PointerFact>,
  focusHdl: SKStore.EHandle<SKStore.UnitID, FocusFact>,
  statesHdl: SKStore.EHandle<ElementId, ElementState>,
  fonts: FontStore,
  elementsHdl: SKStore.EHandle<ElementId, Element>,
  elementThemesHdl: SKStore.LHandle<ElementId, Theme>,
  stylesHdl: SKStore.EHandle<ElementId, ResolvedStyle>,
  layoutHdl: SKStore.LHandle<LayoutKey, LayoutResult>,
  geometryHdl: SKStore.EHandle<ElementId, ElementGeometry>,
  depthHdl: SKStore.EHandle<ElementId, ElementDepth>,
  hoveredHdl: SKStore.EHandle<SKStore.UnitID, BoxFile<?ElementId>>,
  interactionHdl: SKStore.EHandle<ElementId, InteractionState>,
  semanticsHdl: SKStore.EHandle<ElementId, SemanticsInfo>,
  paintHdl: SKStore.EHandle<ElementId, ElementPaint>,
) {
  static fun create(
    context: mutable SKStore.Context,
    rootNode: Node,
    windowSize: Geometry.Size,
    support: Ui.DrawableSupport,
    prefix: String = "main",
    optTheme: ?Theme = None(),
    optFonts: ?FontStore = None(),
  ): Pipeline {
    baseDir = moduleDir(prefix);
    rootNodeHdl = makeInputDir(
      SKStore.UnitID::keyType,
      NodeFile::type,
      context,
      baseDir.sub("root-node"),
      Array[(SKStore.UnitID::singleton, NodeFile(rootNode))],
    );
    windowSizeHdl = makeInputDir(
      SKStore.UnitID::keyType,
      WindowSizeFile::type,
      context,
      baseDir.sub("window-size"),
      Array[(SKStore.UnitID::singleton, WindowSizeFile(windowSize))],
    );
    themeHdl = makeInputDir(
      SKStore.UnitID::keyType,
      Theme::type,
      context,
      baseDir.sub("theme"),
      Array[(SKStore.UnitID::singleton, optTheme.default(Theme::default()))],
    );
    pointerHdl = makeInputDir(
      SKStore.UnitID::keyType,
      PointerFact::type,
      context,
      baseDir.sub("pointer"),
      Array[(SKStore.UnitID::singleton, PointerFact())],
    );
    focusHdl = makeInputDir(
      SKStore.UnitID::keyType,
      FocusFact::type,
      context,
      baseDir.sub("focus"),
      Array[(SKStore.UnitID::singleton, FocusFact())],
    );
    statesHdl = makeInputDir(
      ElementId::keyType,
      ElementState::stateType,
      context,
      baseDir.sub("states"),
    );
    fonts = optFonts match {
    | Some(fs) -> fs
    | None() -> FontStore::create(context, prefix)
    };
    elementsHdl = buildElementTree(
      context,
      rootNodeHdl,
      baseDir.sub("elements"),
    );
    elementThemesHdl = buildElementThemesDir(
      context,
      elementsHdl,
      themeHdl,
      baseDir.sub("element-themes"),
    );
    stylesHdl = buildStylesDir(
      context,
      elementsHdl,
      elementThemesHdl,
      baseDir.sub("styles"),
    );
    layoutHdl = buildLayoutDir(
      context,
      elementsHdl,
      stylesHdl,
      fonts,
      baseDir.sub("layout"),
    );
    geometryHdl = windowSizeHdl.map(
      ElementId::keyType,
      ElementGeometry::type,
      context,
      baseDir.sub("geometry"),
      (context, writer, _key, values) ~> {
        win = values.first.size;
        rootConstraints = BoxConstraints::tight(win.width, win.height);
        collectGeometry(
          context,
          layoutHdl,
          writer,
          ElementId::root,
          rootConstraints,
          Geometry.Offset::zero,
        )
      },
    );
    depthHdl = buildDepthDir(context, elementsHdl, baseDir.sub("depth"));
    // Derived hover: topmost interactive element under pointer.
    hoveredHdl = pointerHdl.map(
      SKStore.UnitID::keyType,
      BoxFile<?ElementId>::type,
      context,
      baseDir.sub("hovered"),
      (context, writer, key, values) ~> {
        pf = values.first;
        optHover = pf.optPosition.flatMap(pos ->
          findHoveredElement(context, elementsHdl, geometryHdl, depthHdl, pos)
        );
        writer.set(key, BoxFile(optHover))
      },
    );
    // Derived per-element interaction state (hover, pressed, focused, disabled).
    // Only elements whose interaction flags actually change invalidate paint.
    interactionHdl = elementsHdl.map(
      ElementId::keyType,
      InteractionState::type,
      context,
      baseDir.sub("interaction"),
      (context, writer, key, values) ~> {
        el = values.first;
        if (isInteractiveNode(el.node)) {
          optHovered = hoveredHdl.get(context, SKStore.UnitID::singleton).value;
          optFocused = focusHdl.get(
            context,
            SKStore.UnitID::singleton,
          ).optFocused;
          st = statesHdl.maybeGet(context, key).default(EmptyState());
          writer.set(
            key,
            InteractionState{
              hovered => optHovered == Some(key),
              pressed => isStatePressed(st),
              focused => optFocused == Some(key),
              disabled => isNodeDisabled(context, el.node),
            },
          )
        } else {
          writer.set(key, InteractionState::normal)
        }
      },
    );
    // Derived accessibility semantics per element.
    semanticsHdl = geometryHdl.map(
      ElementId::keyType,
      SemanticsInfo::type,
      context,
      baseDir.sub("semantics"),
      (context, writer, key, values) ~> {
        el = elementsHdl.get(context, key);
        st = statesHdl.maybeGet(context, key).default(EmptyState());
        optFocused = focusHdl.get(
          context,
          SKStore.UnitID::singleton,
        ).optFocused;
        info = computeSemantics(
          context,
          el,
          st,
          optFocused == Some(key),
          values.first.rect(),
        );
        writer.set(key, info)
      },
    );
    // Paint depends on element + style + state + interaction + its own size
    // (projected from geometry so moving an element without resizing it does
    // not invalidate paint).
    sizesHdl = geometryHdl.map(
      ElementId::keyType,
      BoxFile<Geometry.Size>::type,
      context,
      baseDir.sub("sizes"),
      (_context, writer, key, values) ~> {
        writer.set(key, BoxFile(values.first.size))
      },
    );
    paintHdl = sizesHdl.map(
      ElementId::keyType,
      ElementPaint::type,
      context,
      baseDir.sub("paint"),
      (context, writer, key, values) ~> {
        element = elementsHdl.get(context, key);
        theme = elementThemesHdl.get(context, key);
        style = stylesHdl.get(context, key);
        state = statesHdl.maybeGet(context, key).default(EmptyState());
        interaction = interactionHdl
          .maybeGet(context, key)
          .default(InteractionState::normal);
        pctx = mutable PaintContext(context, support, fonts);
        drawables = paintElement(
          pctx,
          element,
          theme,
          style,
          state,
          interaction,
          values.first.value,
        );
        writer.set(key, ElementPaint(drawables))
      },
    );
    Pipeline(
      rootNodeHdl,
      windowSizeHdl,
      themeHdl,
      pointerHdl,
      focusHdl,
      statesHdl,
      fonts,
      elementsHdl,
      elementThemesHdl,
      stylesHdl,
      layoutHdl,
      geometryHdl,
      depthHdl,
      hoveredHdl,
      interactionHdl,
      semanticsHdl,
      paintHdl,
    )
  }

  // Updates the root node (outside of reactive computations).
  fun setRoot(context: mutable SKStore.Context, rootNode: Node): void {
    writeValue(
      context,
      this.rootNodeHdl,
      SKStore.UnitID::singleton,
      NodeFile(rootNode),
    )
  }

  // Updates the window size (outside of reactive computations).
  fun setWindowSize(
    context: mutable SKStore.Context,
    size: Geometry.Size,
  ): void {
    writeValue(
      context,
      this.windowSizeHdl,
      SKStore.UnitID::singleton,
      WindowSizeFile(size),
    )
  }

  // Updates the root theme (outside of reactive computations).
  fun setTheme(context: mutable SKStore.Context, theme: Theme): void {
    writeValue(context, this.themeHdl, SKStore.UnitID::singleton, theme)
  }

  // Sets focus explicitly (outside of reactive computations).
  fun setFocus(context: mutable SKStore.Context, target: ?ElementId): void {
    writeValue(
      context,
      this.focusHdl,
      SKStore.UnitID::singleton,
      FocusFact(target),
    )
  }

  fun focused(context: readonly SKStore.Context): ?ElementId {
    this.focusHdl.unsafeGet(context, SKStore.UnitID::singleton).optFocused
  }

  fun hovered(context: readonly SKStore.Context): ?ElementId {
    this.hoveredHdl.unsafeGet(context, SKStore.UnitID::singleton).value
  }

  // Hit tests the committed geometry and depth (outside the graph), returning
  // the topmost element containing `pos` (deepest/frontmost by depth order).
  fun hitTest(
    context: readonly SKStore.Context,
    pos: Geometry.Offset,
  ): ?ElementId {
    bestId: ?ElementId = None();
    bestOrder = -1;
    stack = mutable Vector<ElementId>[ElementId::root];
    while (!stack.isEmpty()) {
      id = stack.pop();
      this.elementsHdl.unsafeMaybeGet(context, id).each(el -> {
        this.geometryHdl.unsafeMaybeGet(context, id).each(geom -> {
          if (geom.rect().contains(pos)) {
            this.depthHdl.unsafeMaybeGet(context, id).each(d -> {
              if (d.order > bestOrder) {
                !bestOrder = d.order;
                !bestId = Some(id)
              }
            })
          }
        });
        for (cid in el.childIds) {
          stack.push(cid)
        }
      })
    };
    bestId
  }

  // Returns the ordered list of currently focusable ElementIds in tree
  // pre-order, derived from the semantics stage.
  fun focusOrder(context: readonly SKStore.Context): Array<ElementId> {
    out = mutable Vector<ElementId>[];
    this.collectFocusable(context, ElementId::root, out);
    out.toArray()
  }

  private fun collectFocusable(
    context: readonly SKStore.Context,
    id: ElementId,
    out: mutable Vector<ElementId>,
  ): void {
    this.semanticsHdl.unsafeMaybeGet(context, id).each(sem -> {
      if (sem.focusable && !sem.disabled) {
        out.push(id)
      }
    });
    this.elementsHdl.unsafeMaybeGet(context, id).each(el -> {
      for (cid in el.childIds) {
        this.collectFocusable(context, cid, out)
      }
    })
  }

  // Builds the bubbling route from `target` up to `ElementId::root`.
  private fun routeToRoot(target: ElementId): Array<ElementId> {
    out = mutable Vector<ElementId>[];
    cur: ?ElementId = Some(target);
    while (cur is Some _) {
      id = cur.fromSome();
      out.push(id);
      !cur = id.parent()
    };
    out.toArray()
  }

  // Dispatches a single event (convenience wrapper over `dispatchBatch`).
  fun dispatch(context: mutable SKStore.Context, event: Event): Array<Effect> {
    this.dispatchBatch(context, Array[event])
  }

  // Dispatches an ordered batch of input events outside of the reactive graph:
  //   1. Route and reduce every event in order against the latest committed
  //      geometry + pending in-batch states/facts.
  //   2. Commit all state/fact/prop writes in one transaction (`context.update()`
  //      called once).
  //   3. Run post-commit `Notify` callbacks and return remaining host effects
  //      (such as `ScheduleTimer`).
  fun dispatchBatch(
    context: mutable SKStore.Context,
    events: Array<Event>,
  ): Array<Effect> {
    assertOutsideComputation(context);
    if (events.isEmpty()) return Array[];

    curPointer = this.pointerHdl.unsafeGet(context, SKStore.UnitID::singleton);
    curFocus = this.focusHdl.unsafeGet(
      context,
      SKStore.UnitID::singleton,
    ).optFocused;
    pointerChanged = false;
    focusChanged = false;
    pendingStates = mutable Map<ElementId, ElementState>[];
    propWrites = mutable Vector<mutable SKStore.Context ~> void>[];
    postNotify = mutable Vector<mutable SKStore.Context ~> void>[];
    hostEffects = mutable Vector<Effect>[];

    readState = (id: ElementId, node: Node) -> {
      pendingStates.maybeGet(id) match {
      | Some(s) -> s
      | None() ->
        this.statesHdl.unsafeMaybeGet(context, id).default(
          defaultElementState(context, node),
        )
      }
    };

    applyReducerEffects = (effects: Array<Effect>) -> {
      for (eff in effects) {
        eff match {
        | SetFocus(target) ->
          if (curFocus != target) {
            !curFocus = target;
            !focusChanged = true
          }
        | WriteProp(fn) -> propWrites.push(fn)
        | Notify(fn) -> postNotify.push(fn)
        | ScheduleTimer _ -> hostEffects.push(eff)
        }
      }
    };

    for (event in events) {
      // Update pointer fact first when pointer moves/leaves/presses.
      event match {
      | PointerMove{position} ->
        !curPointer = PointerFact(Some(position), curPointer.optCaptured);
        !pointerChanged = true
      | PointerDown{position} ->
        !curPointer = PointerFact(Some(position), curPointer.optCaptured);
        !pointerChanged = true
      | PointerUp{position} ->
        !curPointer = PointerFact(Some(position), curPointer.optCaptured);
        !pointerChanged = true
      | PointerLeave{} ->
        !curPointer = PointerFact(None(), curPointer.optCaptured);
        !pointerChanged = true
      | _ -> void
      };

      // Handle Tab / Shift-Tab focus traversal at the dispatcher level.
      event match {
      | KeyDown{key => KeyTab(), modifiers} ->
        order = this.focusOrder(context);
        if (!order.isEmpty()) {
          nextFocus = curFocus match {
          | None() -> if (modifiers.shift) order[order.size() - 1] else order[0]
          | Some(fid) ->
            idxOpt: ?Int = None();
            for (i in Range(0, order.size())) {
              if (order[i] == fid) {
                !idxOpt = Some(i);
                break void
              }
            };
            idxOpt match {
            | Some(i) ->
              nextIdx = if (modifiers.shift) {
                (i + order.size() - 1) % order.size()
              } else {
                (i + 1) % order.size()
              };
              order[nextIdx]
            | None() ->
              if (modifiers.shift) order[order.size() - 1] else order[0]
            }
          };
          if (curFocus != Some(nextFocus)) {
            !curFocus = Some(nextFocus);
            !focusChanged = true
          }
        };
        continue
      | _ -> void
      };

      // Determine route (list of ElementIds from target to root).
      route: Array<ElementId> = event match {
      | PointerMove{position}
      | PointerDown{position}
      | PointerUp{position} ->
        curPointer.optCaptured match {
        | Some(cap) -> Array[cap]
        | None() ->
          this.hitTest(context, position) match {
          | Some(tid) -> this.routeToRoot(tid)
          | None() -> Array[]
          }
        }
      | PointerLeave{} ->
        curPointer.optCaptured match {
        | Some(cap) -> Array[cap]
        | None() -> Array[]
        }
      | KeyDown _
      | KeyUp _ ->
        curFocus match {
        | Some(fid) -> this.routeToRoot(fid)
        | None() -> Array[]
        }
      | SemanticsEvent{target} -> Array[target]
      | TimerEvent _ -> Array[]
      };

      // Run pure reducers along the route until handled.
      for (tid in route) {
        this.elementsHdl.unsafeMaybeGet(context, tid) match {
        | None() -> void
        | Some(el) ->
          rect = this.geometryHdl.unsafeMaybeGet(context, tid)
            .map(g -> g.rect())
            .default(Geometry.Rect::zero());
          st = readState(tid, el.node);
          red = reduceElement(context, el, rect, st, event);
          if (red.state != st) {
            pendingStates.set(tid, red.state)
          };
          if (red.capturePointer && curPointer.optCaptured != Some(tid)) {
            !curPointer = PointerFact(curPointer.optPosition, Some(tid));
            !pointerChanged = true
          };
          if (red.releasePointer && curPointer.optCaptured == Some(tid)) {
            !curPointer = PointerFact(curPointer.optPosition, None());
            !pointerChanged = true
          };
          applyReducerEffects(red.effects);
          if (red.handled) {
            break void
          }
        }
      }
    };

    // Single transaction commit: apply all writes, then one `context.update()`.
    if (pointerChanged) {
      writeValue(
        context,
        this.pointerHdl,
        SKStore.UnitID::singleton,
        curPointer,
      )
    };
    if (focusChanged) {
      writeValue(
        context,
        this.focusHdl,
        SKStore.UnitID::singleton,
        FocusFact(curFocus),
      )
    };
    for (kv in pendingStates.items()) {
      (id, st) = kv;
      writeValue(context, this.statesHdl, id, st)
    };
    for (fn in propWrites) {
      fn(context)
    };
    context.update();

    // Post-commit application notifications.
    for (fn in postNotify) {
      fn(context)
    };
    hostEffects.toArray()
  }

  // Builds the sorted draw list (back to front by ElementDepth.order),
  // translating local drawables to window coordinates. Called by the renderer
  // outside of the reactive graph.
  fun drawList(context: readonly SKStore.Context): Array<DrawEntry> {
    depthEntries = mutable Vector<(Int, ElementDepth)>[];
    // Collect every element that has geometry and depth.
    // We traverse via unsafe reads outside of the graph.
    this.collectDrawDepths(context, ElementId::root, depthEntries);
    sorted = depthEntries.toArray().sortedBy(pair ~> pair.i0);
    result = mutable Vector<DrawEntry>[];
    for (pair in sorted) {
      depth = pair.i1;
      geom = this.geometryHdl.unsafeMaybeGet(context, depth.id);
      paint = this.paintHdl.unsafeMaybeGet(context, depth.id);
      (geom, paint) match {
      | (Some(g), Some(p)) ->
        for (d in p.drawables) {
          result.push(
            DrawEntry(depth.id, g.offset, depth, d.translate(g.offset)),
          )
        }
      | _ -> void
      }
    };
    result.toArray()
  }

  private fun collectDrawDepths(
    context: readonly SKStore.Context,
    id: ElementId,
    out: mutable Vector<(Int, ElementDepth)>,
  ): void {
    this.depthHdl.unsafeMaybeGet(context, id).each(d -> out.push((d.order, d)));
    this.elementsHdl.unsafeMaybeGet(context, id).each(el -> {
      for (cid in el.childIds) {
        this.collectDrawDepths(context, cid, out)
      }
    })
  }
}

module end;
