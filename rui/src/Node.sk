module RUi;

// Per-child layout configuration owned by the child and read by its parent.
// A parent only interprets the subtype it recognizes and ignores any other.
base class ParentData

base class FlexFit uses Hashable, Equality {
  children =
  | FlexTight()
  | FlexLoose()
}

class FlexData{flex: Int = 0, fit: FlexFit = FlexTight()} extends ParentData

// Alignment within a rectangle: (-1.0, -1.0) is top-left, (0.0, 0.0) is center,
// (1.0, 1.0) is bottom-right.
value class Alignment(x: Float, y: Float) uses Hashable, Orderable, Show {
  const topLeft: Alignment = Alignment(-1.0, -1.0);
  const topCenter: Alignment = Alignment(0.0, -1.0);
  const topRight: Alignment = Alignment(1.0, -1.0);
  const centerLeft: Alignment = Alignment(-1.0, 0.0);
  const center: Alignment = Alignment(0.0, 0.0);
  const centerRight: Alignment = Alignment(1.0, 0.0);
  const bottomLeft: Alignment = Alignment(-1.0, 1.0);
  const bottomCenter: Alignment = Alignment(0.0, 1.0);
  const bottomRight: Alignment = Alignment(1.0, 1.0);

  fun alongOffset(diff: Geometry.Size): Geometry.Offset {
    Geometry.Offset(
      (this.x + 1.0) * 0.5 * diff.width,
      (this.y + 1.0) * 0.5 * diff.height,
    )
  }

  fun toString(): String {
    `Alignment(${this.x}, ${this.y})`
  }
}

class StackData{
  alignment: ?Alignment = None(),
  left: ?Float = None(),
  top: ?Float = None(),
  right: ?Float = None(),
  bottom: ?Float = None(),
  width: ?Float = None(),
  height: ?Float = None(),
} extends ParentData

base class MainAxisAlignment uses Hashable, Equality {
  children =
  | MainStart()
  | MainCenter()
  | MainEnd()
  | MainSpaceBetween()
  | MainSpaceAround()
  | MainSpaceEvenly()
}

base class CrossAxisAlignment uses Hashable, Equality {
  children =
  | CrossStart()
  | CrossCenter()
  | CrossEnd()
  | CrossStretch()
}

base class MainAxisSize uses Hashable, Equality {
  children =
  | MainMin()
  | MainMax()
}

base class StackFit uses Hashable, Equality {
  children =
  | StackLoose()
  | StackExpand()
  | StackPassthrough()
}

// Base description of every UI element.
// Nodes carry only data (constants or reactive properties) and no layout,
// painting or event code.
base class Node{key: ?String = None(), parentData: ?ParentData = None()}

// A reactive component: expands its render function inside the element-tree
// stage. When a Prop read inside render changes, only this component's subtree
// is expanded again.
class Component{render: mutable SKStore.Context ~> Node} extends Node

// Layout nodes.

class Flex{
  direction: Value<Ui.Axis> = Const(Ui.HorizontalAxis()),
  mainAxisAlignment: Value<MainAxisAlignment> = Const(MainStart()),
  crossAxisAlignment: Value<CrossAxisAlignment> = Const(CrossCenter()),
  mainAxisSize: Value<MainAxisSize> = Const(MainMax()),
  gap: Value<Float> = Const(0.0),
  items: Value<NodeList>,
} extends Node

class Stack{
  alignment: Value<Alignment> = Const(Alignment::topLeft),
  fit: Value<StackFit> = Const(StackLoose()),
  items: Value<NodeList>,
} extends Node

class Padding{insets: Value<Geometry.Insets>, child: Value<Node>} extends Node

class Align{
  alignment: Value<Alignment> = Const(Alignment::center),
  widthFactor: Value<?Float> = Const(None()),
  heightFactor: Value<?Float> = Const(None()),
  child: Value<Node>,
} extends Node

class Constrained{
  constraints: Value<BoxConstraints>,
  child: Value<Node>,
} extends Node

// Starts a stacking context on the given layer without affecting layout.
class Layer{layer: Value<StackingLayer>, child: Value<Node>} extends Node

// Overrides the active Theme for its subtree without affecting layout.
class ThemeScope{theme: Value<Theme>, child: Value<Node>} extends Node

// Adds or overrides accessibility semantics for its child without affecting layout.
class Semantics{
  role: Value<?SemanticRole> = Const(None()),
  label: Value<?String> = Const(None()),
  focusable: Value<?Bool> = Const(None()),
  child: Value<Node>,
} extends Node

// Control nodes: semantic descriptions only (look comes from Skins, behavior
// comes from pure reducers in Behavior.sk).

base class ButtonKind uses Hashable, Equality {
  children =
  | StandardButton()
  | PrimaryButton()
  | SubtleButton()
}

class Button{
  text: Value<String>,
  icon: Value<?IconData> = Const(None()),
  kind: Value<ButtonKind> = Const(StandardButton()),
  enabled: Value<Bool> = Const(true),
  onPress: ?(mutable SKStore.Context ~> void) = None(),
  variant: Value<?String> = Const(None()),
} extends Node

base class ToggleKind uses Hashable, Equality {
  children =
  | CheckboxToggle()
  | SwitchToggle()
}

// A checkbox or switch control.
// - Controlled: pass `checked => Bound(prop)` together with `checkedProp =>
//   Some(prop)` (so the reducer writes directly to `prop` in the same
//   transaction) and/or `onChange`.
// - Uncontrolled: pass `checked => Const(initial)`; ToggleState holds the value.
class Toggle{
  label: Value<String> = Const(""),
  kind: Value<ToggleKind> = Const(CheckboxToggle()),
  checked: Value<Bool> = Const(false),
  checkedProp: ?Prop<Bool> = None(),
  enabled: Value<Bool> = Const(true),
  onChange: ?((mutable SKStore.Context, Bool) ~> void) = None(),
  variant: Value<?String> = Const(None()),
} extends Node

// Vector or glyph icon specification.
base class IconData {
  children =
  | PathIcon(name: String, path: Shape.Path, pxRange: Int = defaultPxRange)
  | GlyphIcon(family: String, codePoint: Char)
}

// View nodes: semantic descriptions whose look and metrics come from Skins.

class Text{
  text: Value<String>,
  font: Value<?FontSpec> = Const(None()),
  color: Value<?.Color> = Const(None()),
  effects: Value<Ui.TextEffects> = Const(Ui.TextEffects::none),
  variant: Value<?String> = Const(None()),
} extends Node

class Icon{
  icon: Value<IconData>,
  size: Value<?Float> = Const(None()),
  color: Value<?.Color> = Const(None()),
  variant: Value<?String> = Const(None()),
} extends Node

class Label{
  text: Value<String>,
  icon: Value<?IconData> = Const(None()),
  font: Value<?FontSpec> = Const(None()),
  color: Value<?.Color> = Const(None()),
  variant: Value<?String> = Const(None()),
} extends Node

// Plain geometric shape node for low-level drawing.
base class ShapeKind uses Hashable, Equality {
  children =
  | RectShape()
  | RoundedRectShape(radius: Float, smooth: Float = 2.0)
  | EllipseShape()
}

class Shape{
  kind: Value<ShapeKind> = Const(RectShape()),
  color: Value<.Color>,
  border: Value<?Ui.Border> = Const(None()),
  preferredSize: Value<Geometry.Size> = Const(Geometry.Size::zero),
} extends Node

module end;
