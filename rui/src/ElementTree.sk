module RUi;

// An expanded element in the element tree, keyed by ElementId.
// Holds its concrete (non-Component) node, its parent id, and its ordered
// child ids.
//
// For dynamic/reorderable lists (`KeyedNodes`), each child's ElementId uses
// the list's stable `NamedKey(key)`. For virtualized `LazyList` inside a
// `Scroll`, only the items intersecting the page-aligned visible window are
// expanded (using `IndexKey(i)` or the built node's explicit `key`).
class Element(
  id: ElementId,
  parent: ?ElementId,
  node: Node,
  parentData: ?ParentData,
  childIds: Array<ElementId>,
) extends SKStore.File

// Wrapper to store a root Node in an input directory.
class NodeFile(node: Node) extends SKStore.File

// Assigns a ChildKey for a static child slot: explicit Node.key -> NamedKey,
// otherwise IndexKey(index).
fun childKeyFor(node: Node, index: Int): ChildKey {
  node.key match {
  | Some(name) -> NamedKey(name)
  | None() -> IndexKey(index)
  }
}

// Extracts the direct keyed child nodes of a concrete (non-Component) node.
// `optVisible` is provided when this element is the direct child of a `Scroll`,
// so `LazyList` expands only items in the page-aligned visible window.
fun nodeKeyedChildren(
  context: mutable SKStore.Context,
  node: Node,
  optVisible: ?VisibleWindow,
): Array<(ChildKey, Node)> {
  expandList = (nl: NodeList) ->
    nl match {
    | StaticNodes(entries) ->
      out = mutable Vector<(ChildKey, Node)>[];
      for (i in Range(0, entries.size())) {
        child = entries[i].get(context);
        out.push((childKeyFor(child, i), child))
      };
      out.toArray()
    | KeyedNodes(list) ->
      list.keys(context).map(k -> {
        child = list.get(context, k).get(context);
        (NamedKey(k), child)
      })
    };
  node match {
  | Flex{items} -> expandList(items.get(context))
  | Stack{items} -> expandList(items.get(context))
  | Padding{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Align{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Constrained{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Layer{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | ThemeScope{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Semantics{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Clip{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Scroll{child} ->
    c = child.get(context);
    Array[(childKeyFor(c, 0), c)]
  | Overlay{anchor, overlay, visible} ->
    a = anchor.get(context);
    if (visible.get(context)) {
      o = overlay.get(context);
      Array[(NamedKey("anchor"), a), (NamedKey("overlay"), o)]
    } else {
      Array[(NamedKey("anchor"), a)]
    }
  | LazyList{itemCount, itemExtent, gap, itemBuilder} ->
    count = Math.max(0, itemCount.get(context));
    (start, end) = optVisible match {
    | Some(vis) ->
      lazyItemRange(count, itemExtent.get(context), gap.get(context), vis)
    | None() -> (0, count)
    };
    out = mutable Vector<(ChildKey, Node)>[];
    for (i in Range(start, end)) {
      child = itemBuilder(context, i);
      out.push((childKeyFor(child, i), child))
    };
    out.toArray()
  | Shape _
  | Text _
  | Icon _
  | Label _
  | Button _
  | Toggle _ ->
    Array[]
  | Component _ ->
    invariant_violation(
      "RUi: Component must be expanded before nodeKeyedChildren",
    )
  }
}

// Expands a Node recursively into an SKStore writer keyed by ElementId.
// When expanding a `Scroll` node, computes its page-aligned visible window
// from its current scroll state and the window size so a direct `LazyList`
// child only materializes visible pages (scrolling within a page does not
// re-expand items).
fun expandElement(
  context: mutable SKStore.Context,
  writer: mutable SKStore.TWriter<ElementId, Element>,
  statesHdl: SKStore.EHandle<ElementId, ElementState>,
  windowSize: Geometry.Size,
  id: ElementId,
  parent: ?ElementId,
  rawNode: Node,
  inheritedParentData: ?ParentData = None(),
  optVisible: ?VisibleWindow = None(),
): void {
  // Unwrap nested Component nodes, preserving outermost parentData if any.
  node = rawNode;
  parentData = inheritedParentData match {
  | Some(_) -> inheritedParentData
  | None() -> rawNode.parentData
  };
  while (node is Component _) {
    comp = node as Component _;
    !node = comp.render(context);
    if (parentData is None()) {
      !parentData = node.parentData
    }
  };
  // Compute page-aligned visible window for a Scroll's direct child (used by
  // LazyList). Rounded to pages via VisibleWindow::forScroll so scrolling
  // within a page preserves the same window.
  childVisible: ?VisibleWindow = node match {
  | Scroll{axis, pageSize} ->
    ax = axis.get(context);
    st = statesHdl.maybeGet(context, id).default(ScrollState());
    scrollOff = st match {
    | ScrollState(ox, oy) -> if (ax is Ui.HorizontalAxis _) ox else oy
    | _ -> 0.0
    };
    vpExtent = ax.main(windowSize);
    Some(VisibleWindow::forScroll(scrollOff, vpExtent, pageSize.get(context)))
  | _ -> None()
  };

  keyedChildren = nodeKeyedChildren(context, node, optVisible);
  seenKeys = mutable Set<ChildKey>[];
  childIds = mutable Vector<ElementId>[];
  for (pair in keyedChildren) {
    (ck, childNode) = pair;
    invariant(
      !seenKeys.contains(ck),
      `RUi: duplicate child key '${ck}' under ${id}`,
    );
    seenKeys.add(ck);
    cid = id.child(ck);
    childIds.push(cid);
    expandElement(
      context,
      writer,
      statesHdl,
      windowSize,
      cid,
      Some(id),
      childNode,
      childNode.parentData,
      childVisible,
    )
  };
  writer.set(id, Element(id, parent, node, parentData, childIds.toArray()))
}

// Builds the eager element-tree directory from a root-node input directory.
fun buildElementTree(
  context: mutable SKStore.Context,
  rootNodeHdl: SKStore.EHandle<SKStore.UnitID, NodeFile>,
  windowSizeHdl: SKStore.EHandle<SKStore.UnitID, WindowSizeFile>,
  statesHdl: SKStore.EHandle<ElementId, ElementState>,
  dirName: SKStore.DirName,
): SKStore.EHandle<ElementId, Element> {
  rootNodeHdl.map(
    ElementId::keyType,
    Element::type,
    context,
    dirName,
    (context, writer, _key, values) ~> {
      winSize = windowSizeHdl.get(context, SKStore.UnitID::singleton).size;
      expandElement(
        context,
        writer,
        statesHdl,
        winSize,
        ElementId::root,
        None(),
        values.first.node,
      )
    },
  )
}

module end;
